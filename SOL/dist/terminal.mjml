                text-align:right;
                vertical-align:top;">
              <img
                src="https://example.com/savencia-assets/terminal-address-arrow.png"
                width="24"
                height="24"
                alt=""
                role="presentation"
                style="display:block;
                  width:24px;
                  height:24px;
                  border:0;"/>
            </td>
          </tr>
        </tbody>
      </table>

      <div
        class="address-main"
        style="margin:0;
          color:#ffffff;
          font-family:Arial,Helvetica,sans-serif;
          font-size:21px;
          line-height:1.4;
          font-weight:400;
          text-align:left;">
        улица Амирова, 10А, Центральный дворец культуры Белебеевского района.
      </div>
    </td>
  
            </tr>
          </tbody>
        </table>

      </td>
