<mjml lang="ru">
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД!</mj-title>
    <mj-breakpoint width="480px"/>

    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif"/>
      <mj-text
        align="center"
        font-size="17px"
        line-height="1.65"
        color="#173f4c"
        padding="0 0 17px"/>
      <mj-image padding="0"/>
      <mj-column padding="0"/>
    </mj-attributes>

    <mj-style>
      @media only screen and (max-width:479px) {
        .hero-date div {
          font-size:38px !important;
          line-height:1.05 !important;
          letter-spacing:-1px !important;
        }
        .hero-title div {
          font-size:22px !important;
          line-height:1.12 !important;
          letter-spacing:-.35px !important;
        }
        .hero-date {
          padding:0 16px 5px !important;
        }
        .hero-title {
          padding:0 16px 15px !important;
        }
        .slogan-line {
          font-size:28px !important;
          line-height:1.18 !important;
          letter-spacing:-.6px !important;
        }
        .schedule-title div {
          font-size:27px !important;
          line-height:1.2 !important;
        }

        .airport-cell {
          height:46px !important;
          font-size:22px !important;
          line-height:46px !important;
          padding:0 !important;
        }
        .board-extra {
          display:none !important;
          width:0 !important;
          min-width:0 !important;
          max-width:0 !important;
          padding:0 !important;
          border:0 !important;
          font-size:0 !important;
          line-height:0 !important;
        }

        .schedule-time {
          width:28% !important;
          padding:6px 11px 6px 0 !important;
          border:0 !important;
          border-right:2px solid #004b62 !important;
          background-color:transparent !important;
          text-align:center !important;
          vertical-align:middle !important;
        }
        .time-value {
          font-size:29px !important;
          line-height:1.18 !important;
          text-align:center !important;
        }
        .schedule-copy {
          width:72% !important;
          padding:6px 0 6px 16px !important;
          border:0 !important;
          background-color:transparent !important;
          text-align:left !important;
          vertical-align:middle !important;
        }
        .stage-title {
          font-size:17px !important;
          line-height:1.25 !important;
          letter-spacing:0 !important;
          margin-bottom:9px !important;
          text-align:left !important;
        }
        .stage-description {
          font-size:14px !important;
          line-height:1.5 !important;
          text-align:left !important;
        }

        .address-heading {
          font-size:21px !important;
          line-height:1.15 !important;
          letter-spacing:-.65px !important;
          white-space:nowrap !important;
        }
        .address-columns {
          display:block !important;
          width:100% !important;
          max-width:100% !important;
          table-layout:auto !important;
        }
        .address-columns-body,
        .address-columns-row {
          display:block !important;
          width:100% !important;
        }
        .address-panel {
          display:block !important;
          float:none !important;
          width:100% !important;
          max-width:100% !important;
          box-sizing:border-box !important;
          padding:22px 18px 25px !important;
          border-left:0 !important;
          background-color:#004b62 !important;
        }
        .address-second {
          border-top:2px solid #ffffff !important;
        }
        .address-main {
          font-size:20px !important;
          line-height:1.4 !important;
        }

        .ticket-shell {
          padding:6px !important;
        }
        .ticket-copy {
          padding:15px 12px 15px 8px !important;
          text-align:left !important;
        }
        .ticket-eyebrow {
          font-size:10px !important;
          line-height:1.5 !important;
          letter-spacing:.8px !important;
          margin-bottom:9px !important;
        }
        .ticket-title {
          font-size:17px !important;
          line-height:1.35 !important;
          margin-bottom:8px !important;
        }
        .ticket-description {
          font-size:15px !important;
          line-height:1.5 !important;
        }
        .ticket-stub {
          padding:18px 8px !important;
        }
        .ticket-art {
          width:64px !important;
          max-width:100% !important;
          height:auto !important;
        }
      }

      @media only screen and (max-width:359px) {
        .hero-date div {
          font-size:33px !important;
          letter-spacing:-.8px !important;
        }
        .hero-title div {
          font-size:19px !important;
          letter-spacing:-.3px !important;
        }
        .hero-date {
          padding:0 13px 4px !important;
        }
        .hero-title {
          padding:0 13px 12px !important;
        }
        .slogan-line {
          font-size:24px !important;
        }
        .time-value {
          font-size:25px !important;
        }
        .schedule-time {
          padding-right:8px !important;
        }
        .schedule-copy {
          padding-left:12px !important;
        }
        .stage-title {
          font-size:16px !important;
        }
        .stage-description {
          font-size:13px !important;
        }
        .address-heading {
          font-size:18px !important;
          letter-spacing:-.55px !important;
        }

        .ticket-copy {
          padding:14px 9px 14px 6px !important;
        }
        .ticket-eyebrow {
          letter-spacing:.5px !important;
        }
        .ticket-title {
          font-size:16px !important;
        }
        .ticket-description {
          font-size:14px !important;
        }
        .ticket-stub {
          padding:16px 6px !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body width="640px" background-color="#e1e8e8">
<mj-section
      padding="0"
     
     
     
     
      css-class="savencia-pearl-header" background-color="#f7f5ef" background-url="https://example.com/savencia-assets/terminal-winter-header.png" background-repeat="no-repeat" background-size="640px 112px" background-position="right center">
      <mj-column>
        
    <mj-table
      
      padding="0"
      border="none"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      table-layout="fixed">
      
          <tr>
            <td
              height="112"
              align="left"
              valign="middle"
              style="height:112px;
                padding:0 0 0 30px;
                text-align:left;
                vertical-align:middle;
                font-size:0;
                line-height:0;">
              <img
                src="https://example.com/savencia-assets/terminal-logo.png"
                width="216"
                alt="Groupe Savencia"
                style="display:block;
                  width:216px;
                  max-width:75%;
                  height:auto;
                  border:0;"/>
            </td>
          </tr>
        
    </mj-table>
  
      </mj-column>
    </mj-section>
<mj-section padding="0" background-color="#004b62">
      <mj-column>
        
    <mj-table
      
      padding="0"
      border="none"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      table-layout="fixed">
      
          <tr>
            
              <td
                width="30%"
                height="5"
                bgcolor="#b1ca40"
                style="height:5px;padding:0;
                  font-size:0;line-height:0;">
                &#160;
              </td>
            
              <td
                width="40%"
                height="5"
                bgcolor="#de6a09"
                style="height:5px;padding:0;
                  font-size:0;line-height:0;">
                &#160;
              </td>
            
              <td
                width="30%"
                height="5"
                bgcolor="#1bbbe9"
                style="height:5px;padding:0;
                  font-size:0;line-height:0;">
                &#160;
              </td>
            
          </tr>
        
    </mj-table>
  
      </mj-column>
    </mj-section>
<mj-hero
      mode="fluid-height"
      background-width="640px"
      background-height="425px"
      background-url="https://example.com/savencia-assets/terminal-hero.jpg"
      background-color="#004b62"
      background-position="center center"
      vertical-align="bottom"
      padding="0"
      inner-padding="0">

      <mj-text
        css-class="hero-date"
        align="right"
        color="#ffffff"
        font-size="62px"
        line-height="1.04"
        font-weight="700"
        letter-spacing="-1.8px"
        padding="0 26px 7px">
        10 декабря
      </mj-text>

      <mj-text
        css-class="hero-title"
        align="right"
        color="#ffffff"
        font-size="32px"
        line-height="1.12"
        font-weight="700"
        letter-spacing="-.5px"
        padding="0 26px 23px">
        — Вылет в Новый ГОД!
      </mj-text>
    </mj-hero>
<mj-section padding="0" background-color="#004b62">
      <mj-column>
        
    <mj-table
      
      padding="0"
      border="none"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      table-layout="fixed">
      
          <tr>
            
              <td
                width="30%"
                height="5"
                bgcolor="#1bbbe9"
                style="height:5px;padding:0;
                  font-size:0;line-height:0;">
                &#160;
              </td>
            
              <td
                width="40%"
                height="5"
                bgcolor="#de6a09"
                style="height:5px;padding:0;
                  font-size:0;line-height:0;">
                &#160;
              </td>
            
              <td
                width="30%"
                height="5"
                bgcolor="#b1ca40"
                style="height:5px;padding:0;
                  font-size:0;line-height:0;">
                &#160;
              </td>
            
          </tr>
        
    </mj-table>
  
      </mj-column>
    </mj-section>

    <mj-wrapper
      css-class="savencia-winter-pearl"
      padding="0"
      background-color="#f7f5ef"
      background-url="https://example.com/savencia-assets/terminal-winter-pearl.jpg"
      background-repeat="no-repeat"
      background-size="cover"
      background-position="center top">
      <mj-section padding="0 30px">
      <mj-column>
        <mj-text
          font-size="23px"
          font-weight="700"
          padding="29px 0 17px">
          Дорогие коллеги!
        </mj-text>
        <mj-text>Внимание, объявляется посадка на особый новогодний рейс!</mj-text>
        <mj-text padding="0 0 27px">
          10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.
        </mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>
  
<mj-section
      padding="25px 24px 27px"
      background-color="#b1ca40"
      background-url="https://example.com/savencia-assets/terminal-slogan-flight.png"
      background-repeat="no-repeat"
      background-size="cover"
      background-position="center center">
      <mj-column>
        <mj-text
          padding="0"
          font-size="37px"
          line-height="1.16"
          font-weight="700">

          <div
            class="slogan-line"
            style="color:#004b62;
              text-align:left;
              letter-spacing:-.8px;">
            ТРИ ГОРОДА.
          </div>

          <div
            class="slogan-line"
            style="margin-top:6px;
              color:#008fd0;
              text-align:center;
              letter-spacing:-.8px;">
            ОДИН РЕЙС.
          </div>

          <div
            class="slogan-line"
            style="margin-top:6px;
              color:#004b62;
              text-align:right;
              letter-spacing:-.8px;">
            ОДНА КОМАНДА.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper
      css-class="savencia-winter-pearl"
      padding="0"
      background-color="#f7f5ef"
      background-url="https://example.com/savencia-assets/terminal-winter-pearl.jpg"
      background-repeat="no-repeat"
      background-size="cover"
      background-position="center top">
      <mj-section padding="0 30px">
      <mj-column>
        <mj-text padding="28px 0 17px">
          В этот день наши праздничные площадки превратятся в аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — Новый год!
        </mj-text>
        <mj-text>В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.</mj-text>
      </mj-column>
    </mj-section>
<mj-section
       
        padding="0px 30px 29px 30px">
        <mj-column>

          
    <mj-table
      css-class="boarding-pass"
      padding="0"
      border="2px dashed #de6a09"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      table-layout="fixed">
      
            <tr>
              <td
                class="ticket-shell"
                bgcolor="#ffffff"
                style="padding:8px;
                  background-color:#ffffff;">

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="width:100%;
                    table-layout:fixed;
                    border-collapse:collapse;">
                  <tbody>
                    <tr>
                      <td
                        class="ticket-copy"
                        width="73%"
                        align="left"
                        valign="middle"
                        bgcolor="#ffffff"
                        style="width:73%;
                          padding:15px 22px 15px 16px;
                          background-color:#ffffff;
                          font-family:Arial,Helvetica,sans-serif;
                          text-align:left;
                          vertical-align:middle;">

                        <div
                          class="ticket-eyebrow"
                          style="margin:0 0 10px;
                            color:#de6a09;
                            font-family:Arial,Helvetica,sans-serif;
                            font-size:11px;
                            line-height:1.55;
                            font-weight:700;
                            letter-spacing:1.5px;
                            text-align:left;">
                          ★ НОВОГОДНИЙ РОЗЫГРЫШ ПРИЗОВ
                        </div>

                        <div
                          class="ticket-title"
                          style="margin:0 0 7px;
                            color:#172b35;
                            font-family:Arial,Helvetica,sans-serif;
                            font-size:19px;
                            line-height:1.4;
                            font-weight:700;
                            text-align:left;">
                          Ваш посадочный талон — ключ к подаркам!
                        </div>

                        <div
                          class="ticket-description"
                          style="margin:0;
                            color:#65727a;
                            font-family:Arial,Helvetica,sans-serif;
                            font-size:16px;
                            line-height:1.5;
                            font-weight:400;
                            text-align:left;">
                          На регистрации каждый сотрудник получит свой персональный билет. Обязательно сохраните его до конца полёта!
                        </div>
                      </td>

                      <td
                        class="ticket-stub"
                        width="27%"
                        align="center"
                        valign="middle"
                        bgcolor="#de6a09"
                        style="width:27%;
                          padding:20px 12px;
                          border-left:2px dashed #ffffff;
                          background-color:#de6a09;
                          text-align:center;
                          vertical-align:middle;">

                        <img
                          class="ticket-art"
                          src="https://example.com/savencia-assets/terminal-ticket-art.png"
                          width="84"
                          height="116"
                          alt=""
                          role="presentation"
                          style="display:block;
                            width:84px;
                            max-width:100%;
                            height:auto;
                            margin:0 auto;
                            border:0;"/>
                      </td>
                    </tr>
                  </tbody>
                </table>

              </td>
            </tr>
          
    </mj-table>
  

        </mj-column>
      </mj-section>
<mj-section padding="0 30px">
      <mj-column>
        <mj-text
          css-class="schedule-title"
          font-size="33px"
          line-height="1.2"
          font-weight="700"
          padding="0 0 8px">
          Расписание нашего рейса
        </mj-text>

        <mj-text
          css-class="schedule-note"
          font-size="13px"
          line-height="19px"
          color="#52666d"
          padding="0 0 25px">
          по местному времени
        </mj-text>
      </mj-column>
    </mj-section>
<mj-section
      css-class="flight-board-full"
      padding="0"
     
      border-top="4px solid #de6a09">
      <mj-column>
        
    <mj-table
      css-class="flight-board"
      padding="0"
      border="none"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      table-layout="fixed">
      
    <tr>
      
        <td
          class="airport-cell board-extra"
          height="46"
          align="center"
          valign="middle"
          bgcolor="#27292b"
          style="height:46px;
            padding:0;
            border:1px solid #101214;
            background-image:linear-gradient(to bottom,#27292b 0%,#27292b 49%,#080a0b 49%,#080a0b 51%,#303234 51%,#303234 100%);
            color:#ffffff;
            font-family:Arial,Helvetica,sans-serif;
            font-size:22px;
            line-height:46px;
            font-weight:700;
            white-space:nowrap;
            text-align:center;
            vertical-align:middle;
            mso-line-height-rule:exactly;">
          &#160;
        </td>
      
        <td
