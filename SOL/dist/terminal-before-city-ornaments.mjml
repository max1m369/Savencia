<mjml lang="ru">
    <mj-head>
      <mj-title>10 декабря — Вылет в Новый ГОД!</mj-title>
      <mj-breakpoint width="480px"/>

      <mj-attributes>
        <mj-all font-family="Arial, Helvetica, sans-serif"/>
        <mj-text align="center" font-size="17px"
          line-height="1.65" color="#173f4c" padding="0 0 17px"/>
        <mj-image padding="0"/>
        <mj-column padding="0"/>
      </mj-attributes>

      <mj-style>
        @media only screen and (max-width:479px) {
          .hero-date {
            font-size:47px !important;
            line-height:1.06 !important;
            letter-spacing:-1.4px !important;
          }
          .hero-stars {
            width:39px !important;
            height:auto !important;
          }
          .hero-title div {
            font-size:29px !important;
            line-height:1.15 !important;
          }
          .slogan-line {
            font-size:28px !important;
            line-height:1.18 !important;
            letter-spacing:-.6px !important;
          }
          .drops-right { width:48px !important; }
          .drops-left { width:43px !important; }
          .schedule-title div {
            font-size:27px !important;
            line-height:1.2 !important;
          }
          .airport-cell {
            height:39px !important;
            font-size:18px !important;
            line-height:39px !important;
          }
          .schedule-time, .schedule-copy {
            display:block !important;
            width:100% !important;
            box-sizing:border-box !important;
            text-align:center !important;
          }
          .schedule-time {
            padding:23px 10px 10px !important;
            border-right:0 !important;
            border-bottom:0 !important;
            font-size:25px !important;
          }
          .schedule-copy {
            padding:0 10px 23px !important;
          }
          .address-cell {
            display:block !important;
            width:100% !important;
            box-sizing:border-box !important;
            border-left:0 !important;
            padding:23px 12px 25px !important;
          }
          .address-second {
            border-top:1px solid #c4d8df !important;
          }
          .address-heading {
            font-size:27px !important;
            line-height:1.06 !important;
          }
          .address-city { font-size:29px !important; }
        }
        @media only screen and (max-width:359px) {
          .hero-date {
            font-size:39px !important;
            letter-spacing:-1.3px !important;
          }
          .hero-stars { width:31px !important; }
          .hero-title div { font-size:25px !important; }
          .slogan-line {
            font-size:24px !important;
            letter-spacing:-.6px !important;
          }
          .drops-right { width:39px !important; }
          .drops-left { width:35px !important; }
          .airport-cell {
            height:35px !important;
            font-size:15px !important;
            line-height:35px !important;
          }
          .address-heading { font-size:25px !important; }
        }
      </mj-style>
    
    <!-- SAVENCIA_REFINEMENT_START -->
    <mj-style>
      @media only screen and (max-width:479px) {
        .address-heading {
          font-size:21px !important;
          line-height:1.15 !important;
          letter-spacing:-0.65px !important;
          white-space:nowrap !important;
        }

        .drops-right,
        .slogan-drops-right {
          width:56px !important;
          height:auto !important;
        }

        .drops-left,
        .slogan-drops-left {
          width:50px !important;
          height:auto !important;
        }
      }

      @media only screen and (max-width:359px) {
        .address-heading {
          font-size:18px !important;
          letter-spacing:-0.55px !important;
        }

        .drops-right,
        .slogan-drops-right {
          width:44px !important;
        }

        .drops-left,
        .slogan-drops-left {
          width:40px !important;
        }
      }
    </mj-style>
    <!-- SAVENCIA_REFINEMENT_END -->
  
    <!-- SAVENCIA_ADDRESS_FLIGHT_START -->
    <mj-style>
      .address-cell,
      .address-single,
      .address-main,
      .address-city {
        text-align:left !important;
        vertical-align:top !important;
      }

      .address-city {
        font-size:13px !important;
        line-height:1.35 !important;
        font-weight:700 !important;
      }

      @media only screen and (max-width:479px) {
        .address-cell,
        .address-single {
          padding:22px 16px 25px !important;
          text-align:left !important;
        }

        .address-main {
          font-size:20px !important;
          line-height:1.4 !important;
        }

        .address-city {
          font-size:13px !important;
          line-height:1.35 !important;
        }

        .address-heading {
          font-size:21px !important;
          line-height:1.15 !important;
          letter-spacing:-.65px !important;
          white-space:nowrap !important;
        }

        .slogan-line {
          font-size:28px !important;
          line-height:1.18 !important;
          letter-spacing:-.6px !important;
        }
      }

      @media only screen and (max-width:359px) {
        .address-heading {
          font-size:18px !important;
          letter-spacing:-.55px !important;
        }

        .slogan-line {
          font-size:24px !important;
          letter-spacing:-.6px !important;
        }
      }
    </mj-style>
    <!-- SAVENCIA_ADDRESS_FLIGHT_END -->
  
    <!-- SAVENCIA_TICKET_CITY_START -->
    <mj-style>
      .address-city {
        color:#008fd0 !important;
        font-size:14px !important;
        line-height:1.35 !important;
        font-weight:700 !important;
        text-align:left !important;
        margin:0 0 11px !important;
      }

      .address-main {
        margin:0 !important;
        text-align:left !important;
      }

      @media only screen and (max-width:479px) {
        .address-city {
          color:#008fd0 !important;
          font-size:14px !important;
          margin:0 0 11px !important;
        }

        .ticket-copy {
          padding:19px 14px !important;
          font-size:16px !important;
          line-height:1.6 !important;
        }

        .ticket-stub {
          padding:16px 7px !important;
        }

        .ticket-art {
          width:64px !important;
          max-width:100% !important;
        }
      }

      @media only screen and (max-width:359px) {
        .ticket-copy {
          padding:17px 11px !important;
        }

        .ticket-stub {
          padding:14px 5px !important;
        }
      }
    </mj-style>
    <!-- SAVENCIA_TICKET_CITY_END -->
  
    <!-- SAVENCIA_GRID_START -->
    <mj-style>
      @media only screen and (max-width:479px) {
        .schedule-time {
          border-left:1px solid #c4d8df !important;
          border-right:1px solid #c4d8df !important;
          border-bottom:0 !important;
        }

        .schedule-copy {
          border-left:1px solid #c4d8df !important;
          border-right:1px solid #c4d8df !important;
          border-top:0 !important;
          border-bottom:1px solid #c4d8df !important;
        }
      }
    </mj-style>
    <!-- SAVENCIA_GRID_END -->
  </mj-head>

    <mj-body width="640px" background-color="#e1e8e8">

      
    
        <mj-section
          padding="0"
          background-color="#ffffff"
          background-url="https://example.com/savencia-assets/terminal-year.png"
          background-repeat="no-repeat"
          background-size="360px 112px"
          background-position="right center">
          <mj-column padding="0">
            <mj-table padding="0" cellpadding="0" cellspacing="0"
              width="100%" table-layout="fixed">
              <tr>
                <td height="112" align="left" valign="middle"
                  style="height:112px;padding:0 0 0 30px;
                    text-align:left;vertical-align:middle;
                    font-size:0;line-height:0;">
                  <img
                    src="https://example.com/savencia-assets/terminal-logo.png"
                    width="216"
                    alt="Groupe Savencia"
                    style="display:block;width:216px;max-width:75%;
                      height:auto;border:0;"/>
                </td>
              </tr>
            </mj-table>
          </mj-column>
        </mj-section>
      
  

      <mj-section padding="0" background-color="#004b62">
    <mj-column>
      <mj-table
    padding="0"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed"><tr><td width="50%" bgcolor="#de6a09"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td><td width="30%" bgcolor="#1bbbe9"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td><td width="20%" bgcolor="#b1ca40"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td></tr></mj-table>
    </mj-column>
  </mj-section>

      <mj-section padding="28px 30px 0" background-color="#004b62">
        <mj-column>
          <mj-table
    padding="0 0 14px"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed">
            <tr>
              <td width="13%" align="left" valign="middle"
                style="width:13%;padding:0;">
                <img
    class="hero-stars"
    src="https://example.com/savencia-assets/terminal-hero-stars.png"
    width="63"
    alt=""
    role="presentation"
    style="display:block;width:63px;max-width:100%;height:auto;border:0;"
  />
              </td>
              <td width="87%" align="right" valign="middle"
                style="width:87%;padding:0;text-align:right;">
                <div class="hero-date"
                  style="color:#fff;
                    font-family:Arial,Helvetica,sans-serif;
                    font-size:70px;font-weight:700;
                    line-height:1;letter-spacing:-2px;
                    text-align:right;white-space:nowrap;">
                  10 декабря
                </div>
              </td>
            </tr>
          </mj-table>
          <mj-text font-size="40px" line-height="1.1"
             font-weight="700" color="#ffffff"
             padding="0" css-class="hero-title">— Вылет в Новый ГОД!</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0" background-color="#004b62">
        <mj-column>
          <mj-image
            src="https://example.com/savencia-assets/terminal-poster.png"
            alt="" width="640px"/>
        </mj-column>
      </mj-section>

      <mj-section padding="0" background-color="#004b62">
    <mj-column>
      <mj-table
    padding="0"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed"><tr><td width="20%" bgcolor="#b1ca40"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td><td width="30%" bgcolor="#1bbbe9"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td><td width="50%" bgcolor="#de6a09"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td></tr></mj-table>
    </mj-column>
  </mj-section>

      <mj-section padding="0 30px" background-color="#f7f5ef">
        <mj-column>
          <mj-text font-size="23px" font-weight="700" padding="29px 0 17px">Дорогие коллеги!</mj-text>
          <mj-text >Внимание, объявляется посадка на особый новогодний рейс!</mj-text>
          <mj-text padding="0 0 27px">10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-text>
        </mj-column>
      </mj-section>

      
        <mj-section
          padding="25px 24px 27px"
          background-color="#b1ca40"
          background-url="https://example.com/savencia-assets/terminal-slogan-flight.png"
          background-repeat="no-repeat"
          background-size="cover"
          background-position="center center">
          <mj-column>
            <mj-text padding="0" font-size="37px"
              line-height="1.16" font-weight="700">
              <div class="slogan-line"
                style="color:#004b62;text-align:left;
                  letter-spacing:-.8px;">
                ТРИ ГОРОДА.
              </div>
              <div class="slogan-line"
                style="margin-top:6px;color:#008fd0;
                  text-align:center;letter-spacing:-.8px;">
                ОДИН РЕЙС.
              </div>
              <div class="slogan-line"
                style="margin-top:6px;color:#004b62;
                  text-align:right;letter-spacing:-.8px;">
                ОДНА КОМАНДА.
              </div>
            </mj-text>
          </mj-column>
        </mj-section>
      

      <mj-section padding="0 30px" background-color="#f7f5ef">
        <mj-column>
          <mj-text padding="28px 0 17px">В этот день наши праздничные площадки превратятся в аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — Новый год!</mj-text>
          <mj-text >В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.</mj-text>
        </mj-column>
      </mj-section>

      <mj-wrapper padding="0 30px 29px" background-color="#f7f5ef">
        
        <mj-section padding="0" background-color="#eaf6fa">
          <mj-column padding="0">
            <mj-table
              padding="0"
              cellpadding="0"
              cellspacing="0"
              width="100%"
              table-layout="fixed">
              <tr>
                <td
                  class="ticket-copy"
                  width="78%"
                  align="center"
                  valign="middle"
                  bgcolor="#eaf6fa"
                  style="
                    width:78%;
                    padding:22px 23px;
                    border-left:4px solid #008fd0;
                    text-align:center;
                    vertical-align:middle;
                    color:#173f4c;
                    font-family:Arial,Helvetica,sans-serif;
                    font-size:17px;
                    line-height:1.65;
                  ">На регистрации каждый получит свой посадочный билет, который пригодится во время новогоднего розыгрыша подарков.</td>

                <td
                  class="ticket-stub"
                  width="22%"
                  align="center"
                  valign="middle"
                  bgcolor="#de6a09"
                  style="
                    width:22%;
                    padding:18px 10px;
                    border-left:2px dashed #f7f5ef;
                    text-align:center;
                    vertical-align:middle;
                  ">
                  <img
                    class="ticket-art"
                    src="https://example.com/savencia-assets/terminal-ticket-art.png"
                    width="84"
                    alt=""
                    role="presentation"
                    style="
                      display:block;
                      width:84px;
                      max-width:100%;
                      height:auto;
                      margin:0 auto;
                      border:0;
                    "/>
                </td>
              </tr>
            </mj-table>
          </mj-column>
        </mj-section>
      
      </mj-wrapper>

      <mj-section padding="0 30px" background-color="#f7f5ef">
        <mj-column>
          <mj-divider border-color="#de6a09"
            border-width="4px" padding="0 0 24px"/>
          <mj-text font-size="33px" line-height="1.2"
             font-weight="700" padding="0 0 25px"
             css-class="schedule-title">Расписание нашего рейса</mj-text>
        </mj-column>
      </mj-section>

      <mj-wrapper
    padding="0 30px 27px"
    background-color="#f7f5ef">
    <mj-section
      padding="14px 0 0"
      background-color="#ffffff"
      border-top="4px solid #de6a09">
      <mj-column>
        
    <!-- SAVENCIA_NAV_START -->
    <mj-table
      padding="0 0 10px"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      table-layout="fixed">
      <tr>
        <td style="padding:0;font-size:0;line-height:0;">
          <img
            src="https://example.com/savencia-assets/terminal-airport-navigation.png"
            width="580"
            alt=""
            role="presentation"
            style="
              display:block;
              width:100%;
              max-width:580px;
              height:auto;
              border:0;
            "/>
        </td>
      </tr>
    </mj-table>
    <!-- SAVENCIA_NAV_END -->
