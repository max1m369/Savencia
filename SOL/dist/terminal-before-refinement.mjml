  </mj-wrapper><mj-wrapper
    padding="0 30px 27px"
    background-color="#f7f5ef">
    <mj-section
      padding="14px 0 0"
      background-color="#ffffff"
      border-top="4px solid #008fd0">
      <mj-column>
        <mj-table
