      style="height:52px;padding:0;border:1px solid #101214;background-image:linear-gradient(#27292b 49%,#080a0b 49%,#080a0b 51%,#27292b 51%);color:#fff;font:700 24px/52px Arial,Helvetica,sans-serif;text-align:center;mso-line-height-rule:exactly">М</td><td class="airport-cell"
