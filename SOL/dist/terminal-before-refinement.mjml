      width="7.142857%"
      align="center"
      valign="middle"
      bgcolor="#27292b"
      style="height:52px;padding:0;border:1px solid #101214;background-image:linear-gradient(#27292b 49%,#080a0b 49%,#080a0b 51%,#27292b 51%);color:#fff;font:700 24px/52px Arial,Helvetica,sans-serif;text-align:center;mso-line-height-rule:exactly">А</td><td class="airport-cell"
      width="7.142857%"
      align="center"
      valign="middle"
      bgcolor="#27292b"
      style="height:52px;padding:0;border:1px solid #101214;background-image:linear-gradient(#27292b 49%,#080a0b 49%,#080a0b 51%,#27292b 51%);color:#fff;font:700 24px/52px Arial,Helvetica,sans-serif;text-align:center;mso-line-height-rule:exactly">&#160;</td></tr></mj-table>
        <mj-text font-size="13px"
              line-height="19px" color="#52666d"
              padding="10px 12px 12px">(по местному времени)</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 14px 0" background-color="#ffffff">
      <mj-column>
        <mj-table
    padding="0"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed"><tr>
      <td class="schedule-time" width="38%" valign="top"
        style="width:38%;padding:26px 10px;
          border-right:1px solid #c4d8df;border-bottom:1px solid #c4d8df;
          text-align:center;color:#004b62;
          font:700 25px/1.2 Arial,Helvetica,sans-serif;
          white-space:nowrap;">
        17:00–18:00
      </td>
      <td class="schedule-copy" width="62%" valign="top"
        style="width:62%;padding:25px 16px;border-bottom:1px solid #c4d8df;
          text-align:center;font-family:Arial,Helvetica,sans-serif;">
        <div class="stage-title"
          style="margin:0 0 11px;color:#004b62;
            font-size:21px;font-weight:700;line-height:1.2;
            letter-spacing:-.35px;">
          Регистрация на рейс (Welcome)
        </div>
        <div style="margin:0;color:#52666d;
          font-size:16px;line-height:1.6;">
          Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.
        </div>
      </td>
    </tr><tr>
      <td class="schedule-time" width="38%" valign="top"
        style="width:38%;padding:26px 10px;
          border-right:1px solid #c4d8df;border-bottom:1px solid #c4d8df;
          text-align:center;color:#004b62;
          font:700 25px/1.2 Arial,Helvetica,sans-serif;
          white-space:nowrap;">
        18:00–20:00
      </td>
      <td class="schedule-copy" width="62%" valign="top"
        style="width:62%;padding:25px 16px;border-bottom:1px solid #c4d8df;
          text-align:center;font-family:Arial,Helvetica,sans-serif;">
        <div class="stage-title"
          style="margin:0 0 11px;color:#de6a09;
            font-size:21px;font-weight:700;line-height:1.2;
            letter-spacing:-.35px;">
          Взлёт. Торжественная часть
        </div>
        <div style="margin:0;color:#52666d;
          font-size:16px;line-height:1.6;">
          Церемония награждения сотрудников и праздничная программа.
        </div>
      </td>
    </tr><tr>
      <td class="schedule-time" width="38%" valign="top"
        style="width:38%;padding:26px 10px;
          border-right:1px solid #c4d8df;
          text-align:center;color:#004b62;
          font:700 25px/1.2 Arial,Helvetica,sans-serif;
          white-space:nowrap;">
        20:00–23:00
      </td>
      <td class="schedule-copy" width="62%" valign="top"
        style="width:62%;padding:25px 16px;
          text-align:center;font-family:Arial,Helvetica,sans-serif;">
        <div class="stage-title"
          style="margin:0 0 11px;color:#004b62;
            font-size:21px;font-weight:700;line-height:1.2;
            letter-spacing:-.35px;">
          Полёт в Новый год
        </div>
        <div style="margin:0;color:#52666d;
          font-size:16px;line-height:1.6;">
          Музыка, фуршет, развлечения, общение и новогодние сюрпризы.
        </div>
      </td>
    </tr></mj-table>
        <mj-table
    padding="0"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed">
    <tr>
      <td colspan="2"
        style="padding:25px 10px 23px;
          border-top:2px solid #004b62;
          border-bottom:1px solid #c4d8df;
          text-align:center;color:#004b62;
          font-family:Arial,Helvetica,sans-serif;">
        <div class="address-heading"
          style="margin:0;font-size:31px;font-weight:700;
            line-height:1.04;letter-spacing:-.8px;">
          Аэропорты<br/>отправления:
        </div>
      </td>
    </tr>
    <tr>
      
        <td
          class="address-cell address-first"
          width="50%"
          valign="top"
          style="width:50%;
            padding:25px 15px 28px;
            
            text-align:center;font-family:Arial,Helvetica,sans-serif;">
          <div class="address-city"
            style="margin:0 0 13px;color:#004b62;
              font-size:30px;font-weight:700;
              line-height:1.05;letter-spacing:-.65px;">
            МОСКВА:
          </div>
          <div style="margin:0;color:#173f4c;
            font-size:16px;line-height:1.6;">
            проспект Андропова, 11, корпус 2, Южный Event-Port.
          </div>
        </td>
      
        <td
          class="address-cell address-second"
