<mjml lang="ru">
    <mj-head>
      <mj-title>10 декабря — Вылет в Новый ГОД!</mj-title>
      <mj-breakpoint width="480px"/>

      <mj-attributes>
        <mj-all font-family="Arial, Helvetica, sans-serif"/>
        <mj-text align="center" font-size="17px"
          line-height="1.65" color="#173f4c" padding="0 0 17px"/>
        <mj-image padding="0"/>
        <mj-column padding="0"/>
      </mj-attributes>

      <mj-style>
        @media only screen and (max-width:479px) {
          .hero-date {
            font-size:47px !important;
            line-height:1.06 !important;
            letter-spacing:-1.4px !important;
          }
          .hero-stars {
            width:39px !important;
            height:auto !important;
          }
          .hero-title div {
            font-size:29px !important;
            line-height:1.15 !important;
          }
          .slogan-line {
            font-size:28px !important;
            line-height:1.18 !important;
            letter-spacing:-.6px !important;
          }
          .drops-right { width:48px !important; }
          .drops-left { width:43px !important; }
          .schedule-title div {
            font-size:27px !important;
            line-height:1.2 !important;
          }
          .airport-cell {
            height:39px !important;
            font-size:18px !important;
            line-height:39px !important;
          }
          .schedule-time, .schedule-copy {
            display:block !important;
            width:100% !important;
            box-sizing:border-box !important;
            text-align:center !important;
          }
          .schedule-time {
            padding:23px 10px 10px !important;
            border-right:0 !important;
            border-bottom:0 !important;
            font-size:25px !important;
          }
          .schedule-copy {
            padding:0 10px 23px !important;
          }
          .address-cell {
            display:block !important;
            width:100% !important;
            box-sizing:border-box !important;
            border-left:0 !important;
            padding:23px 12px 25px !important;
          }
          .address-second {
            border-top:1px solid #c4d8df !important;
          }
          .address-heading {
            font-size:27px !important;
            line-height:1.06 !important;
          }
          .address-city { font-size:29px !important; }
        }
        @media only screen and (max-width:359px) {
          .hero-date {
            font-size:39px !important;
            letter-spacing:-1.3px !important;
          }
          .hero-stars { width:31px !important; }
          .hero-title div { font-size:25px !important; }
          .slogan-line {
            font-size:24px !important;
            letter-spacing:-.6px !important;
          }
          .drops-right { width:39px !important; }
          .drops-left { width:35px !important; }
          .airport-cell {
            height:35px !important;
            font-size:15px !important;
            line-height:35px !important;
          }
          .address-heading { font-size:25px !important; }
        }
      </mj-style>
    </mj-head>

    <mj-body width="640px" background-color="#e1e8e8">

      <mj-section padding="14px 30px" background-color="#ffffff">
        <mj-group width="100%" vertical-align="middle">
          <mj-column width="45%" vertical-align="middle">
            <mj-image
              src="https://example.com/savencia-assets/terminal-logo.png"
              alt="Groupe Savencia"
              width="216px"
              align="left"
              padding="5px 12px 5px 0"/>
          </mj-column>
          <mj-column width="55%" vertical-align="middle">
            <mj-image
              src="https://example.com/savencia-assets/terminal-year.png"
              alt="2027"
              width="300px"
              align="right"/>
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section padding="0" background-color="#004b62">
    <mj-column>
      <mj-table
    padding="0"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed"><tr><td width="50%" bgcolor="#de6a09"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td><td width="30%" bgcolor="#1bbbe9"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td><td width="20%" bgcolor="#b1ca40"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td></tr></mj-table>
    </mj-column>
  </mj-section>

      <mj-section padding="28px 30px 0" background-color="#004b62">
        <mj-column>
          <mj-table
    padding="0 0 14px"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed">
            <tr>
              <td width="13%" align="left" valign="middle"
                style="width:13%;padding:0;">
                <img
    class="hero-stars"
    src="https://example.com/savencia-assets/terminal-hero-stars.png"
    width="63"
    alt=""
    role="presentation"
    style="display:block;width:63px;max-width:100%;height:auto;border:0;"
  />
              </td>
              <td width="87%" align="right" valign="middle"
                style="width:87%;padding:0;text-align:right;">
                <div class="hero-date"
                  style="color:#fff;
                    font-family:Arial,Helvetica,sans-serif;
                    font-size:70px;font-weight:700;
                    line-height:1;letter-spacing:-2px;
                    text-align:right;white-space:nowrap;">
                  10 декабря
                </div>
              </td>
            </tr>
          </mj-table>
          <mj-text font-size="40px" line-height="1.1"
             font-weight="700" color="#ffffff"
             padding="0" css-class="hero-title">— Вылет в Новый ГОД!</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0" background-color="#004b62">
        <mj-column>
          <mj-image
            src="https://example.com/savencia-assets/terminal-poster.png"
            alt="" width="640px"/>
        </mj-column>
      </mj-section>

      <mj-section padding="0" background-color="#004b62">
    <mj-column>
      <mj-table
    padding="0"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed"><tr><td width="20%" bgcolor="#b1ca40"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td><td width="30%" bgcolor="#1bbbe9"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td><td width="50%" bgcolor="#de6a09"
          style="height:5px;padding:0;font-size:0;line-height:0;">&#160;</td></tr></mj-table>
    </mj-column>
  </mj-section>

      <mj-section padding="0 30px" background-color="#f7f5ef">
        <mj-column>
          <mj-text font-size="23px" font-weight="700" padding="29px 0 17px">Дорогие коллеги!</mj-text>
          <mj-text >Внимание, объявляется посадка на особый новогодний рейс!</mj-text>
          <mj-text padding="0 0 27px">10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section
    padding="22px 24px 24px"
    background-color="#b1ca40">
    <mj-column>
      <mj-table
    padding="0"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed">
        <colgroup>
          <col width="18%"/>
          <col width="23%"/>
          <col width="18%"/>
          <col width="23%"/>
          <col width="18%"/>
        </colgroup>
        <tr>
          <td colspan="4" align="left" valign="middle"
            style="padding:0;text-align:left;">
            <div class="slogan-line"
              style="font-family:Arial,Helvetica,sans-serif;font-size:37px;font-weight:700;line-height:1.14;letter-spacing:-.8px;color:#004b62;text-align:left;">
              ТРИ ГОРОДА.
            </div>
          </td>
          <td align="right" valign="middle" style="padding:0;">
            <img
    class="drops-right"
    src="https://example.com/savencia-assets/terminal-drops-right.png"
    width="80"
    alt=""
    role="presentation"
    style="display:block;width:80px;max-width:100%;height:auto;border:0;"
  />
          </td>
        </tr>
        <tr>
          <td colspan="5" align="center"
            style="padding:2px 0;text-align:center;">
            <div class="slogan-line"
              style="font-family:Arial,Helvetica,sans-serif;font-size:37px;font-weight:700;line-height:1.14;letter-spacing:-.8px;color:#008fd0;text-align:center;">
              ОДИН РЕЙС.
            </div>
          </td>
        </tr>
        <tr>
          <td align="left" valign="middle" style="padding:0;">
            <img
    class="drops-left"
    src="https://example.com/savencia-assets/terminal-drops-left.png"
    width="66"
    alt=""
    role="presentation"
    style="display:block;width:66px;max-width:100%;height:auto;border:0;"
  />
          </td>
          <td colspan="4" align="right" valign="middle"
            style="padding:0;text-align:right;">
            <div class="slogan-line"
              style="font-family:Arial,Helvetica,sans-serif;font-size:37px;font-weight:700;line-height:1.14;letter-spacing:-.8px;color:#004b62;text-align:right;">
              ОДНА КОМАНДА.
            </div>
          </td>
        </tr>
      </mj-table>
    </mj-column>
  </mj-section>

      <mj-section padding="0 30px" background-color="#f7f5ef">
        <mj-column>
          <mj-text padding="28px 0 17px">В этот день наши праздничные площадки превратятся в аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — Новый год!</mj-text>
          <mj-text >В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.</mj-text>
        </mj-column>
      </mj-section>

      <mj-wrapper padding="0 30px 29px" background-color="#f7f5ef">
        <mj-section padding="18px 20px"
          background-color="#eaf6fa"
          border-left="4px solid #008fd0">
          <mj-column><mj-text padding="0">На регистрации каждый получит свой посадочный билет, который пригодится во время новогоднего розыгрыша подарков.</mj-text></mj-column>
        </mj-section>
      </mj-wrapper>

      <mj-section padding="0 30px" background-color="#f7f5ef">
        <mj-column>
          <mj-divider border-color="#de6a09"
            border-width="4px" padding="0 0 24px"/>
          <mj-text font-size="33px" line-height="1.2"
             font-weight="700" padding="0 0 25px"
             css-class="schedule-title">Расписание нашего рейса</mj-text>
        </mj-column>
      </mj-section>

      <mj-wrapper
    padding="0 30px 27px"
    background-color="#f7f5ef">
    <mj-section
      padding="14px 0 0"
      background-color="#ffffff"
      border-top="4px solid #de6a09">
      <mj-column>
        <mj-table
    padding="0"
    cellpadding="0"
    cellspacing="0"
    width="100%"
    table-layout="fixed"><tr><td class="airport-cell"
      width="7.142857%"
      align="center"
      valign="middle"
      bgcolor="#27292b"
      style="height:52px;padding:0;border:1px solid #101214;background-image:linear-gradient(#27292b 49%,#080a0b 49%,#080a0b 51%,#27292b 51%);color:#fff;font:700 24px/52px Arial,Helvetica,sans-serif;text-align:center;mso-line-height-rule:exactly">&#160;</td><td class="airport-cell"
      width="7.142857%"
      align="center"
