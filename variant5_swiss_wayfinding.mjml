<mjml lang="ru">
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Savencia Swiss Aeronavigation</mj-title>
    <mj-preview>10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" padding="0" />
      <mj-text font-size="15px" line-height="1.6" color="#334155" />
      <mj-section background-color="#e8eff2" />
    </mj-attributes>
    <mj-style>
      /* Hallmark · built: Savencia · redesign: Swiss Aeronavigation Precision · genre: modern-minimal */
      :root {
        --color-bg-base: #e8eff2;
        --color-navy: #00232f;
        --color-orange: #de6a09;
        --color-slate-text: #334155;
        --color-slate-muted: #64748b;
        --color-border: #cbd5e1;
      }
      .split-flap {
        display: inline-block;
        background-color: #0b131e;
        color: #38bdf8;
        border: 1px solid #1f2c3f;
        border-radius: 4px;
        padding: 4px 10px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.5px;
      }
      .gate-pill {
        display: inline-block;
        background-color: #0f2a36;
        color: #38bdf8;
        border: 1px solid #38bdf8;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.5px;
        padding: 4px 10px;
        border-radius: 4px;
      }
      .time-badge {
        display: inline-block;
        background-color: #de6a09;
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        font-weight: 900;
        padding: 5px 10px;
        border-radius: 4px;
        white-space: nowrap;
      }
      @media only screen and (max-width: 479px) {
        .px { padding-left: 14px !important; padding-right: 14px !important; }
        .iata-code { font-size: 20px !important; }
        .row-stack { display: block !important; width: 100% !important; }
        .time-col { width: 100% !important; padding-bottom: 6px !important; }
        .pass-col {
          display: inline-block !important;
          width: 48% !important;
          box-sizing: border-box !important;
          margin-bottom: 12px !important;
          vertical-align: top !important;
        }
        .stub-col {
          display: block !important;
          width: 100% !important;
          text-align: center !important;
          padding: 0 !important;
        }
        .stub-raffle-card {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
          margin-bottom: 14px !important;
          text-align: center !important;
        }
        .stub-barcode-img {
          margin: 0 auto !important;
          display: inline-block !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#e8eff2">

    <!-- 1. ВЕРХНИЙ СИГНАЛЬНЫЙ ШТРИХ БРЕНДА -->
    <mj-section background-color="#de6a09" padding="0">
      <mj-column>
        <mj-text padding="0" font-size="1px" line-height="4px">&nbsp;</mj-text>
      </mj-column>
    </mj-section>

    <!-- 2. СВЕТЛАЯ ШАПКА В ШВЕЙЦАРСКОЙ СЕТКЕ (ЧИСТЫЙ ГРОТЕСК) -->
    <mj-section background-color="#ffffff" padding="18px 24px 16px 24px" border-bottom="1px solid #cbd5e1" css-class="px">
      <mj-column width="55%" vertical-align="middle">
        <mj-image src="logo_color.png" width="160px" align="left" alt="GROUPE SAVENCIA" />
      </mj-column>
      <mj-column width="45%" vertical-align="middle">
        <mj-text align="right" font-size="12px" color="#64748b" line-height="1.4">
          <strong style="color:#00232f;">Рейс:</strong> <span style="color:#008fd0; font-weight:800;">SV-2027</span> &nbsp;|&nbsp; <strong style="color:#00232f;">Гейт:</strong> <span style="color:#de6a09; font-weight:800;">2027</span><br />
          <span style="font-size:11px; color:#94a3b8;">10 декабря 2026 · По расписанию</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 3. КАРТОЧКА БИЛЕТА: ПОСАДОЧНЫЙ ТАЛОН (SWISS PRECISION) -->
    <mj-section background-color="#e8eff2" padding="24px 20px 20px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <div style="background-color: #ffffff; border-radius: 16px; border: 1px solid #cbd5e1; box-shadow: 0 12px 32px rgba(0, 48, 63, 0.09); overflow: hidden;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              
              <!-- Информационная плашка Solari -->
              <tr>
                <td style="background-color: #00232f; padding: 12px 20px; border-bottom: 2px solid #de6a09;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td align="left" valign="middle">
                        <span style="font-size:11px; font-weight:700; color:#e2e8f0; letter-spacing:0.5px;">
                          SAVENCIA AIRLINES · РЕЙС SV-2027
                        </span>
                      </td>
                      <td align="right" valign="middle">
                        <span class="split-flap">
                          ПОСАДКА ОТКРЫТА
                        </span>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- Главный маршрутный узел билета (MOW·UFA·BEL ➔ NEW YEAR) -->
              <tr>
                <td style="background-color: #ffffff; padding: 24px 24px 18px 24px;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="42%" align="left" valign="middle">
                        <div style="font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.5px;">ОТПРАВЛЕНИЕ</div>
                        <div class="iata-code" style="font-family:Arial, Helvetica, sans-serif; font-size:24px; font-weight:900; color:#004b62; line-height:1.15; margin-top:4px;">
                          MOW · UFA · BEL
                        </div>
                        <div style="font-size:12px; color:#475569; margin-top:4px; font-weight:600;">
                          Москва · Уфа · Белебей
                        </div>
                      </td>
                      <td width="16%" align="center" valign="middle">
                        <div style="width:36px; height:36px; border:2px solid #de6a09; border-radius:50%; display:inline-block; line-height:34px; text-align:center; font-size:16px; color:#de6a09;">
                          ✈
                        </div>
                        <div style="font-size:10px; font-weight:800; color:#de6a09; margin-top:4px;">
                          ПРЯМОЙ
                        </div>
                      </td>
                      <td width="42%" align="right" valign="middle">
                        <div style="font-size:11px; font-weight:700; color:#de6a09; text-transform:uppercase; letter-spacing:0.5px;">НАЗНАЧЕНИЕ</div>
                        <div class="iata-code" style="font-family:Arial, Helvetica, sans-serif; font-size:24px; font-weight:900; color:#de6a09; line-height:1.15; margin-top:4px;">
                          NEW YEAR
                        </div>
                        <div style="font-size:12px; color:#b45309; margin-top:4px; font-weight:700;">
                          2027 ГОД
                        </div>
                      </td>
                    </tr>
                  </table>

                  <!-- Параметры пассажира: точная техническая сетка (адаптивная 2х2 на мобильном) -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px; padding-top:14px; border-top:1px solid #e2e8f0;">
                    <tr>
                      <td class="pass-col" width="25%" align="left" valign="top">
                        <div style="font-size:10px; font-weight:700; color:#64748b;">Пассажир</div>
                        <div style="font-size:12px; font-weight:800; color:#0f172a; margin-top:3px;">Savencia Team</div>
                      </td>
                      <td class="pass-col" width="25%" align="left" valign="top">
                        <div style="font-size:10px; font-weight:700; color:#64748b;">Дата вылета</div>
                        <div style="font-size:12px; font-weight:800; color:#0f172a; margin-top:3px;">10 дек 2026</div>
                      </td>
                      <td class="pass-col" width="25%" align="left" valign="top">
                        <div style="font-size:10px; font-weight:700; color:#64748b;">Класс</div>
                        <div style="font-size:12px; font-weight:800; color:#008fd0; margin-top:3px;">Одна Команда</div>
                      </td>
                      <td class="pass-col" width="25%" align="left" valign="top">
                        <div style="font-size:10px; font-weight:700; color:#64748b;">Посадка</div>
                        <div style="font-size:12px; font-weight:800; color:#10b981; margin-top:3px;">По расписанию</div>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- Пунктирная линия отрыва билета -->
              <tr>
                <td style="background-color: #ffffff; padding: 6px 20px;">
                  <div style="border-top: 2px dashed #cbd5e1; font-size: 0; line-height: 0; height: 1px;">&nbsp;</div>
                </td>
              </tr>

              <!-- Отрывной корешок: штрихкод и адаптивная плашка лотереи -->
              <tr>
                <td style="background-color: #f8fafc; padding: 16px 22px 20px 22px;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" dir="rtl">
                    <tr>
                      <!-- На мобильном отображается первым и на всю ширину (100%) -->
                      <td class="stub-col" width="46%" align="right" valign="middle" dir="ltr" style="padding-left: 12px;">
                        <div class="stub-raffle-card" style="background-color:#fff7ed; border:1.5px dashed #de6a09; padding:10px 14px; border-radius:8px; text-align:center;">
                          <div style="font-size:11px; font-weight:900; color:#de6a09; letter-spacing:0.5px;">
                            ★ РОЗЫГРЫШ ПРИЗОВ
                          </div>
                          <div style="font-size:10px; color:#64748b; margin-top:3px; line-height:1.3;">
                            Билет выдается на регистрации
                          </div>
                        </div>
                      </td>
                      <!-- На мобильном центрируется под плашкой -->
                      <td class="stub-col" width="54%" align="left" valign="middle" dir="ltr">
                        <img class="stub-barcode-img" src="barcode.png" alt="SV-2027 Barcode" style="max-width:210px; width:100%; height:auto; display:block;" />
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 4. ШВЕЙЦАРСКИЙ ТИПОГРАФИЧЕСКИЙ БЛОК: МАНИФЕСТ И ОБРАЩЕНИЕ -->
    <mj-section background-color="#e8eff2" padding="0 20px 24px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <div style="background-color:#ffffff; border-radius:16px; border:1px solid #cbd5e1; box-shadow:0 12px 32px rgba(0, 48, 63, 0.08); overflow:hidden; padding:28px 24px;">
            <!-- Оранжевый акцентный манифест-блок -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#de6a09; border-radius:8px; margin-bottom:20px;">
              <tr>
                <td style="padding:14px 18px;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td align="left" valign="middle">
                        <div style="font-size:18px; font-weight:900; color:#ffffff; line-height:1.2;">
                          ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
                        </div>
                      </td>
                      <td width="36" align="right" valign="middle" style="font-size:20px; color:#ffffff;">
                        ✈
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- Заголовок -->
            <div style="font-size:22px; font-weight:900; color:#00232f; line-height:1.25; margin-bottom:12px;">
              Внимание, объявляется посадка на особый новогодний рейс!
            </div>

            <!-- Текст обращения -->
            <div style="font-size:15px; line-height:1.6; color:#334155;">
              <p style="margin:0 0 12px 0;"><strong style="color:#de6a09; font-size:16px;">Дорогие коллеги!</strong></p>
              <p style="margin:0 0 12px 0;">
                10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников <strong>Savencia</strong> из трёх городов — Москвы, Уфы и Белебея.
              </p>
              <p style="margin:0 0 12px 0;">
                В этот день наши праздничные площадки превратятся в аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — <span style="color:#008fd0; font-weight:bold;">Новый год!</span>
              </p>
              <p style="margin:0 0 16px 0;">
                В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.
              </p>
              
              <!-- Посадочный билет напоминание (лаконичный блок без курсива) -->
              <div style="background-color:#f8fafc; border-left:4px solid #de6a09; padding:12px 16px; font-size:13px; color:#0f172a; border-radius:0 6px 6px 0; line-height:1.5;">
                🎫 <strong style="color:#00232f;">Посадочный билет:</strong> На регистрации каждый получит свой персональный билет, который пригодится во время новогоднего розыгрыша подарков.
              </div>
            </div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 5. ТАБЛО ВЫЛЕТОВ: ШВЕЙЦАРСКАЯ СИСТЕМА НАВИГАЦИИ -->
    <mj-section background-color="#e8eff2" padding="0 20px 24px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <div style="background-color:#00232f; border-radius:16px; overflow:hidden; box-shadow:0 15px 35px rgba(0, 35, 47, 0.35); padding:24px 20px;">
            <!-- Заголовок табло -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px; padding-bottom:14px; border-bottom:1px solid #143542;">
              <tr>
                <td align="left" valign="middle">
                  <div style="font-size:18px; font-weight:900; color:#ffffff;">
                    РАСПИСАНИЕ НАШЕГО РЕЙСА
                  </div>
                </td>
                <td width="36" align="right" valign="middle">
                  <div style="width:30px; height:30px; border:1px solid #de6a09; border-radius:6px; text-align:center; line-height:28px; color:#de6a09; font-size:14px;">
                    ✈
                  </div>
                </td>
              </tr>
            </table>

            <!-- ТЕРМИНАЛ: МОСКВА И УФА -->
            <div style="margin-bottom:24px;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
                <tr>
                  <td align="left" valign="middle">
                    <span style="font-size:14px; font-weight:900; color:#38bdf8; letter-spacing:0.5px;">
                      ✈ МОСКВА И УФА
                    </span>
                    <span style="font-size:11px; color:#94a3b8; margin-left:8px;">
                      (по местному времени)
                    </span>
                  </td>
                  <td align="right" valign="middle">
                    <span class="gate-pill">
                      ГЕЙТ А-1
                    </span>
                  </td>
                </tr>
              </table>

              <!-- Этап 1 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                <tr>
                  <td class="row-stack time-col" width="130" valign="top">
                    <span class="time-badge">17:00–18:00</span>
                  </td>
                  <td class="row-stack" valign="top">
                    <div style="font-size:14px; font-weight:bold; color:#ffffff;">Регистрация на рейс (Welcome)</div>
                    <div style="font-size:13px; color:#94a3b8; margin-top:2px; line-height:1.45;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                  </td>
                </tr>
              </table>

              <!-- Этап 2 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                <tr>
                  <td class="row-stack time-col" width="130" valign="top">
                    <span class="time-badge">18:00–20:00</span>
                  </td>
                  <td class="row-stack" valign="top">
                    <div style="font-size:14px; font-weight:bold; color:#ffffff;">Взлёт. Торжественная часть</div>
                    <div style="font-size:13px; color:#94a3b8; margin-top:2px; line-height:1.45;">Церемония награждения сотрудников и праздничная программа.</div>
                  </td>
                </tr>
              </table>

              <!-- Этап 3 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;">
                <tr>
                  <td class="row-stack time-col" width="130" valign="top">
                    <span class="time-badge">20:00–23:00</span>
                  </td>
                  <td class="row-stack" valign="top">
                    <div style="font-size:14px; font-weight:bold; color:#ffffff;">Полёт в Новый год</div>
                    <div style="font-size:13px; color:#94a3b8; margin-top:2px; line-height:1.45;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                  </td>
                </tr>
              </table>

              <!-- Адреса Москва и Уфа -->
              <div style="padding-top:12px; border-top:1px dashed #143542; font-size:12px; color:#cbd5e1; line-height:1.5;">
                <div>✈ <strong>Москва:</strong> проспект Андропова, 11, корпус 2, Южный Event-Port.</div>
                <div style="margin-top:4px;">✈ <strong>Уфа:</strong> улица Менделеева, 205А, ресторан «Пастернак».</div>
              </div>
            </div>

            <!-- ТЕРМИНАЛ: БЕЛЕБЕЙ -->
            <div>
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
                <tr>
                  <td align="left" valign="middle">
                    <span style="font-size:14px; font-weight:900; color:#de6a09; letter-spacing:0.5px;">
                      ✈ БЕЛЕБЕЙ
                    </span>
                    <span style="font-size:11px; color:#94a3b8; margin-left:8px;">
                      (по местному времени)
                    </span>
                  </td>
                  <td align="right" valign="middle">
                    <span class="gate-pill" style="border-color:#de6a09; color:#de6a09;">
                      ГЕЙТ B-1
                    </span>
                  </td>
                </tr>
              </table>

              <!-- Этап 1 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                <tr>
                  <td class="row-stack time-col" width="130" valign="top">
                    <span class="time-badge">15:00–15:30</span>
                  </td>
                  <td class="row-stack" valign="top">
                    <div style="font-size:14px; font-weight:bold; color:#ffffff;">Регистрация на рейс (Welcome)</div>
                    <div style="font-size:13px; color:#94a3b8; margin-top:2px; line-height:1.45;">Встреча пассажиров, посадочные билеты, фотозона, угощения.</div>
                  </td>
                </tr>
              </table>

              <!-- Этап 2 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                <tr>
                  <td class="row-stack time-col" width="130" valign="top">
                    <span class="time-badge">15:30–18:00</span>
                  </td>
                  <td class="row-stack" valign="top">
                    <div style="font-size:14px; font-weight:bold; color:#ffffff;">Взлёт. Торжественная часть</div>
                    <div style="font-size:13px; color:#94a3b8; margin-top:2px; line-height:1.45;">Церемония награждения сотрудников и праздничная программа.</div>
                  </td>
                </tr>
              </table>

              <!-- Этап 3 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;">
                <tr>
                  <td class="row-stack time-col" width="130" valign="top">
                    <span class="time-badge">18:00–20:00</span>
                  </td>
                  <td class="row-stack" valign="top">
                    <div style="font-size:14px; font-weight:bold; color:#ffffff;">Полёт в Новый год</div>
                    <div style="font-size:13px; color:#94a3b8; margin-top:2px; line-height:1.45;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                  </td>
                </tr>
              </table>

              <!-- Адрес Белебей -->
              <div style="padding-top:12px; border-top:1px dashed #143542; font-size:12px; color:#cbd5e1; line-height:1.5;">
                ✈ <strong>Белебей:</strong> улица Амирова, 10А, Центральный дворец культуры.
              </div>
            </div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 6. ПАМЯТКА ПАССАЖИРА ПЕРЕД ВЫЛЕТОМ (SWISS WAYFINDING BRIEFING) -->
    <mj-section background-color="#e8eff2" padding="0 20px 24px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <div style="background-color:#ffffff; border-radius:16px; border:1px solid #cbd5e1; box-shadow:0 12px 32px rgba(0, 48, 63, 0.08); overflow:hidden; padding:26px 22px;">
            
            <!-- Заголовок блока и официальный текст из документа -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:18px; padding-bottom:14px; border-bottom:1px solid #e2e8f0;">
              <tr>
                <td>
                  <div style="font-size:11px; font-weight:bold; color:#008fd0; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:4px;">
                    PRE-FLIGHT BRIEFING · ПАМЯТКА
                  </div>
                  <div style="font-size:22px; font-weight:900; color:#00232f; line-height:1.2; margin-bottom:8px;">
                    Уважаемые пассажиры!
                  </div>
                  <div style="font-size:14px; line-height:1.55; color:#475569;">
                    Просим заранее подготовить хорошее настроение и быть готовыми к незабываемому путешествию. Наш новогодний рейс уже готовится к вылету. На борту ждём каждого!
                  </div>
                </td>
              </tr>
            </table>

            <!-- 3 навигационных модуля -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <!-- Модуль 1: Настроение -->
              <tr>
                <td style="padding:12px 14px; background-color:#fff7ed; border-radius:8px; border-left:4px solid #de6a09;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td valign="top">
                        <div style="font-size:11px; font-weight:900; color:#de6a09; letter-spacing:0.5px; text-transform:uppercase;">
                          01 · НАСТРОЕНИЕ
                        </div>
                        <div style="font-size:15px; font-weight:800; color:#00232f; margin-top:2px;">
                          Подготовьте улыбки и яркие эмоции
                        </div>
                        <div style="font-size:13px; color:#475569; margin-top:3px; line-height:1.45;">
                          Будьте готовы к незабываемому праздничному путешествию и встречам с коллегами.
                        </div>
                      </td>
                      <td width="44" align="right" valign="middle" style="padding-left:10px;">
                        <img src="v1-icon-mood-orange.png" width="38" height="38" alt="Настроение" style="display:block; width:38px; height:38px;" />
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr><td height="10" style="font-size:0; line-height:0;">&nbsp;</td></tr>
              
              <!-- Модуль 2: Посадочный билет -->
              <tr>
                <td style="padding:12px 14px; background-color:#f0f9ff; border-radius:8px; border-left:4px solid #008fd0;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td valign="top">
                        <div style="font-size:11px; font-weight:900; color:#008fd0; letter-spacing:0.5px; text-transform:uppercase;">
                          02 · ПОСАДОЧНЫЙ БИЛЕТ
                        </div>
                        <div style="font-size:15px; font-weight:800; color:#00232f; margin-top:2px;">
                          Ключ к новогоднему розыгрышу призов
                        </div>
                        <div style="font-size:13px; color:#475569; margin-top:3px; line-height:1.45;">
                          Заберите свой персональный билет на стойке Welcome для участия в розыгрыше подарков.
                        </div>
                      </td>
                      <td width="44" align="right" valign="middle" style="padding-left:10px;">
                        <img src="v1-icon-pass-blue.png" width="42" height="25" alt="Посадочный" style="display:block; width:42px; height:auto;" />
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr><td height="10" style="font-size:0; line-height:0;">&nbsp;</td></tr>

              <!-- Модуль 3: Пунктуальность -->
              <tr>
                <td style="padding:12px 14px; background-color:#f0fdf4; border-radius:8px; border-left:4px solid #10b981;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td valign="top">
                        <div style="font-size:11px; font-weight:900; color:#15803d; letter-spacing:0.5px; text-transform:uppercase;">
                          03 · ПУНКТУАЛЬНОСТЬ
                        </div>
                        <div style="font-size:15px; font-weight:800; color:#00232f; margin-top:2px;">
                          Прибытие точно по расписанию
                        </div>
                        <div style="font-size:13px; color:#475569; margin-top:3px; line-height:1.45;">
                          Прибывайте к открытию регистрации без опозданий — посадка начинается вовремя!
                        </div>
                      </td>
                      <td width="44" align="right" valign="middle" style="padding-left:10px;">
                        <img src="v1-icon-time-green.png" width="38" height="38" alt="Пунктуальность" style="display:block; width:38px; height:38px;" />
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 7. ФИНАЛЬНЫЙ БЛОК: ДО ВСТРЕЧИ 10 ДЕКАБРЯ -->
    <mj-section background-color="#00232f" padding="28px 24px" border-radius="16px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="24px" font-weight="900" color="#ffffff" align="center" line-height="1.2">
          До встречи 10 декабря!
        </mj-text>
        <mj-text font-size="14px" color="#38bdf8" font-weight="bold" align="center" padding-top="8px">
          Ваш экипаж Savencia ✈
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ОТСТУП СНИЗУ -->
    <mj-section background-color="#e8eff2" padding="16px 0">
      <mj-column><mj-spacer height="8px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>