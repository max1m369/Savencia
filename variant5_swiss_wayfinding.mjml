<mjml>
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Savencia Swiss Aeronavigation</mj-title>
    <mj-preview>10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#334155" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      /* Hallmark · built: Savencia · redesign: polish · genre: editorial */
      :root {
        --color-bg-base: #e8eff2;
        --color-navy: #00303f;
        --color-orange: #de6a09;
        --color-slate-text: #334155;
        --color-slate-muted: #64748b;
        --color-border: #cbd5e1;
      }
      .mono {
        font-family: "Courier New", Courier, monospace, sans-serif !important;
      }
      .split-flap {
        display: inline-block;
        background-color: #0b131e;
        color: #ffffff;
        border: 1px solid #1f2c3f;
        border-radius: 3px;
        padding: 4px 8px;
        font-family: "Courier New", Courier, monospace, sans-serif;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 2px;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), 0 2px 4px rgba(0,0,0,0.4);
      }
      .gate-pill {
        display: inline-block;
        background-color: #de6a09;
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1.5px;
        padding: 3px 8px;
        border-radius: 3px;
        text-transform: uppercase;
      }
      .time-badge {
        display: inline-block;
        background-color: #de6a09;
        color: #ffffff;
        font-family: "Courier New", Courier, monospace, sans-serif;
        font-size: 13px;
        font-weight: bold;
        padding: 6px 10px;
        border-radius: 4px;
        white-space: nowrap;
        letter-spacing: 0.5px;
      }
      .gate-card {
        background-color: #081724;
        border-left: 4px solid #de6a09;
        border-radius: 0 6px 6px 0;
        padding: 14px 16px;
      }
      @media only screen and (max-width: 480px) {
        .px { padding-left: 16px !important; padding-right: 16px !important; }
        .iata-code { font-size: 19px !important; }
        .row-stack { display: block !important; width: 100% !important; }
        .time-col { width: 100% !important; padding-bottom: 6px !important; }
        .pass-col { display: inline-block !important; width: 48% !important; margin-bottom: 12px !important; vertical-align: top !important; }
        .stub-col { display: block !important; width: 100% !important; text-align: center !important; }
        .stub-coupon { text-align: center !important; margin-top: 12px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#e8eff2">

    <!-- 1. ВЕРХНИЙ СИГНАЛЬНЫЙ ШТРИХ БРЕНДА -->
    <mj-section background-color="#de6a09" padding="0">
      <mj-column>
        <mj-text padding="0" font-size="1px" line-height="4px">&nbsp;</mj-text>
      </mj-column>
    </mj-section>

    <!-- 2. СВЕТЛАЯ ШАПКА В ШВЕЙЦАРСКОЙ СЕТКЕ (Ref 2 & 5) -->
    <mj-section background-color="#ffffff" padding="18px 24px 16px 24px" border-bottom="1px solid #cbd5e1" css-class="px">
      <mj-column width="55%" vertical-align="middle">
        <mj-image src="logo_color.png" width="160px" align="left" alt="GROUPE SAVENCIA" />
      </mj-column>
      <mj-column width="45%" vertical-align="middle">
        <mj-text align="right" font-family="'Courier New', Courier, monospace" font-size="11px" font-weight="bold" color="#64748b" letter-spacing="1px">
          FLIGHT: <span style="color:#004b62; font-weight:900;">SV-2027</span> &nbsp;|&nbsp; GATE: <span style="color:#de6a09; font-weight:900;">2027</span><br />
          <span style="font-size:9px; color:#94a3b8;">DISPATCH: 10.12.2027 // ON SCHEDULE</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 3. КАРТОЧКА БИЛЕТА: ПОСАДОЧНЫЙ ТАЛОН (Ref 1 808 Airways & Ref 3 50 UI) -->
    <mj-section background-color="#e8eff2" padding="24px 20px 24px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; border-radius: 16px; border: 1px solid #cbd5e1; border-collapse: separate; box-shadow: 0 12px 32px rgba(0, 48, 63, 0.09); overflow: hidden;">
            
            <!-- Информационная плашка Solari: NOW BOARDING (Ref 4) -->
            <tr>
              <td style="background-color: #00232f; padding: 12px 20px; border-radius: 15px 15px 0 0; border-bottom: 2px solid #de6a09;">
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="left" valign="middle">
                      <span style="font-family:'Courier New', Courier, monospace; font-size:10px; font-weight:bold; letter-spacing:2px; color:#94a3b8;">
                        SAVENCIA SPECIAL FLIGHT // SV-2027
                      </span>
                    </td>
                    <td align="right" valign="middle">
                      <span class="split-flap" style="background:#091624; color:#38bdf8; border:1px solid #1a3c4a;">
                        ● NOW BOARDING
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Главный маршрутный узел билета (MOW·UFA·BEL ➔ NEW YEAR) (Ref 1 & 3) -->
            <tr>
              <td style="background-color: #ffffff; padding: 24px 24px 18px 24px;">
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="42%" align="left" valign="middle">
                      <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#64748b; letter-spacing:1.5px;">ОТПРАВЛЕНИЕ // FROM</div>
                      <div class="iata-code" style="font-family:Arial, Helvetica, sans-serif; font-size:24px; font-weight:900; color:#004b62; letter-spacing:1px; line-height:1.15; margin-top:4px;">
                        MOW · UFA · BEL
                      </div>
                      <div style="font-size:11px; color:#64748b; margin-top:4px; font-weight:600;">
                        Москва • Уфа • Белебей
                      </div>
                    </td>
                    <td width="16%" align="center" valign="middle">
                      <div style="width:36px; height:36px; border:2px solid #de6a09; border-radius:50%; display:inline-block; line-height:34px; text-align:center; font-size:16px; color:#de6a09;">
                        &#x2708;&#xFE0E;
                      </div>
                      <div style="font-family:'Courier New', monospace; font-size:9px; font-weight:bold; color:#de6a09; letter-spacing:1px; margin-top:4px;">
                        DIRECT
                      </div>
                    </td>
                    <td width="42%" align="right" valign="middle">
                      <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#64748b; letter-spacing:1.5px;">НАЗНАЧЕНИЕ // TO</div>
                      <div class="iata-code" style="font-family:Arial, Helvetica, sans-serif; font-size:24px; font-weight:900; color:#de6a09; letter-spacing:1px; line-height:1.15; margin-top:4px;">
                        NEW YEAR
                      </div>
                      <div style="font-size:11px; color:#64748b; margin-top:4px; font-weight:600;">
                        2027 ГОД
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Параметры пассажира: точная техническая сетка (Ref 1 & 3) -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px; padding-top:14px; border-top:1px solid #e2e8f0;">
                  <tr>
                    <td class="pass-col" width="25%" align="left" valign="top">
                      <div style="font-family:'Courier New', monospace; font-size:9px; font-weight:bold; color:#94a3b8; text-transform:uppercase;">Пассажир</div>
                      <div style="font-size:12px; font-weight:bold; color:#0f172a; margin-top:3px;">Savencia Team</div>
                    </td>
                    <td class="pass-col" width="25%" align="left" valign="top">
                      <div style="font-family:'Courier New', monospace; font-size:9px; font-weight:bold; color:#94a3b8; text-transform:uppercase;">Дата вылета</div>
                      <div style="font-size:12px; font-weight:bold; color:#0f172a; margin-top:3px;">10 ДЕК 2026</div>
                    </td>
                    <td class="pass-col" width="25%" align="left" valign="top">
                      <div style="font-family:'Courier New', monospace; font-size:9px; font-weight:bold; color:#94a3b8; text-transform:uppercase;">Класс</div>
                      <div style="font-size:12px; font-weight:bold; color:#008fd0; margin-top:3px;">Одна Команда</div>
                    </td>
                    <td class="pass-col" width="25%" align="left" valign="top">
                      <div style="font-family:'Courier New', monospace; font-size:9px; font-weight:bold; color:#94a3b8; text-transform:uppercase;">Посадка</div>
                      <div style="font-size:12px; font-weight:bold; color:#10b981; margin-top:3px;">ON SCHEDULE</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Натуральная пунктирная линия отрыва билета -->
            <tr>
              <td style="background-color: #ffffff; padding: 6px 20px;">
                <div style="border-top: 2px dashed #cbd5e1; font-size: 0; line-height: 0; height: 1px;">&nbsp;</div>
              </td>
            </tr>

            <!-- Отрывной корешок билета со штрихкодом и лотереей (Ref 1 & 5) -->
            <tr>
              <td style="background-color: #f8fafc; padding: 16px 24px 20px 24px; border-radius: 0 0 15px 15px;">
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="stub-col" width="55%" align="left" valign="middle" style="padding-right: 12px;">
                      <img src="barcode.png" alt="SV-2027 Barcode" style="max-width:210px; width:100%; height:auto; display:inline-block; border:0;" />
                    </td>
                    <td class="stub-col stub-coupon" width="45%" align="right" valign="middle">
                      <div style="background-color:#fff7ed; border:1px dashed #de6a09; padding:8px 12px; border-radius:6px; display:inline-block; text-align:left;">
                        <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#de6a09; letter-spacing:1px;">
                          ★ РОЗЫГРЫШ ПРИЗОВ
                        </div>
                        <div style="font-size:10px; color:#64748b; margin-top:2px; line-height:1.3;">
                          Билет выдается на регистрации
                        </div>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 4. ШВЕЙЦАРСКИЙ ТИПОГРАФИЧЕСКИЙ БЛОК: МАНИФЕСТ И ОБРАЩЕНИЕ (Ref 5 Crato Mono) -->
    <mj-section background-color="#e8eff2" padding="0 20px 24px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff; border-radius:16px; border:1px solid #cbd5e1; border-collapse:separate; box-shadow:0 12px 32px rgba(0, 48, 63, 0.08); overflow:hidden;">
            <tr>
              <td style="padding:28px 24px; border-radius:16px;">
                <!-- Оранжевый акцентный манифест-блок (Ref 5) -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#de6a09; border-radius:6px; margin-bottom:20px;">
                  <tr>
                    <td style="padding:14px 18px;">
                      <table width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td align="left" valign="middle">
                            <div style="font-family:'Courier New', monospace; font-size:11px; font-weight:bold; color:#ffe8d6; letter-spacing:2px; text-transform:uppercase;">
                              OFFICIAL FLIGHT DISPATCH
                            </div>
                            <div style="font-family:Arial, Helvetica, sans-serif; font-size:17px; font-weight:900; color:#ffffff; letter-spacing:0.8px; margin-top:2px;">
                              ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
                            </div>
                          </td>
                          <td width="36" align="right" valign="middle" style="font-size:24px; color:#ffffff;">
                            &#x2295;
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <!-- Заголовок -->
                <div style="font-family:Arial, Helvetica, sans-serif; font-size:22px; font-weight:900; color:#00303f; line-height:1.25; margin-bottom:14px;">
                  Внимание, объявляется посадка на особый новогодний рейс!
                </div>

                <!-- Текст обращения -->
                <div style="font-size:14px; line-height:1.65; color:#334155;">
                  <p style="margin:0 0 12px 0;"><strong>Дорогие коллеги!</strong></p>
                  <p style="margin:0 0 12px 0;">
                    10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников <strong>Savencia</strong> из трёх городов — Москвы, Уфы и Белебея.
                  </p>
                  <p style="margin:0 0 12px 0;">
                    В этот день наши праздничные площадки превратятся в аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — <span style="color:#008fd0; font-weight:bold;">Новый год!</span>
                  </p>
                  <p style="margin:0 0 14px 0;">
                    В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.
                  </p>
                  
                  <!-- Посадочный билет напоминание -->
                  <div style="background-color:#f1f7f9; border-left:3px solid #004b62; padding:12px 14px; font-size:13px; color:#0f172a; border-radius:0 4px 4px 0;">
                    🎫 <strong>Посадочный талон:</strong> <em>На регистрации каждый получит свой посадочный билет, который пригодится во время новогоднего розыгрыша подарков.</em>
                  </div>
                </div>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 5. ТАБЛО ВЫЛЕТОВ: ШВЕЙЦАРСКАЯ СИСТЕМА НАВИГАЦИИ (Ref 2 Aeonik & Ref 4 Solari) -->
    <mj-section background-color="#e8eff2" padding="0 20px 24px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#00232f; border-radius:16px; border-collapse:separate; overflow:hidden; box-shadow:0 15px 35px rgba(0, 35, 47, 0.35);">
            <tr>
              <td style="padding:24px 20px; border-radius:16px;">
                <!-- Заголовок табло в стиле навигационных указателей аэропорта (Ref 2 & 4) -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px; padding-bottom:14px; border-bottom:1px solid #143542;">
                  <tr>
                    <td align="left" valign="middle">
                      <div style="font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:900; letter-spacing:1px; color:#ffffff;">
                        РАСПИСАНИЕ НАШЕГО РЕЙСА
                      </div>
                    </td>
                    <td width="36" align="right" valign="middle">
                      <div style="width:30px; height:30px; border:1px solid #de6a09; border-radius:4px; text-align:center; line-height:28px; color:#de6a09; font-size:14px;">
                        &#x2708;&#xFE0E;
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- ТЕРМИНАЛ: МОСКВА И УФА -->
                <div style="margin-bottom:24px;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
                    <tr>
                      <td align="left" valign="middle">
                        <span style="font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:900; color:#38bdf8; letter-spacing:1px;">
                          &#x2708;&#xFE0E; МОСКВА И УФА
                        </span>
                        <span style="font-family:'Courier New', monospace; font-size:10px; color:#94a3b8; margin-left:8px;">
                          (ПО МЕСТНОМУ ВРЕМЕНИ)
                        </span>
                      </td>
                      <td align="right" valign="middle">
                        <span class="gate-pill" style="background-color:#0f2a36; color:#38bdf8; border:1px solid #38bdf8;">
                          GATES A·1–2
                        </span>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 1 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                    <tr>
                      <td class="row-stack time-col" width="130" valign="top">
                        <span class="time-badge">17:00–18:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Регистрация на рейс (Welcome)</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 2 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                    <tr>
                      <td class="row-stack time-col" width="130" valign="top">
                        <span class="time-badge">18:00–20:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Взлёт. Торжественная часть</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Церемония награждения сотрудников и праздничная программа.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 3 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;">
                    <tr>
                      <td class="row-stack time-col" width="130" valign="top">
                        <span class="time-badge">20:00–23:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Полёт в Новый год</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Указатели гейтов отправления: МОСКВА И УФА (Ref 2 Aeonik) -->
                  <div style="margin-top:14px;">
                    <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; letter-spacing:1.5px; color:#64748b; margin-bottom:8px;">
                      АЭРОПОРТЫ ОТПРАВЛЕНИЯ // DEPARTURE GATES
                    </div>
                    
                    <!-- Гейт Москва -->
                    <div class="gate-card" style="margin-bottom:8px;">
                      <div style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:bold; color:#f4b860; letter-spacing:1.5px;">
                        &#x2794; МОСКВА:
                      </div>
                      <div style="font-size:12px; color:#d5e9ef; margin-top:3px; line-height:1.4;">
                        проспект Андропова, 11, корпус 2, Южный Event-Port.
                      </div>
                    </div>

                    <!-- Гейт Уфа -->
                    <div class="gate-card">
                      <div style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:bold; color:#f4b860; letter-spacing:1.5px;">
                        &#x2794; УФА:
                      </div>
                      <div style="font-size:12px; color:#d5e9ef; margin-top:3px; line-height:1.4;">
                        улица Менделеева, 205А, ресторан «Пастернак».
                      </div>
                    </div>
                  </div>
                </div>

                <!-- ТЕРМИНАЛ: БЕЛЕБЕЙ -->
                <div style="padding-top:16px; border-top:1px dashed #143542;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
                    <tr>
                      <td align="left" valign="middle">
                        <span style="font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:900; color:#38bdf8; letter-spacing:1px;">
                          &#x2708;&#xFE0E; БЕЛЕБЕЙ
                        </span>
                        <span style="font-family:'Courier New', monospace; font-size:10px; color:#94a3b8; margin-left:8px;">
                          (ПО МЕСТНОМУ ВРЕМЕНИ)
                        </span>
                      </td>
                      <td align="right" valign="middle">
                        <span class="gate-pill" style="background-color:#0f2a36; color:#38bdf8; border:1px solid #38bdf8;">
                          GATE B·01
                        </span>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 1 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                    <tr>
                      <td class="row-stack time-col" width="130" valign="top">
                        <span class="time-badge">15:00–15:30</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Регистрация на рейс (Welcome)</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 2 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                    <tr>
                      <td class="row-stack time-col" width="130" valign="top">
                        <span class="time-badge">15:30–18:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Взлёт. Торжественная часть</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Церемония награждения сотрудников и праздничная программа.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 3 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;">
                    <tr>
                      <td class="row-stack time-col" width="130" valign="top">
                        <span class="time-badge">18:00–20:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Полёт в Новый год</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Указатель гейта отправления: БЕЛЕБЕЙ (Ref 2) -->
                  <div style="margin-top:14px;">
                    <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; letter-spacing:1.5px; color:#64748b; margin-bottom:8px;">
                      АЭРОПОРТ ОТПРАВЛЕНИЯ // DEPARTURE GATE
                    </div>
                    
                    <div class="gate-card">
                      <div style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:bold; color:#f4b860; letter-spacing:1.5px;">
                        &#x2794; БЕЛЕБЕЙ:
                      </div>
                      <div style="font-size:12px; color:#d5e9ef; margin-top:3px; line-height:1.4;">
                        улица Амирова, 10А, Центральный дворец культуры Белебеевского района.
                      </div>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 6. ФИНАЛЬНОЕ НАПУТСТВИЕ И ЗАКЛЮЧИТЕЛЬНЫЙ АККОРД -->
    <mj-section background-color="#e8eff2" padding="0 20px 28px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff; border-radius:16px; border:1px solid #cbd5e1; border-collapse:separate; box-shadow:0 12px 32px rgba(0, 48, 63, 0.08); overflow:hidden;">
            <tr>
              <td style="padding:28px 24px; text-align:center; border-radius:16px;">
                <div style="font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:bold; color:#00303f; margin-bottom:8px;">
                  Уважаемые пассажиры!
                </div>
                <div style="font-size:14px; line-height:1.55; color:#475569; margin-bottom:18px;">
                  Просим заранее подготовить хорошее настроение и быть готовыми к незабываемому путешествию.<br />
                  <strong>Наш новогодний рейс уже готовится к вылету. На борту ждём каждого!</strong>
                </div>

                <!-- Главный финальный лозунг с датой -->
                <div style="font-family:Arial, Helvetica, sans-serif; font-size:28px; font-weight:900; color:#de6a09; letter-spacing:-0.5px; line-height:1.1; margin-bottom:8px;">
                  ДО ВСТРЕЧИ 10 ДЕКАБРЯ!
                </div>
                <div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:bold; color:#008fd0; letter-spacing:1px;">
                  Ваш экипаж Savencia &#x2708;&#xFE0E;
                </div>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 7. ДЕЛИКАТНЫЙ ПОДВАЛ -->
    <mj-section background-color="#e8eff2" padding="12px 20px 32px 20px" css-class="px">
      <mj-column width="100%">
        <mj-spacer height="8px" />
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>