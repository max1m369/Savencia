<mjml lang="ru">
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Groupe Savencia</mj-title>
    <mj-preview>10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" padding="0" />
      <mj-text font-size="15px" line-height="1.6" color="#173f4c" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      /* Hallmark · built: Savencia · redesign: Colorful Terminal & Festive Hub · genre: playful */
      :root {
        --color-bg-paper: #e6eff2;
        --color-petrol: #00232f;
        --color-navy: #004b62;
        --color-blue: #008fd0;
        --color-lime: #b1ca40;
        --color-orange: #de6a09;
        --color-amber: #f4b860;
        --color-text-dark: #173f4c;
      }
      .time-card {
        background-color: #ffffff;
        border-radius: 12px;
        padding: 16px 20px;
        border-left: 5px solid #004b62;
        margin-bottom: 12px;
        box-shadow: 0 4px 12px rgba(0, 75, 98, 0.06);
      }
      @media only screen and (max-width:479px) {
        .px { padding-left: 16px !important; padding-right: 16px !important; }
        .hero-title div { font-size: 26px !important; line-height: 1.15 !important; }
        .hero-sign { display: none !important; }
        .hero-main-col { width: 100% !important; padding-left: 0 !important; }
        .status-col { width: 100% !important; text-align: center !important; margin-top: 10px !important; }
        .status-text div { text-align: center !important; }
        .time-badge-col { width: 100% !important; margin-bottom: 6px !important; }
        .route-step { display: block !important; width: 100% !important; margin-bottom: 8px !important; text-align: center !important; }
        .tkt-stub { display: block !important; width: 100% !important; border-left: none !important; border-top: 2px dashed #008fd0 !important; padding: 14px 10px !important; text-align: center !important; }
        .tkt-main { display: block !important; width: 100% !important; padding: 16px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body width="640px" background-color="#e6eff2">

    <!-- 1. ТЕЛЕТАЙП-ЛЕНТА СТАТУСА РЕЙСА -->
    <mj-section background-color="#00232f" padding="10px 24px">
      <mj-column width="100%">
        <mj-text align="center" font-family="'Courier New', monospace" font-size="11px" font-weight="bold" color="#38bdf8" letter-spacing="1.5px">
          SAVENCIA AIRWAYS &bull; SPECIAL HOLIDAY FLIGHT SV-2027 &bull; <span style="color:#f4b860;">&#9679; ALL GATES OPEN</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 2. ШАПКА: ЛОГОТИП И СТАТУС -->
    <mj-section background-color="#ffffff" padding="22px 28px" css-class="px">
      <mj-column width="55%" vertical-align="middle">
        <mj-image src="logo_color.png" alt="Groupe Savencia" width="180px" align="left" />
      </mj-column>
      <mj-column width="45%" vertical-align="middle" css-class="status-col">
        <mj-text align="right" css-class="status-text">
          <div style="display:inline-block; background-color:#f0fdf4; border:1.5px solid #22c55e; border-radius:6px; padding:6px 14px; text-align:center;">
            <div style="font-family:'Courier New', monospace; font-size:9px; font-weight:bold; color:#166534; letter-spacing:1px; text-transform:uppercase;">
              STATUS: ON TIME
            </div>
            <div style="font-family:Arial, sans-serif; font-size:12px; font-weight:bold; color:#15803d; margin-top:2px;">
              &#9679; РЕЙС ПО РАСПИСАНИЮ
            </div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 3. ГЕРОЙ: ЯРКИЙ ТЕРМИНАЛЬНЫЙ БЛОК -->
    <mj-section background-color="#004b62" padding="28px" css-class="px">
      <mj-column width="20%" vertical-align="middle" css-class="hero-sign">
        <mj-text>
          <div style="background-color:#003444; border:2px solid #de6a09; border-radius:10px; padding:12px 6px; text-align:center;">
            <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#f4b860; letter-spacing:1px;">GATE</div>
            <div style="font-family:Arial, Helvetica, sans-serif; font-size:36px; font-weight:900; color:#ffffff; line-height:1; margin:4px 0;">10</div>
            <div style="display:inline-block; background-color:#de6a09; color:#ffffff; font-size:13px; font-weight:900; padding:2px 8px; border-radius:4px;">
              ✈ &#x2794;
            </div>
          </div>
        </mj-text>
      </mj-column>

      <mj-column width="80%" vertical-align="middle" css-class="hero-main-col">
        <mj-text padding="0 0 0 16px" css-class="hero-title">
          <div style="font-family:Arial, Helvetica, sans-serif; font-size:32px; line-height:1.15; font-weight:900; color:#ffffff;">
            10 декабря &mdash;<br /><span style="color:#f4b860;">Вылет в Новый ГОД!</span>
          </div>
          <div style="font-family:'Courier New', monospace; font-size:11px; font-weight:bold; color:#93c5fd; letter-spacing:1px; margin-top:8px;">
            FLIGHT NO. SV-2027 &bull; ВСЕ ТЕРМИНАЛЫ ГОТОВЫ К ПОСАДКЕ
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 4. СЕТКА ТРЁХ ГОРОДОВ -->
    <mj-section background-color="#003444" padding="16px 20px" css-class="px">
      <mj-column width="33.33%">
        <mj-text align="center" padding="6px 0">
          <div style="color:#f4b860; font-size:10px; font-family:'Courier New', monospace; font-weight:bold;">PORT 01 &bull; MOW</div>
          <div style="color:#ffffff; font-size:16px; font-weight:900; margin-top:2px;">МОСКВА</div>
          <div style="color:#94a3b8; font-size:11px; margin-top:2px;">17:00 (МСК)</div>
        </mj-text>
      </mj-column>
      <mj-column width="33.33%">
        <mj-text align="center" padding="6px 0">
          <div style="color:#38bdf8; font-size:10px; font-family:'Courier New', monospace; font-weight:bold;">PORT 02 &bull; UFA</div>
          <div style="color:#ffffff; font-size:16px; font-weight:900; margin-top:2px;">УФА</div>
          <div style="color:#94a3b8; font-size:11px; margin-top:2px;">17:00 (УФА)</div>
        </mj-text>
      </mj-column>
      <mj-column width="33.33%">
        <mj-text align="center" padding="6px 0">
          <div style="color:#b1ca40; font-size:10px; font-family:'Courier New', monospace; font-weight:bold;">PORT 03 &bull; BEL</div>
          <div style="color:#ffffff; font-size:16px; font-weight:900; margin-top:2px;">БЕЛЕБЕЙ</div>
          <div style="color:#94a3b8; font-size:11px; margin-top:2px;">15:00 (МСК+2)</div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 5. МАНИФЕСТ И ОБРАЩЕНИЕ -->
    <mj-section background-color="#ffffff" padding="30px 28px 24px 28px" css-class="px">
      <mj-column width="100%">
        <!-- Баннер объединения трёх городов -->
        <mj-text padding="0 0 20px">
          <div style="background-color:#004b62; border-radius:8px; padding:14px 18px; text-align:center;">
            <div style="font-family:Arial, sans-serif; font-size:18px; font-weight:900; color:#ffffff; letter-spacing:0.8px;">
              ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
            </div>
          </div>
        </mj-text>

        <mj-text font-size="22px" font-weight="900" color="#004b62" padding="0 0 12px">
          Дорогие коллеги!
        </mj-text>
        <mj-text font-size="16px" font-weight="bold" color="#de6a09" line-height="1.5" padding="0 0 14px">
          Внимание, объявляется посадка на особый новогодний рейс!
        </mj-text>
        <mj-text font-size="15px" line-height="1.65" color="#173f4c" padding="0 0 14px">
          10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.
        </mj-text>
        <mj-text font-size="15px" line-height="1.65" color="#173f4c" padding="0 0 14px">
          В этот день наши праздничные площадки превратятся в аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — <strong>Новый год!</strong>
        </mj-text>
        <mj-text font-size="15px" line-height="1.65" color="#173f4c" padding="0 0 22px">
          В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.
        </mj-text>

        <!-- ПОСАДОЧНЫЙ ТАЛОН НА РОЗЫГРЫШ (АДАПТИВНЫЙ) -->
        <mj-text padding="0 0 24px">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fafc; border:2px dashed #008fd0; border-radius:12px; overflow:hidden;">
            <tr>
              <td class="tkt-main" width="68%" style="padding:18px 22px;" valign="middle">
                <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#008fd0; letter-spacing:1.5px;">
                  ★ SAVENCIA AIRLINES &bull; LUCKY BOARDING PASS
                </div>
                <div style="font-family:Arial, sans-serif; font-size:18px; font-weight:900; color:#004b62; margin:4px 0;">
                  БИЛЕТ УЧАСТНИКА РОЗЫГРЫША
                </div>
                <div style="font-size:12px; color:#64748b; line-height:1.45;">
                  Получите персональный посадочный талон на стойке регистрации в вашем городе и сохраните его до новогоднего розыгрыша подарков!
                </div>
              </td>
              <td class="tkt-stub" width="32%" align="center" valign="middle" style="padding:16px; border-left:2px dashed #008fd0; background-color:#f0f9ff;">
                <img src="barcode.png" width="130" alt="Barcode" style="display:block; width:130px; height:auto; margin:0 auto;" />
                <div style="font-family:'Courier New', monospace; font-size:9px; font-weight:bold; color:#004b62; letter-spacing:1px; margin-top:5px;">
                  SV-2027-PRIZE
                </div>
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-divider border-color="#cbdfe6" border-width="1px" border-style="solid" padding="0 0 24px" />

        <mj-text font-size="24px" line-height="1.2" font-weight="900" color="#004b62" padding="0 0 18px">
          Расписание нашего рейса
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 6. ХАБ 1: МОСКВА И УФА -->
    <mj-section background-color="#004b62" padding="16px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="19px" line-height="1.3" font-weight="900" color="#ffffff">
          ✈ МОСКВА и УФА (по местному времени)
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ЭТАПЫ МОСКВА И УФА -->
    <mj-section background-color="#e6eff2" padding="16px 20px 8px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <!-- Этап 1 -->
          <div class="time-card" style="border-left-color: #004b62;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="time-badge-col" width="125" valign="top">
                  <span style="display:inline-block; background-color:#004b62; color:#ffffff; font-weight:bold; font-size:12px; padding:5px 10px; border-radius:6px;">17:00 – 18:00</span>
                </td>
                <td valign="top" style="padding-left:8px;">
                  <div style="font-size:14px; font-weight:bold; color:#004b62;">Регистрация на рейс (Welcome)</div>
                  <div style="font-size:12px; color:#475569; margin-top:3px; line-height:1.45;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые активности.</div>
                </td>
              </tr>
            </table>
          </div>

          <!-- Этап 2 -->
          <div class="time-card" style="border-left-color: #de6a09;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="time-badge-col" width="125" valign="top">
                  <span style="display:inline-block; background-color:#de6a09; color:#ffffff; font-weight:bold; font-size:12px; padding:5px 10px; border-radius:6px;">18:00 – 20:00</span>
                </td>
                <td valign="top" style="padding-left:8px;">
                  <div style="font-size:14px; font-weight:bold; color:#004b62;">Взлёт. Торжественная часть</div>
                  <div style="font-size:12px; color:#475569; margin-top:3px; line-height:1.45;">Церемония награждения сотрудников и официальная праздничная программа.</div>
                </td>
              </tr>
            </table>
          </div>

          <!-- Этап 3 -->
          <div class="time-card" style="border-left-color: #008fd0;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="time-badge-col" width="125" valign="top">
                  <span style="display:inline-block; background-color:#008fd0; color:#ffffff; font-weight:bold; font-size:12px; padding:5px 10px; border-radius:6px;">20:00 – 23:00</span>
                </td>
                <td valign="top" style="padding-left:8px;">
                  <div style="font-size:14px; font-weight:bold; color:#004b62;">Полёт в Новый год</div>
                  <div style="font-size:12px; color:#475569; margin-top:3px; line-height:1.45;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                </td>
              </tr>
            </table>
          </div>

          <!-- Локации -->
          <div style="background-color:#ffffff; border-radius:10px; padding:14px 18px; margin-bottom:14px; font-size:12px; color:#334155; line-height:1.55;">
            <div>✈ <strong style="color:#004b62;">Аэропорт Москва:</strong> проспект Андропова, 11, корпус 2, Южный Event-Port.</div>
            <div style="margin-top:5px;">✈ <strong style="color:#004b62;">Аэропорт Уфа:</strong> улица Менделеева, 205А, ресторан «Пастернак».</div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 7. ХАБ 2: БЕЛЕБЕЙ -->
    <mj-section background-color="#de6a09" padding="16px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="19px" line-height="1.3" font-weight="900" color="#ffffff">
          ✈ БЕЛЕБЕЙ (по местному времени)
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ЭТАПЫ БЕЛЕБЕЙ -->
    <mj-section background-color="#e6eff2" padding="16px 20px 8px 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <!-- Этап 1 -->
          <div class="time-card" style="border-left-color: #004b62;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="time-badge-col" width="125" valign="top">
                  <span style="display:inline-block; background-color:#004b62; color:#ffffff; font-weight:bold; font-size:12px; padding:5px 10px; border-radius:6px;">15:00 – 15:30</span>
                </td>
                <td valign="top" style="padding-left:8px;">
                  <div style="font-size:14px; font-weight:bold; color:#004b62;">Регистрация на рейс (Welcome)</div>
                  <div style="font-size:12px; color:#475569; margin-top:3px; line-height:1.45;">Встреча пассажиров, билеты для розыгрыша, фотозона и угощения.</div>
                </td>
              </tr>
            </table>
          </div>

          <!-- Этап 2 -->
          <div class="time-card" style="border-left-color: #de6a09;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="time-badge-col" width="125" valign="top">
                  <span style="display:inline-block; background-color:#de6a09; color:#ffffff; font-weight:bold; font-size:12px; padding:5px 10px; border-radius:6px;">15:30 – 18:00</span>
                </td>
                <td valign="top" style="padding-left:8px;">
                  <div style="font-size:14px; font-weight:bold; color:#004b62;">Взлёт. Торжественная часть</div>
                  <div style="font-size:12px; color:#475569; margin-top:3px; line-height:1.45;">Церемония награждения сотрудников и праздничная программа.</div>
                </td>
              </tr>
            </table>
          </div>

          <!-- Этап 3 -->
          <div class="time-card" style="border-left-color: #008fd0;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="time-badge-col" width="125" valign="top">
                  <span style="display:inline-block; background-color:#008fd0; color:#ffffff; font-weight:bold; font-size:12px; padding:5px 10px; border-radius:6px;">18:00 – 20:00</span>
                </td>
                <td valign="top" style="padding-left:8px;">
                  <div style="font-size:14px; font-weight:bold; color:#004b62;">Полёт в Новый год</div>
                  <div style="font-size:12px; color:#475569; margin-top:3px; line-height:1.45;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                </td>
              </tr>
            </table>
          </div>

          <!-- Локация -->
          <div style="background-color:#ffffff; border-radius:10px; padding:14px 18px; margin-bottom:14px; font-size:12px; color:#334155; line-height:1.55;">
            ✈ <strong style="color:#004b62;">Аэропорт Белебей:</strong> улица Амирова, 10А, Центральный дворец культуры.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 8. ФИНАЛЬНЫЙ БЛОК: ДО ВСТРЕЧИ 10 ДЕКАБРЯ -->
    <mj-section background-color="#004b62" padding="28px 24px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="24px" font-weight="900" color="#ffffff" align="center" line-height="1.2">
          До встречи 10 декабря!
        </mj-text>
        <mj-text font-size="15px" color="#38bdf8" font-weight="bold" align="center" padding-top="8px">
          Ваш экипаж Savencia ✈
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- БРЕНДОВЫЙ ТРИКОЛОР -->
    <mj-section background-color="#e6eff2" padding="16px 0 24px 0">
      <mj-group width="240px">
        <mj-column width="33.33%">
          <mj-divider border-color="#008fd0" border-width="4px" padding="0" />
        </mj-column>
        <mj-column width="33.33%">
          <mj-divider border-color="#b1ca40" border-width="4px" padding="0" />
        </mj-column>
        <mj-column width="33.33%">
          <mj-divider border-color="#de6a09" border-width="4px" padding="0" />
        </mj-column>
      </mj-group>
    </mj-section>

  </mj-body>
</mjml>