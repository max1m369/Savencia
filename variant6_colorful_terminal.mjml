<mjml lang="ru">
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Groupe Savencia</mj-title>
    <mj-preview>10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#173f4c" padding="0 0 16px" />
      <mj-image padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width:479px) {
        .px { padding-left: 18px !important; padding-right: 18px !important; }
        .hero-title div { font-size: 26px !important; line-height: 1.15 !important; }
        .hero-sign { display: none !important; }
        .status-col { width: 100% !important; text-align: center !important; margin-top: 10px !important; }
        .status-text div { text-align: center !important; }
        .status-badge { margin: 6px auto 0 auto !important; }
        .time-col { width: 100% !important; border-left: none !important; border-bottom: 2px solid #004b62 !important; padding-bottom: 8px !important; }
        .desc-col { width: 100% !important; padding-top: 10px !important; }
        .sched-time div { font-size: 24px !important; }
        .route-step { display: block !important; width: 100% !important; margin-bottom: 8px !important; text-align: center !important; }
        .route-arrow { display: none !important; }
        .tkt-stub { display: block !important; width: 100% !important; border-left: none !important; border-top: 2px dashed #de6a09 !important; padding-top: 14px !important; }
        .tkt-main { display: block !important; width: 100% !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body width="640px" background-color="#e6eff2">

    <!-- 1. ТЕЛЕТАЙП-ЛЕНТА СТАТУСА РЕЙСА (АЭРОПОРТНЫЙ ТЕРМИНАЛ) -->
    <mj-section background-color="#00232f" padding="10px 24px">
      <mj-column width="100%">
        <mj-text align="center" font-family="'Courier New', monospace" font-size="11px" font-weight="bold" color="#38bdf8" letter-spacing="1.5px" padding="0">
          SAVENCIA AIRWAYS &bull; SPECIAL HOLIDAY FLIGHT SV-2027 &bull; <span style="color:#f4b860;">&#9679; ALL GATES OPEN</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 2. ШАПКА: ЛОГОТИП SAVENCIA И БЕЙДЖ ПОСАДКИ -->
    <mj-section background-color="#ffffff" padding="22px 28px" css-class="px">
      <mj-column width="55%" vertical-align="middle">
        <mj-image src="logo_color.png" alt="Groupe Savencia" width="180px" align="left" />

      </mj-column>
      <mj-column width="45%" vertical-align="middle" css-class="status-col">
        <mj-text align="right" padding="0" css-class="status-text">
          <div class="status-badge" style="display:inline-block; background-color:#f0fdf4; border:1.5px solid #22c55e; border-radius:4px; padding:6px 14px; text-align:center;">
            <div style="font-family:'Courier New', monospace; font-size:9px; font-weight:bold; color:#166534; letter-spacing:1px; text-transform:uppercase;">
              STATUS: ON TIME
            </div>
            <div style="font-family:Arial, sans-serif; font-size:12px; font-weight:bold; color:#15803d; margin-top:2px;">
              &#9679; РЕЙС ПО РАСПИСАНИЮ
            </div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 3. ГЕРОЙ: ЦВЕТНОЙ ТЕРМИНАЛЬНЫЙ БЛОК (#004b62 + WAYFINDING GATE 10) -->
    <mj-section background-color="#004b62" padding="28px" css-class="px">
      <mj-column width="22%" vertical-align="middle" css-class="hero-sign">
        <mj-text padding="0">
          <div style="background-color:#003444; border:2px solid #de6a09; border-radius:8px; padding:12px 6px; text-align:center;">
            <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#f4b860; letter-spacing:1px;">GATE</div>
            <div style="font-family:Arial, Helvetica, sans-serif; font-size:36px; font-weight:900; color:#ffffff; line-height:1; margin:4px 0;">10</div>
            <div style="display:inline-block; background-color:#de6a09; color:#ffffff; font-size:14px; font-weight:900; padding:2px 8px; border-radius:3px;">
              &#x2708;&#xFE0E; &#x2794;
            </div>
          </div>
        </mj-text>
      </mj-column>

      <mj-column width="78%" vertical-align="middle">
        <mj-text padding="0 0 0 16px" css-class="hero-title">

          <div style="font-family:Arial, Helvetica, sans-serif; font-size:33px; line-height:1.15; font-weight:900; color:#ffffff; letter-spacing:-0.5px;">
            10 декабря &mdash;<br /><span style="color:#f4b860;">Вылет в Новый ГОД!</span>
          </div>
          <div style="font-family:'Courier New', monospace; font-size:11px; font-weight:bold; color:#93c5fd; letter-spacing:1px; margin-top:8px;">
            FLIGHT NO. SV-2027 &bull; ВСЕ ТЕРМИНАЛЫ ГОТОВЫ К ПОСАДКЕ
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 4. СЕТКА ТРЁХ ГОРОДОВ (МАРШРУТ ПОЛЁТА В СТИЛЕ FIDS / WAYFINDING) -->
    <mj-section background-color="#081f28" padding="16px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="30%" align="center" style="padding:4px;" class="route-step">
                <div style="font-family:'Courier New', monospace; font-size:9px; color:#38bdf8; letter-spacing:1px;">PORT 01 &bull; SVO</div>
                <div style="font-family:Arial, sans-serif; font-size:16px; font-weight:900; color:#ffffff;">МОСКВА</div>
                <div style="font-family:'Courier New', monospace; font-size:10px; color:#de6a09; font-weight:bold;">17:00 (МСК)</div>
              </td>
              <td width="5%" align="center" style="color:#f4b860; font-size:16px;" class="route-arrow">&#x2794;</td>
              <td width="30%" align="center" style="padding:4px;" class="route-step">
                <div style="font-family:'Courier New', monospace; font-size:9px; color:#38bdf8; letter-spacing:1px;">PORT 02 &bull; UFA</div>
                <div style="font-family:Arial, sans-serif; font-size:16px; font-weight:900; color:#ffffff;">УФА</div>
                <div style="font-family:'Courier New', monospace; font-size:10px; color:#de6a09; font-weight:bold;">17:00 (УФА)</div>
              </td>
              <td width="5%" align="center" style="color:#f4b860; font-size:16px;" class="route-arrow">&#x2794;</td>
              <td width="30%" align="center" style="padding:4px;" class="route-step">
                <div style="font-family:'Courier New', monospace; font-size:9px; color:#38bdf8; letter-spacing:1px;">PORT 03 &bull; BEL</div>
                <div style="font-family:Arial, sans-serif; font-size:16px; font-weight:900; color:#ffffff;">БЕЛЕБЕЙ</div>
                <div style="font-family:'Courier New', monospace; font-size:10px; color:#de6a09; font-weight:bold;">15:00 (МСК)</div>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 5. ПРИВЕТСТВИЕ: ДОРОГИЕ КОЛЛЕГИ -->
    <mj-section background-color="#ffffff" padding="32px 28px 18px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="22px" font-weight="900" color="#004b62" padding="0 0 14px">
          Дорогие коллеги!
        </mj-text>
        <mj-text font-size="17px" font-weight="bold" color="#de6a09" line-height="1.5" padding="0 0 14px">
          Внимание, объявляется посадка на особый новогодний рейс!
        </mj-text>
        <mj-text font-size="16px" line-height="1.65" color="#173f4c" padding="0 0 20px">
          10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов &mdash; Москвы, Уфы и Белебея.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 6. АКЦЕНТНЫЙ БАННЕР: ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА -->
    <mj-section background-color="#004b62" padding="20px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="36" valign="middle" align="left">
                <div style="font-size:22px; color:#f4b860;">&#x2708;&#xFE0E;</div>
              </td>
              <td valign="middle" align="left">
                <div style="font-family:Arial, Helvetica, sans-serif; font-size:21px; line-height:1.3; font-weight:900; color:#ffffff; letter-spacing:0.5px;">
                  ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
                </div>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 7. ТЕЛО ПИСЬМА: ПРОГРАММА И ЛОТЕРЕЙНЫЙ БИЛЕТ -->
    <mj-section background-color="#ffffff" padding="24px 28px 24px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="16px" line-height="1.65" color="#173f4c" padding="0 0 14px">
          В этот день наши праздничные площадки превратятся в аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения &mdash; Новый год!
        </mj-text>
        <mj-text font-size="16px" line-height="1.65" color="#173f4c" padding="0 0 14px">
          В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.
        </mj-text>
        <mj-text font-size="16px" line-height="1.65" color="#173f4c" padding="0 0 24px">
          На регистрации каждый получит свой посадочный билет, который пригодится во время новогоднего розыгрыша подарков.
        </mj-text>

        <!-- ПОСАДОЧНЫЙ ТАЛОН НА РОЗЫГРЫШ -->
        <mj-text padding="0 0 24px">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fafc; border:2px dashed #008fd0; border-radius:10px; overflow:hidden;">
            <tr>
              <td class="tkt-main" width="70%" style="padding:16px 20px;" valign="middle">
                <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#008fd0; letter-spacing:1.5px;">
                  &#x2605; SAVENCIA AIRLINES &bull; LUCKY BOARDING PASS
                </div>
                <div style="font-family:Arial, sans-serif; font-size:17px; font-weight:900; color:#004b62; margin:4px 0;">
                  БИЛЕТ УЧАСТНИКА РОЗЫГРЫША
                </div>
                <div style="font-size:12px; color:#64748b; line-height:1.4;">
                  Получите персональный посадочный талон на стойке регистрации в вашем городе и сохраните его до новогоднего розыгрыша призов!
                </div>
              </td>
              <td class="tkt-stub" width="30%" align="center" valign="middle" style="padding:14px; border-left:2px dashed #008fd0; background-color:#f0f9ff;">
                <img src="barcode.png" width="130" alt="Barcode" style="display:block; width:130px; height:auto; margin:0 auto;" />
                <div style="font-family:'Courier New', monospace; font-size:9px; font-weight:bold; color:#004b62; letter-spacing:1px; margin-top:4px;">
                  SV-2027-PRIZE
                </div>
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-divider border-color="#cbdfe6" border-width="1px" border-style="solid" padding="0 0 24px" />

        <mj-text font-size="26px" line-height="1.2" font-weight="900" color="#004b62" padding="0 0 18px">
          Расписание нашего рейса
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 8. ХАБ 1: МОСКВА И УФА (ФИРМЕННЫЕ ЦВЕТНЫЕ БЛОКИ: #008fd0, #1bbbe9, #e9f6fa) -->
    <mj-section background-color="#004b62" padding="16px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="20px" line-height="1.3" font-weight="900" color="#ffffff" padding="0">
          &#x2708;&#xFE0E; МОСКВА и УФА (по местному времени)
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Белый разделитель -->
    <mj-section background-color="#ffffff" padding="0">
      <mj-column><mj-divider border-color="#ffffff" border-width="6px" padding="0" /></mj-column>
    </mj-section>

    <!-- Блок 1: Синий (#008fd0) - Регистрация -->
    <mj-section background-color="#008fd0" padding="22px 28px" css-class="px">
      <mj-column width="43%" vertical-align="top" border-left="4px solid #004b62" css-class="time-col">
        <mj-text padding="2px 16px 6px" css-class="sched-time">
          <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#e0f2fe; letter-spacing:1.5px; text-transform:uppercase;">
            STAGE 01 // WELCOME
          </div>
          <div style="font-family:Arial, Helvetica, sans-serif; font-size:28px; line-height:1.15; font-weight:900; color:#ffffff;">
            17:00&ndash;18:00
          </div>
        </mj-text>
      </mj-column>
      <mj-column width="57%" vertical-align="top" css-class="desc-col">
        <mj-text padding="2px 0 0 16px">
          <div style="font-family:Arial, sans-serif; font-size:20px; line-height:1.25; font-weight:900; color:#ffffff; margin-bottom:6px;">
            Регистрация на рейс (Welcome)
          </div>
          <div style="font-family:Arial, sans-serif; font-size:15px; line-height:1.55; color:#ffffff;">
            Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Белый разделитель -->
    <mj-section background-color="#ffffff" padding="0">
      <mj-column><mj-divider border-color="#ffffff" border-width="6px" padding="0" /></mj-column>
    </mj-section>

    <!-- Блок 2: Голубой (#1bbbe9) - Взлёт -->
    <mj-section background-color="#1bbbe9" padding="22px 28px" css-class="px">
      <mj-column width="43%" vertical-align="top" border-left="4px solid #004b62" css-class="time-col">
        <mj-text padding="2px 16px 6px" css-class="sched-time">
          <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#003444; letter-spacing:1.5px; text-transform:uppercase;">
            STAGE 02 // TAKEOFF
          </div>
          <div style="font-family:Arial, Helvetica, sans-serif; font-size:28px; line-height:1.15; font-weight:900; color:#004b62;">
            18:00&ndash;20:00
          </div>
        </mj-text>
      </mj-column>
      <mj-column width="57%" vertical-align="top" css-class="desc-col">
        <mj-text padding="2px 0 0 16px">
          <div style="font-family:Arial, sans-serif; font-size:20px; line-height:1.25; font-weight:900; color:#004b62; margin-bottom:6px;">
            Взлёт. Торжественная часть
          </div>
          <div style="font-family:Arial, sans-serif; font-size:15px; line-height:1.55; color:#004b62;">
            Церемония награждения сотрудников и праздничная программа.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Белый разделитель -->
    <mj-section background-color="#ffffff" padding="0">
      <mj-column><mj-divider border-color="#ffffff" border-width="6px" padding="0" /></mj-column>
    </mj-section>

    <!-- Блок 3: Светло-голубой ледяной (#e9f6fa) - Полёт -->
    <mj-section background-color="#e9f6fa" padding="22px 28px" css-class="px">
      <mj-column width="43%" vertical-align="top" border-left="4px solid #004b62" css-class="time-col">
        <mj-text padding="2px 16px 6px" css-class="sched-time">
          <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#0369a1; letter-spacing:1.5px; text-transform:uppercase;">
            STAGE 03 // CRUISE
          </div>
          <div style="font-family:Arial, Helvetica, sans-serif; font-size:28px; line-height:1.15; font-weight:900; color:#004b62;">
            20:00&ndash;23:00
          </div>
        </mj-text>
      </mj-column>
      <mj-column width="57%" vertical-align="top" css-class="desc-col">
        <mj-text padding="2px 0 0 16px">
          <div style="font-family:Arial, sans-serif; font-size:20px; line-height:1.25; font-weight:900; color:#004b62; margin-bottom:6px;">
            Полёт в Новый год
          </div>
          <div style="font-family:Arial, sans-serif; font-size:15px; line-height:1.55; color:#004b62;">
            Музыка, фуршет, развлечения, общение и новогодние сюрпризы.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Аэропорты отправления: Москва и Уфа -->
    <mj-section background-color="#ffffff" padding="24px 28px 12px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="16px" font-weight="900" color="#004b62" padding="0 0 12px">
          Аэропорты отправления:
        </mj-text>
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="padding-bottom:10px;">
                <span style="font-family:'Courier New', monospace; font-size:11px; font-weight:bold; background-color:#004b62; color:#ffffff; padding:2px 7px; border-radius:3px;">MOW // TERMINAL 01</span>
                <strong style="color:#004b62; font-size:14px; margin-left:8px;">МОСКВА:</strong>
                <div style="color:#173f4c; font-size:14px; margin-top:3px; padding-left:4px;">проспект Андропова, 11, корпус 2, Южный Event-Port.</div>
              </td>
            </tr>
            <tr>
              <td style="padding-bottom:12px;">
                <span style="font-family:'Courier New', monospace; font-size:11px; font-weight:bold; background-color:#004b62; color:#ffffff; padding:2px 7px; border-radius:3px;">UFA // TERMINAL 02</span>
                <strong style="color:#004b62; font-size:14px; margin-left:8px;">УФА:</strong>
                <div style="color:#173f4c; font-size:14px; margin-top:3px; padding-left:4px;">улица Менделеева, 205А, ресторан &laquo;Пастернак&raquo;.</div>
              </td>
            </tr>
          </table>
        </mj-text>
        <mj-divider border-color="#de6a09" border-style="solid" border-width="3px" padding="12px 0 24px" />
      </mj-column>
    </mj-section>

    <!-- 9. ХАБ 2: БЕЛЕБЕЙ (ФИРМЕННЫЕ ЦВЕТНЫЕ БЛОКИ) -->
    <mj-section background-color="#004b62" padding="16px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="20px" line-height="1.3" font-weight="900" color="#ffffff" padding="0">
          &#x2708;&#xFE0E; БЕЛЕБЕЙ
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Белый разделитель -->
    <mj-section background-color="#ffffff" padding="0">
      <mj-column><mj-divider border-color="#ffffff" border-width="6px" padding="0" /></mj-column>
    </mj-section>

    <!-- Блок 1 Белебей: Синий (#008fd0) -->
    <mj-section background-color="#008fd0" padding="22px 28px" css-class="px">
      <mj-column width="43%" vertical-align="top" border-left="4px solid #004b62" css-class="time-col">
        <mj-text padding="2px 16px 6px" css-class="sched-time">
          <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#e0f2fe; letter-spacing:1.5px; text-transform:uppercase;">
            STAGE 01 // WELCOME
          </div>
          <div style="font-family:Arial, Helvetica, sans-serif; font-size:28px; line-height:1.15; font-weight:900; color:#ffffff;">
            15:00&ndash;15:30
          </div>
        </mj-text>
      </mj-column>
      <mj-column width="57%" vertical-align="top" css-class="desc-col">
        <mj-text padding="2px 0 0 16px">
          <div style="font-family:Arial, sans-serif; font-size:20px; line-height:1.25; font-weight:900; color:#ffffff; margin-bottom:6px;">
            Регистрация на рейс (Welcome)
          </div>
          <div style="font-family:Arial, sans-serif; font-size:15px; line-height:1.55; color:#ffffff;">
            Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Белый разделитель -->
    <mj-section background-color="#ffffff" padding="0">
      <mj-column><mj-divider border-color="#ffffff" border-width="6px" padding="0" /></mj-column>
    </mj-section>

    <!-- Блок 2 Белебей: Голубой (#1bbbe9) -->
    <mj-section background-color="#1bbbe9" padding="22px 28px" css-class="px">
      <mj-column width="43%" vertical-align="top" border-left="4px solid #004b62" css-class="time-col">
        <mj-text padding="2px 16px 6px" css-class="sched-time">
          <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#003444; letter-spacing:1.5px; text-transform:uppercase;">
            STAGE 02 // TAKEOFF
          </div>
          <div style="font-family:Arial, Helvetica, sans-serif; font-size:28px; line-height:1.15; font-weight:900; color:#004b62;">
            15:30&ndash;18:00
          </div>
        </mj-text>
      </mj-column>
      <mj-column width="57%" vertical-align="top" css-class="desc-col">
        <mj-text padding="2px 0 0 16px">
          <div style="font-family:Arial, sans-serif; font-size:20px; line-height:1.25; font-weight:900; color:#004b62; margin-bottom:6px;">
            Взлёт. Торжественная часть
          </div>
          <div style="font-family:Arial, sans-serif; font-size:15px; line-height:1.55; color:#004b62;">
            Церемония награждения сотрудников и праздничная программа.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Белый разделитель -->
    <mj-section background-color="#ffffff" padding="0">
      <mj-column><mj-divider border-color="#ffffff" border-width="6px" padding="0" /></mj-column>
    </mj-section>

    <!-- Блок 3 Белебей: Светло-голубой ледяной (#e9f6fa) -->
    <mj-section background-color="#e9f6fa" padding="22px 28px" css-class="px">
      <mj-column width="43%" vertical-align="top" border-left="4px solid #004b62" css-class="time-col">
        <mj-text padding="2px 16px 6px" css-class="sched-time">
          <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#0369a1; letter-spacing:1.5px; text-transform:uppercase;">
            STAGE 03 // CRUISE
          </div>
          <div style="font-family:Arial, Helvetica, sans-serif; font-size:28px; line-height:1.15; font-weight:900; color:#004b62;">
            18:00&ndash;20:00
          </div>
        </mj-text>
      </mj-column>
      <mj-column width="57%" vertical-align="top" css-class="desc-col">
        <mj-text padding="2px 0 0 16px">
          <div style="font-family:Arial, sans-serif; font-size:20px; line-height:1.25; font-weight:900; color:#004b62; margin-bottom:6px;">
            Полёт в Новый год
          </div>
          <div style="font-family:Arial, sans-serif; font-size:15px; line-height:1.55; color:#004b62;">
            Музыка, фуршет, развлечения, общение и новогодние сюрпризы.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Аэропорт отправления: Белебей -->
    <mj-section background-color="#ffffff" padding="24px 28px 12px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text font-size="16px" font-weight="900" color="#004b62" padding="0 0 12px">
          Аэропорт отправления:
        </mj-text>
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="padding-bottom:12px;">
                <span style="font-family:'Courier New', monospace; font-size:11px; font-weight:bold; background-color:#004b62; color:#ffffff; padding:2px 7px; border-radius:3px;">BEL // TERMINAL 03</span>
                <strong style="color:#004b62; font-size:14px; margin-left:8px;">БЕЛЕБЕЙ:</strong>
                <div style="color:#173f4c; font-size:14px; margin-top:3px; padding-left:4px;">улица Амирова, 10А, Центральный дворец культуры Белебеевского района.</div>
              </td>
            </tr>
          </table>
        </mj-text>
        <mj-divider border-color="#de6a09" border-style="solid" border-width="3px" padding="12px 0 28px" />
      </mj-column>
    </mj-section>

    <!-- 10. ФИНАЛЬНЫЙ ПРИЗЫВ: УВАЖАЕМЫЕ ПАССАЖИРЫ -->
    <mj-section background-color="#ffffff" padding="0 28px 28px 28px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <div style="background-color:#fff7ed; border:1.5px solid #fdba74; border-radius:8px; padding:18px 22px;">
            <div style="font-family:Arial, sans-serif; font-size:20px; font-weight:900; color:#c2410c; margin-bottom:10px;">
              &#x2708;&#xFE0E; Уважаемые пассажиры!
            </div>
            <div style="font-family:Arial, sans-serif; font-size:15px; line-height:1.6; color:#7c2d12; margin-bottom:8px;">
              Просим заранее подготовить хорошее настроение и быть готовыми к незабываемому путешествию.
            </div>
            <div style="font-family:Arial, sans-serif; font-size:16px; font-weight:bold; line-height:1.6; color:#9a3412;">
              Наш новогодний рейс уже готовится к вылету. На борту ждём каждого!
            </div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 11. ПОДВАЛ: ЭКИПАЖ SAVENCIA И ОФИЦИАЛЬНОЕ ЗАВЕРШЕНИЕ -->
    <mj-section background-color="#004b62" padding="28px 28px 32px 28px" css-class="px">
      <mj-column width="70%" vertical-align="middle">
        <mj-text font-size="24px" line-height="1.2" font-weight="900" color="#ffffff" padding="0 0 8px">
          До встречи 10 декабря!
        </mj-text>
        <mj-text font-size="16px" font-weight="bold" color="#38bdf8" padding="0">
          Ваш экипаж Savencia &#x2708;&#xFE0E;
        </mj-text>
      </mj-column>
      <mj-column width="30%" vertical-align="middle">
        <mj-text align="right" font-family="'Courier New', monospace" font-size="11px" color="#94a3b8" padding="0">
          SAVENCIA 2026<br />
          <span style="color:#f4b860; font-weight:bold;">EXP&Eacute;DITION SV</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Волосяная оранжевая янтарная полоска в самом низу -->
    <mj-section background-color="#de6a09" padding="4px 0">
      <mj-column><mj-text padding="0">&nbsp;</mj-text></mj-column>
    </mj-section>

  </mj-body>
</mjml>
