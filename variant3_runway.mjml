<mjml lang="ru">
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Savencia Runway</mj-title>
    <mj-preview>10 декабря отправляемся в праздничное путешествие: Москва, Уфа и Белебей на одном новогоднем рейсе!</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" padding="0" />
      <mj-text font-size="15px" line-height="1.6" color="#334155" />
      <mj-section background-color="#061a24" />
    </mj-attributes>
    <mj-style>
      /* Hallmark · built: Savencia · redesign: Cinematic Runway Sunset · genre: atmospheric */
      :root {
        --color-bg-deep: #061a24;
        --color-bg-dark-card: #0a2533;
        --color-bg-paper: #f4f7f6;
        --color-navy: #004b62;
        --color-orange: #de6a09;
        --color-amber: #e58e26;
        --color-sky: #008fd0;
        --color-cyan: #38bdf8;
      }
      .runway-card {
        background-color: #0a2533;
        border-radius: 16px;
        border: 1px solid #143b50;
        overflow: hidden;
      }
      @media only screen and (max-width: 479px) {
        .px-m {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }
        .time-badge {
          display: inline-block !important;
          margin-bottom: 6px !important;
        }
        .city-box {
          display: block !important;
          width: 100% !important;
          margin-bottom: 12px !important;
        }
        .h1-mobile div {
          font-size: 32px !important;
          line-height: 1.1 !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body width="640px" background-color="#04121a">

    

    <!-- ШАПКА: БЕЛЫЙ БЛОК С ЛОГОТИПОМ -->
    <mj-section background-color="#ffffff" padding="22px 28px 18px 28px" border-radius="0" css-class="px-m">
      <mj-column width="50%" vertical-align="middle">
        <mj-image align="left" width="170px" src="logo_color.png" alt="Groupe Savencia" />
      </mj-column>
      <mj-column width="50%" vertical-align="middle">
        <mj-text align="right" font-size="12px" color="#004b62" font-weight="bold">
          РЕЙС: <span style="color:#008fd0;">SV-2027</span> &nbsp;|&nbsp; ГЕЙТ: <span style="color:#de6a09;">2027</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- СИНЕМАТИЧЕСКИЙ БАННЕР ВЗЛЁТА -->
    <mj-section background-color="#061a24" padding="0">
      <mj-column width="100%">
        <mj-image src="A_clean_cinematic_hero.png" alt="Взлёт в Новый год — Savencia" width="640px" />
      </mj-column>
    </mj-section>

    <!-- ТИТУЛЬНЫЙ МАНИФЕСТ РЕЙСА -->
    <mj-section background-color="#061a24" padding="28px 28px 16px 28px" css-class="px-m">
      <mj-column width="100%">
        <mj-text font-size="12px" font-weight="bold" letter-spacing="2px" color="#38bdf8" text-transform="uppercase" padding-bottom="8px">
          FLIGHT DISPATCH // 10 ДЕКАБРЯ 2026
        </mj-text>
        <mj-text font-size="34px" font-weight="900" line-height="1.15" color="#ffffff" css-class="h1-mobile">
          ТРИ ГОРОДА. ОДИН РЕЙС.<br /><span style="color:#e58e26;">ОДНА КОМАНДА.</span>
        </mj-text>
        <mj-text font-size="17px" font-weight="bold" color="#de6a09" padding-top="8px">
          10 декабря — Вылет в Новый ГОД!
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ОБРАЩЕНИЕ К КОМАНДЕ (КРЕМОВАЯ ПОЛИГРАФИЧЕСКАЯ КАРТОЧКА) -->
    <mj-section background-color="#061a24" padding="10px 20px 24px 20px" css-class="px-m">
      <mj-column width="100%">
        <mj-text padding="0">
          <div style="transform: rotate(-1.5deg); -webkit-transform: rotate(-1.5deg); margin: 6px 4px 10px; box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 4px 12px rgba(0, 0, 0, 0.25); border-radius: 14px; overflow: hidden;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="background-color: #f8fafc; border-radius: 14px; padding: 24px 26px; border-left: 5px solid #de6a09;">
                <div style="font-size: 19px; font-weight: 900; color: #004b62; margin-bottom: 10px;">Дорогие коллеги!</div>
                <div style="font-size: 15px; font-weight: bold; color: #de6a09; margin-bottom: 12px; line-height: 1.45;">Внимание, объявляется посадка на особый новогодний рейс!</div>
                <div style="font-size: 14px; color: #334155; line-height: 1.6; margin-bottom: 10px;">10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — <strong>Москвы, Уфы и Белебея</strong>.</div>
                <div style="font-size: 14px; color: #475569; line-height: 1.6; margin-bottom: 10px;">В этот день наши площадки станут настоящими терминалами, а каждый сотрудник — пассажиром рейса к Новому году!</div>
                <div style="font-size: 14px; color: #475569; line-height: 1.6;"><strong>В программе полёта:</strong> тёплые встречи, заслуженные награды, подарки, музыка и праздничное настроение.</div>
              </td>
            </tr>
          </table>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- RUNWAY GLIDESLOPE: РАСПИСАНИЕ МОСКВА И УФА -->
    <mj-section background-color="#061a24" padding="10px 20px 20px 20px" css-class="px-m">
      <mj-column width="100%">
        <mj-text padding="0">
          <div class="runway-card">
            <!-- Заголовок хаба -->
            <div style="background-color: #0d2e40; padding: 16px 22px; border-bottom: 2px solid #e58e26;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left">
                    <div style="font-size: 11px; font-weight: bold; color: #38bdf8; letter-spacing: 1.5px;">RUNWAY 01 // ТЕРМИНАЛЫ</div>
                    <div style="font-size: 18px; font-weight: 900; color: #ffffff; margin-top: 3px;">✈ МОСКВА И УФА</div>
                  </td>
                  <td align="right" valign="middle">
                    <span style="background-color: #061a24; color: #cbd5e1; font-size: 10px; font-weight: bold; padding: 4px 8px; border-radius: 4px; border: 1px solid #1a4258;">МЕСТНОЕ ВРЕМЯ</span>
                  </td>
                </tr>
              </table>
            </div>

            <!-- Этапы вылета -->
            <div style="padding: 20px 22px;">
              <!-- Этап 1 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                <tr>
                  <td width="120" valign="top">
                    <span class="time-badge" style="display:inline-block; background-color: #004b62; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">17:00 – 18:00</span>
                  </td>
                  <td valign="top" style="padding-left: 8px;">
                    <div style="color: #ffffff; font-weight: bold; font-size: 14px;">Регистрация на рейс (Welcome)</div>
                    <div style="color: #94a3b8; font-size: 12px; margin-top: 3px; line-height: 1.45;">Встреча пассажиров, посадочные билеты, фотозона, угощения и старт праздника.</div>
                  </td>
                </tr>
              </table>

              <!-- Этап 2 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                <tr>
                  <td width="120" valign="top">
                    <span class="time-badge" style="display:inline-block; background-color: #de6a09; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">18:00 – 20:00</span>
                  </td>
                  <td valign="top" style="padding-left: 8px;">
                    <div style="color: #ffffff; font-weight: bold; font-size: 14px;">Взлёт. Торжественная часть</div>
                    <div style="color: #94a3b8; font-size: 12px; margin-top: 3px; line-height: 1.45;">Церемония награждения сотрудников и официальная новогодняя программа.</div>
                  </td>
                </tr>
              </table>

              <!-- Этап 3 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 16px;">
                <tr>
                  <td width="120" valign="top">
                    <span class="time-badge" style="display:inline-block; background-color: #008fd0; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">20:00 – 23:00</span>
                  </td>
                  <td valign="top" style="padding-left: 8px;">
                    <div style="color: #ffffff; font-weight: bold; font-size: 14px;">Полёт в Новый год</div>
                    <div style="color: #94a3b8; font-size: 12px; margin-top: 3px; line-height: 1.45;">Праздничный фуршет, музыка, общение и новогодние сюрпризы.</div>
                  </td>
                </tr>
              </table>

              <!-- Локации -->
              <div style="padding-top: 14px; border-top: 1px dashed #1b4962; font-size: 12px; color: #cbd5e1; line-height: 1.55;">
                <div>✈ <strong style="color:#ffffff;">Москва:</strong> проспект Андропова, 11, корпус 2, Южный Event-Port.</div>
                <div style="margin-top: 6px;">✈ <strong style="color:#ffffff;">Уфа:</strong> улица Менделеева, 205А, ресторан «Пастернак».</div>
              </div>
            </div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- RUNWAY GLIDESLOPE: РАСПИСАНИЕ БЕЛЕБЕЙ -->
    <mj-section background-color="#061a24" padding="0 20px 24px 20px" css-class="px-m">
      <mj-column width="100%">
        <mj-text padding="0">
          <div class="runway-card">
            <!-- Заголовок хаба -->
            <div style="background-color: #0d2e40; padding: 16px 22px; border-bottom: 2px solid #de6a09;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left">
                    <div style="font-size: 11px; font-weight: bold; color: #38bdf8; letter-spacing: 1.5px;">RUNWAY 02 // ТЕРМИНАЛ</div>
                    <div style="font-size: 18px; font-weight: 900; color: #ffffff; margin-top: 3px;">✈ БЕЛЕБЕЙ</div>
                  </td>
                  <td align="right" valign="middle">
                    <span style="background-color: #061a24; color: #cbd5e1; font-size: 10px; font-weight: bold; padding: 4px 8px; border-radius: 4px; border: 1px solid #1a4258;">МЕСТНОЕ ВРЕМЯ</span>
                  </td>
                </tr>
              </table>
            </div>

            <!-- Этапы вылета -->
            <div style="padding: 20px 22px;">
              <!-- Этап 1 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                <tr>
                  <td width="120" valign="top">
                    <span class="time-badge" style="display:inline-block; background-color: #004b62; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">15:00 – 15:30</span>
                  </td>
                  <td valign="top" style="padding-left: 8px;">
                    <div style="color: #ffffff; font-weight: bold; font-size: 14px;">Регистрация на рейс (Welcome)</div>
                    <div style="color: #94a3b8; font-size: 12px; margin-top: 3px; line-height: 1.45;">Встреча пассажиров, билеты для розыгрыша, фотозона и угощения.</div>
                  </td>
                </tr>
              </table>

              <!-- Этап 2 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                <tr>
                  <td width="120" valign="top">
                    <span class="time-badge" style="display:inline-block; background-color: #de6a09; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">15:30 – 18:00</span>
                  </td>
                  <td valign="top" style="padding-left: 8px;">
                    <div style="color: #ffffff; font-weight: bold; font-size: 14px;">Взлёт. Торжественная часть</div>
                    <div style="color: #94a3b8; font-size: 12px; margin-top: 3px; line-height: 1.45;">Награждение сотрудников и яркая праздничная программа.</div>
                  </td>
                </tr>
              </table>

              <!-- Этап 3 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 16px;">
                <tr>
                  <td width="120" valign="top">
                    <span class="time-badge" style="display:inline-block; background-color: #008fd0; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">18:00 – 20:00</span>
                  </td>
                  <td valign="top" style="padding-left: 8px;">
                    <div style="color: #ffffff; font-weight: bold; font-size: 14px;">Полёт в Новый год</div>
                    <div style="color: #94a3b8; font-size: 12px; margin-top: 3px; line-height: 1.45;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                  </td>
                </tr>
              </table>

              <!-- Локация -->
              <div style="padding-top: 14px; border-top: 1px dashed #1b4962; font-size: 12px; color: #cbd5e1; line-height: 1.55;">
                ✈ <strong style="color:#ffffff;">Белебей:</strong> улица Амирова, 10А, Центральный дворец культуры.
              </div>
            </div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ФИНАЛЬНЫЙ БЛОК: ДО ВСТРЕЧИ 10 ДЕКАБРЯ -->
    <mj-section background-color="#0d2e40" padding="32px 28px" border-radius="0" css-class="px-m">
      <mj-column width="100%">
        <mj-text font-size="26px" font-weight="900" color="#ffffff" align="center" line-height="1.2">
          До встречи 10 декабря!
        </mj-text>
        <mj-text font-size="15px" color="#38bdf8" font-weight="bold" align="center" padding-top="8px">
          Ваш экипаж Savencia ✈
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- БРЕНДОВЫЙ ТРИКОЛОР -->
    <mj-section background-color="#0d2e40" padding="0 0 24px 0">
      <mj-group width="240px">
        <mj-column width="33.33%">
          <mj-divider border-color="#008fd0" border-width="4px" padding="0" />
        </mj-column>
        <mj-column width="33.33%">
          <mj-divider border-color="#b1ca40" border-width="4px" padding="0" />
        </mj-column>
        <mj-column width="33.33%">
          <mj-divider border-color="#de6a09" border-width="4px" padding="0" />
        </mj-column>
      </mj-group>
    </mj-section>

  </mj-body>
</mjml>