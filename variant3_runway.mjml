      <mj-column>
        <mj-text font-family="'Courier New',Courier,monospace" font-size="10px" font-weight="bold" letter-spacing="2px" color="#5f97a8" padding="0 0 12px 0">АЭРОПОРТЫ ОТПРАВЛЕНИЯ</mj-text>
        <mj-table padding="0">
          <tr>
            <td class="gate-td" width="48%" valign="top" style="padding:0 8px 0 0;">
