<mjml lang="ru">
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Savencia Swiss Specimen</mj-title>
    <mj-preview>10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="15px" line-height="1.65" color="#47636d" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      /* Hallmark · built: Savencia · redesign: polish · genre: editorial */
      :root {
        --color-petrol-deep: #00232f;
        --color-orange: #de6a09;
        --color-sky: #38bdf8;
        --color-teal-dark: #002a37;
        --color-slate-text: #47636d;
        --color-bg-paper: #e6eef0;
      }
      @media only screen and (max-width:480px){
        .px { padding-left: 20px !important; padding-right: 20px !important; }
        .h1 div { font-size: 32px !important; line-height: 1.05 !important; }
        .row-td { display: block !important; width: 100% !important; }
        .row-time { padding: 16px 0 0 0 !important; }
        .row-body { padding: 8px 0 16px 0 !important; }
        .gate-td { display: block !important; width: 100% !important; padding: 0 0 12px 0 !important; }
        .city { font-size: 11px !important; letter-spacing: 1.5px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#e6eef0">

    <!-- ОРАНЖЕВАЯ АКЦЕНТНАЯ ЛИНИЯ -->
    <mj-section background-color="#de6a09" padding="0">
      <mj-column><mj-text padding="0" font-size="1px" line-height="4px">&nbsp;</mj-text></mj-column>
    </mj-section>

    <!-- ШАПКА: ЛОГОТИП -->
    <mj-section background-color="#ffffff" padding="24px 32px 20px 32px" css-class="px">
      <mj-column>
        <mj-image src="logo_color.png" width="160px" align="left" alt="GROUPE SAVENCIA" />
      </mj-column>
    </mj-section>

    <!-- ГЕРОЙ: ЧИСТАЯ ШВЕЙЦАРСКАЯ ТИПОГРАФИКА (SWISS POSTER SPECIMEN) -->
    <mj-section background-color="#00232f" padding="36px 32px 28px 32px" css-class="px">
      <mj-column>
        <!-- Мета-строка -->
        <mj-text font-family="'Courier New', Courier, monospace" font-size="11px" font-weight="bold"
                 letter-spacing="2.5px" color="#de6a09" line-height="1" padding="0 0 16px 0">
          FLIGHT SV-2027 &nbsp;|&nbsp; DISPATCH: 10 ДЕКАБРЯ
        </mj-text>
        
        <!-- Монументальный швейцарский заголовок -->
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="44px" font-weight="900" line-height="0.98" letter-spacing="-1px"
                 color="#ffffff" padding="0 0 14px 0" css-class="h1">
          ВЫЛЕТ В<br /><span style="color:#de6a09;">НОВЫЙ ГОД</span>
        </mj-text>
        
        <!-- Подзаголовок-манифест -->
        <mj-text font-family="'Courier New', Courier, monospace" font-size="12px" font-weight="bold" letter-spacing="2px" line-height="1.6"
                 color="#38bdf8" padding="0 0 24px 0">
          ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
        </mj-text>

        <!-- Типографическая сетка параметров полета -->
        <mj-table padding="0">
          <tr>
            <td>
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top: 1px solid #1a3c4a; border-bottom: 1px solid #1a3c4a; margin-top: 4px;">
                <tr>
                  <td width="33%" align="left" style="padding: 14px 8px 14px 0; border-right: 1px solid #1a3c4a;">
                    <div style="font-family:'Courier New', monospace; font-size:9px; color:#688995; letter-spacing:1px; text-transform:uppercase;">01 // МАРШРУТ</div>
                    <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:900; color:#ffffff; margin-top:3px;">MOW · UFA · BEL</div>
                    <div style="font-family:'Courier New', monospace; font-size:10px; color:#1bbbe9; margin-top:2px;">DIRECT FLIGHT</div>
                  </td>
                  <td width="34%" align="left" style="padding: 14px 8px 14px 14px; border-right: 1px solid #1a3c4a;">
                    <div style="font-family:'Courier New', monospace; font-size:9px; color:#688995; letter-spacing:1px; text-transform:uppercase;">02 // ВЫЛЕТ</div>
                    <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:900; color:#de6a09; margin-top:3px;">10.12.2026</div>
                    <div style="font-family:'Courier New', monospace; font-size:10px; color:#cbd5e1; margin-top:2px;">ПО РАСПИСАНИЮ</div>
                  </td>
                  <td width="33%" align="left" style="padding: 14px 0 14px 14px;">
                    <div style="font-family:'Courier New', monospace; font-size:9px; color:#688995; letter-spacing:1px; text-transform:uppercase;">03 // ПАССАЖИРЫ</div>
                    <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:900; color:#ffffff; margin-top:3px;">SAVENCIA</div>
                    <div style="font-family:'Courier New', monospace; font-size:10px; color:#10b981; margin-top:2px;">BOARDING CALL</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- МАРШРУТ ГОРОДОВ -->
    <mj-section background-color="#eef4f6" padding="0 20px" border-top="1px solid #dbe7ea">
      <mj-column>
        <mj-table padding="0">
          <tr>
            <td width="30%" align="center" valign="middle" style="padding:18px 0;">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1;color:#de6a09;font-weight:bold;">✈</div>
              <div class="city" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;letter-spacing:2px;color:#004b62;padding-top:8px;">МОСКВА</div>
            </td>
            <td width="5%" valign="middle" style="padding:0 6px;"><div style="border-top:1px dashed #a7c1ca;font-size:0;line-height:0;">&nbsp;</div></td>
            <td width="30%" align="center" valign="middle" style="padding:18px 0;">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1;color:#de6a09;font-weight:bold;">✈</div>
              <div class="city" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;letter-spacing:2px;color:#004b62;padding-top:8px;">УФА</div>
            </td>
            <td width="5%" valign="middle" style="padding:0 6px;"><div style="border-top:1px dashed #a7c1ca;font-size:0;line-height:0;">&nbsp;</div></td>
            <td width="30%" align="center" valign="middle" style="padding:18px 0;">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1;color:#de6a09;font-weight:bold;">✈</div>
              <div class="city" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;letter-spacing:2px;color:#004b62;padding-top:8px;">БЕЛЕБЕЙ</div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- ВВОДНЫЙ ТЕКСТ / МАНИФЕСТ -->
    <mj-section background-color="#ffffff" padding="32px 32px 24px 32px" css-class="px">
      <mj-column>
        <mj-text font-size="20px" font-weight="900" color="#00303f" padding="0 0 14px 0">Дорогие коллеги!</mj-text>
        <mj-text font-size="15px" color="#2b4751" padding="0 0 14px 0">Внимание, объявляется посадка на особый новогодний рейс!</mj-text>
        <mj-text font-size="15px" color="#47636d" padding="0 0 14px 0">10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-text>
        <mj-text font-size="15px" color="#47636d" padding="0 0 14px 0">В этот день наши праздничные площадки превратятся в настоящие аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — Новый год!</mj-text>
        <mj-text font-size="15px" color="#47636d" padding="0">В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.</mj-text>
      </mj-column>
    </mj-section>

    <!-- СЕКЦИЯ 1: РАСПИСАНИЕ МОСКВА И УФА -->
    <mj-section background-color="#00232f" padding="24px 32px 14px 32px" css-class="px">
      <mj-column>
        <mj-text font-family="'Courier New',Courier,monospace" font-size="11px" font-weight="bold" letter-spacing="2.5px" color="#de6a09" padding="0 0 4px 0">РАСПИСАНИЕ РЕЙСА</mj-text>
        <mj-text font-family="Arial,Helvetica,sans-serif" font-size="22px" font-weight="900" color="#ffffff" padding="0">МОСКВА И УФА</mj-text>
        <mj-text font-family="'Courier New',Courier,monospace" font-size="11px" color="#5f97a8" padding="4px 0 0 0">ПО МЕСТНОМУ ВРЕМЕНИ</mj-text>
      </mj-column>
    </mj-section>

    <!-- ЭТАПЫ МОСКВА И УФА -->
    <mj-section background-color="#002a37" padding="0 32px" css-class="px">
      <mj-column>
        <mj-table padding="0">
          <tr>
            <td class="row-td row-time" width="128" valign="top" style="width:128px;padding:16px 12px 0 0;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                <td style="background-color:#001b24;border:1px solid #10404f;border-radius:4px;padding:6px 10px;font-family:'Courier New',Courier,monospace;font-size:13px;font-weight:bold;color:#ffffff;white-space:nowrap;">17:00–18:00</td>
              </tr></table>
            </td>
            <td class="row-td row-body" valign="top" style="padding:15px 0 16px 0;">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#8fd8ee;line-height:1.35;">Регистрация на рейс (Welcome)</div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#a9c4ce;padding-top:4px;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

