      <mj-column>
        <mj-text font-family="'Courier New',Courier,monospace" font-size="11px" font-weight="bold" letter-spacing="2.5px" color="#de6a09" padding="0 0 4px 0">РАСПИСАНИЕ РЕЙСА</mj-text>
        <mj-text font-family="Arial,Helvetica,sans-serif" font-size="22px" font-weight="900" color="#ffffff" padding="0">БЕЛЕБЕЙ</mj-text>
        <mj-text font-family="'Courier New',Courier,monospace" font-size="11px" color="#5f97a8" padding="4px 0 0 0">ПО МЕСТНОМУ ВРЕМЕНИ</mj-text>
      </mj-column>
    </mj-section>

    <!-- ЭТАПЫ БЕЛЕБЕЙ -->
    <mj-section background-color="#002a37" padding="0 32px" css-class="px">
      <mj-column>
        <mj-table padding="0">
          <tr>
            <td class="row-td row-time" width="128" valign="top" style="width:128px;padding:16px 12px 0 0;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                <td style="background-color:#001b24;border:1px solid #10404f;border-radius:4px;padding:6px 10px;font-family:'Courier New',Courier,monospace;font-size:13px;font-weight:bold;color:#ffffff;white-space:nowrap;">15:00–15:30</td>
              </tr></table>
            </td>
            <td class="row-td row-body" valign="top" style="padding:15px 0 16px 0;">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#8fd8ee;line-height:1.35;">Регистрация на рейс (Welcome)</div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#a9c4ce;padding-top:4px;">Встреча пассажиров, посадочные билеты, фотозона, угощения.</div>
            </td>
