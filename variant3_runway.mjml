      <mj-column>
        <mj-text font-family="'Courier New',Courier,monospace" font-size="10px" font-weight="bold" letter-spacing="2px" color="#5f97a8" padding="0 0 10px 0">АЭРОПОРТ ОТПРАВЛЕНИЯ</mj-text>
        <mj-table padding="0">
