    <!-- ФИНАЛ: ЧИСТОЕ ПРИГЛАШЕНИЕ -->
    <mj-section background-color="#ffffff" padding="32px 32px 28px 32px" border-radius="0 0 16px 16px" css-class="px">
      <mj-column>
        <mj-text font-size="19px" font-weight="bold" color="#00303f" padding="0 0 12px 0">Уважаемые пассажиры!</mj-text>
        <mj-text padding="0 0 10px 0">Просим заранее подготовить хорошее настроение и быть готовыми к незабываемому путешествию.</mj-text>
        <mj-text padding="0 0 20px 0">Наш новогодний рейс уже готовится к вылету. На борту ждём каждого!</mj-text>
        <mj-text font-size="28px" font-weight="900" line-height="1.15" letter-spacing="-0.5px" color="#de6a09" padding="0 0 10px 0">До встречи 10 декабря!</mj-text>
        <mj-text font-size="14px" font-weight="bold" letter-spacing="1px" color="#004b62" padding="0">Ваш экипаж Savencia ✈</mj-text>
      </mj-column>
    </mj-section>

    <!-- ДЕЛИКАТНЫЙ ПОДВАЛ -->
