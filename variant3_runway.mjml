<mjml>
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД!</mj-title>
    <mj-preview>10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="15px" line-height="1.65" color="#47636d" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width:480px){
        .px{padding-left:20px!important;padding-right:20px!important;}
        .h1{font-size:31px!important;line-height:1.05!important;}
        .row-td{display:block!important;width:100%!important;}
        .row-time{padding:16px 0 0 0!important;}
        .row-body{padding:7px 0 16px 0!important;}
        .gate-td{display:block!important;width:100%!important;padding:0 0 10px 0!important;}
        .city{font-size:11px!important;letter-spacing:1.4px!important;}
      }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#e6eef0">

    <!-- ОРАНЖЕВАЯ ЛЕНТА -->
    <mj-section background-color="#de6a09" padding="0">
      <mj-column><mj-text padding="0" font-size="1px" line-height="3px">&nbsp;</mj-text></mj-column>
    </mj-section>

    <!-- ЛОГО -->
    <mj-section background-color="#ffffff" padding="22px 32px 18px 32px" css-class="px">
      <mj-column>
        <mj-image src="logo_color.png" width="160px" align="left" alt="GROUPE SAVENCIA" />
      </mj-column>
    </mj-section>

    <!-- ГЕРОЙ: ЧИСТАЯ ШВЕЙЦАРСКАЯ ТИПОГРАФИКА (SWISS POSTER SPECIMEN) -->
    <mj-section background-color="#00232f" padding="36px 32px 28px 32px" css-class="px">
      <mj-column>
        <!-- Мета-строка в стиле Crato Mono / Swiss Specimen -->
        <mj-text font-family="'Courier New', Courier, monospace" font-size="11px" font-weight="bold"
                 letter-spacing="2.5px" color="#de6a09" line-height="1" padding="0 0 16px 0">
          // REQ: 2026-NY &nbsp;·&nbsp; FLIGHT: SV-2026 &nbsp;·&nbsp; 10 ДЕКАБРЯ
        </mj-text>
        
        <!-- Монументальный швейцарский заголовок -->
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="44px" font-weight="900" line-height="0.98" letter-spacing="-1px"
                 color="#ffffff" padding="0 0 14px 0" css-class="h1">
          ВЫЛЕТ В<br /><span style="color:#de6a09;">НОВЫЙ ГОД</span>
        </mj-text>
        
        <!-- Подзаголовок-манифест -->
        <mj-text font-family="'Courier New', Courier, monospace" font-size="12px" font-weight="bold" letter-spacing="2.5px" line-height="1.6"
                 color="#38bdf8" padding="0 0 24px 0">
          ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
        </mj-text>

        <!-- Типографическая сетка параметров полета (Чистая графика, без клипарта) -->
        <mj-raw>
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top: 1px solid #1a3c4a; border-bottom: 1px solid #1a3c4a; margin-top: 4px;">
            <tr>
              <td width="33%" align="left" style="padding: 14px 8px 14px 0; border-right: 1px solid #1a3c4a;">
                <div style="font-family:'Courier New', monospace; font-size:9px; color:#688995; letter-spacing:1px; text-transform:uppercase;">01 // МАРШРУТ</div>
                <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:900; color:#ffffff; margin-top:3px;">MOW · UFA · BEL</div>
                <div style="font-family:'Courier New', monospace; font-size:10px; color:#1bbbe9; margin-top:2px;">DIRECT FLIGHT</div>
              </td>
              <td width="34%" align="left" style="padding: 14px 8px 14px 14px; border-right: 1px solid #1a3c4a;">
                <div style="font-family:'Courier New', monospace; font-size:9px; color:#688995; letter-spacing:1px; text-transform:uppercase;">02 // ВЫЛЕТ</div>
                <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:900; color:#de6a09; margin-top:3px;">10.12.2026</div>
                <div style="font-family:'Courier New', monospace; font-size:10px; color:#cbd5e1; margin-top:2px;">ПО РАСПИСАНИЮ</div>
              </td>
              <td width="33%" align="left" style="padding: 14px 0 14px 14px;">
                <div style="font-family:'Courier New', monospace; font-size:9px; color:#688995; letter-spacing:1px; text-transform:uppercase;">03 // ПАССАЖИРЫ</div>
                <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:900; color:#ffffff; margin-top:3px;">SAVENCIA</div>
                <div style="font-family:'Courier New', monospace; font-size:10px; color:#10b981; margin-top:2px;">● BOARDING CALL</div>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- МАРШРУТ -->
    <mj-section background-color="#eef4f6" padding="0 20px" border-top="1px solid #dbe7ea">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="30%" align="center" valign="middle" style="padding:18px 0;">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1;color:#de6a09;">&#x2708;&#xFE0E;</div>
                <div class="city" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;letter-spacing:2.2px;color:#004b62;padding-top:8px;">МОСКВА</div>
              </td>
              <td width="5%" valign="middle" style="padding:0 6px;"><div style="border-top:1px dashed #a7c1ca;font-size:0;line-height:0;">&nbsp;</div></td>
              <td width="30%" align="center" valign="middle" style="padding:18px 0;">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1;color:#de6a09;">&#x2708;&#xFE0E;</div>
                <div class="city" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;letter-spacing:2.2px;color:#004b62;padding-top:8px;">УФА</div>
              </td>
              <td width="5%" valign="middle" style="padding:0 6px;"><div style="border-top:1px dashed #a7c1ca;font-size:0;line-height:0;">&nbsp;</div></td>
              <td width="30%" align="center" valign="middle" style="padding:18px 0;">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1;color:#de6a09;">&#x2708;&#xFE0E;</div>
                <div class="city" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;letter-spacing:2.2px;color:#004b62;padding-top:8px;">БЕЛЕБЕЙ</div>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- ПРИВЕТСТВИЕ -->
    <mj-section background-color="#ffffff" padding="30px 32px 6px 32px" css-class="px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#00303f" padding="0 0 16px 0">Дорогие коллеги!</mj-text>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f7f9;border-left:3px solid #de6a09;">
            <tr><td style="padding:14px 16px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;line-height:1.45;color:#0b4353;">Внимание, объявляется посадка на особый новогодний рейс!</td></tr>
          </table>
        </mj-raw>
        <mj-text padding="18px 0 13px 0">10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-text>
        <mj-text padding="0 0 13px 0">В этот день наши праздничные площадки превратятся в аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — Новый год!</mj-text>
        <mj-text padding="0">В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.</mj-text>
      </mj-column>
    </mj-section>

    <!-- ПОСАДОЧНЫЙ ТАЛОН -->
    <mj-section background-color="#ffffff" padding="22px 32px 6px 32px" css-class="px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #d5e4e9;border-radius:10px;background-color:#ffffff;">
            <tr>
              <td valign="middle" style="padding:20px 18px 20px 22px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#20424d;">
                На регистрации каждый получит свой посадочный билет, который пригодится во время новогоднего розыгрыша подарков.
              </td>
              <td width="132" align="center" valign="middle" bgcolor="#de6a09" style="width:132px;padding:16px 12px;border-left:2px dashed #ffffff;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center"><tr>
                  <td width="3" height="34" bgcolor="#ffffff" style="width:3px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="2" style="width:2px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="2" height="34" bgcolor="#ffffff" style="width:2px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="3" style="width:3px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="4" height="34" bgcolor="#ffffff" style="width:4px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="2" style="width:2px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="2" height="34" bgcolor="#ffffff" style="width:2px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="3" style="width:3px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="3" height="34" bgcolor="#ffffff" style="width:3px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="2" style="width:2px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="2" height="34" bgcolor="#ffffff" style="width:2px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="3" style="width:3px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="4" height="34" bgcolor="#ffffff" style="width:4px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="2" style="width:2px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="2" height="34" bgcolor="#ffffff" style="width:2px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="3" style="width:3px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="3" height="34" bgcolor="#ffffff" style="width:3px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="2" style="width:2px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="2" height="34" bgcolor="#ffffff" style="width:2px;height:34px;font-size:0;line-height:0;">&nbsp;</td><td width="3" style="width:3px;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="4" height="34" bgcolor="#ffffff" style="width:4px;height:34px;font-size:0;line-height:0;">&nbsp;</td>
                </tr></table>
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1;color:#ffffff;padding-top:10px;">&#x2708;&#xFE0E;</div>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- ТАБЛО: ШАПКА -->
    <mj-section background-color="#00303f" padding="26px 32px 0 32px" css-class="px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="font-family:Arial,Helvetica,sans-serif;font-size:19px;font-weight:bold;letter-spacing:1.2px;line-height:1.25;color:#ffffff;">РАСПИСАНИЕ НАШЕГО РЕЙСА</td>
              <td width="34" align="right" valign="middle" style="width:34px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="right"><tr>
                  <td width="30" height="30" align="center" valign="middle" style="width:30px;height:30px;border:1px solid #de6a09;border-radius:4px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1;color:#de6a09;">&#x2708;&#xFE0E;</td>
                </tr></table>
              </td>
            </tr>
            <tr><td colspan="2" style="padding:16px 0 0 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                <td width="72" height="3" bgcolor="#de6a09" style="width:72px;height:3px;font-size:0;line-height:0;">&nbsp;</td>
                <td height="3" bgcolor="#1f5c6e" style="height:3px;font-size:0;line-height:0;">&nbsp;</td>
              </tr></table>
            </td></tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- МОСКВА и УФА -->
    <mj-section background-color="#00303f" padding="22px 32px 0 32px" css-class="px">
      <mj-column>
        <mj-raw>
          <div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;letter-spacing:1.6px;line-height:1.3;color:#ffffff;"><span style="color:#de6a09;">&#x2708;&#xFE0E;</span> МОСКВА и УФА</div>
          <div style="font-family:'Courier New',Courier,monospace;font-size:10px;font-weight:bold;letter-spacing:1.8px;color:#5f97a8;padding-top:7px;">(ПО МЕСТНОМУ ВРЕМЕНИ)</div>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- СТРОКИ МОСКВА / УФА -->
    <mj-section background-color="#00303f" padding="14px 32px 0 32px" css-class="px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #10404f;">
            <tr>
              <td class="row-td row-time" width="128" valign="top" style="width:128px;padding:16px 12px 0 0;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                  <td style="background-color:#001b24;border:1px solid #10404f;border-radius:4px;padding:7px 7px;font-family:'Courier New',Courier,monospace;font-size:14px;font-weight:bold;color:#ffffff;white-space:nowrap;">17:00–18:00</td>
                </tr></table>
              </td>
              <td class="row-td row-body" valign="top" style="padding:15px 0 16px 0;">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#8fd8ee;line-height:1.35;">Регистрация на рейс (Welcome)</div>
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#a9c4ce;padding-top:4px;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section background-color="#002a37" padding="0 32px" css-class="px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td class="row-td row-time" width="128" valign="top" style="width:128px;padding:16px 12px 0 0;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                  <td style="background-color:#001b24;border:1px solid #10404f;border-radius:4px;padding:7px 7px;font-family:'Courier New',Courier,monospace;font-size:14px;font-weight:bold;color:#ffffff;white-space:nowrap;">18:00–20:00</td>
                </tr></table>
              </td>
              <td class="row-td row-body" valign="top" style="padding:15px 0 16px 0;">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#8fd8ee;line-height:1.35;">Взлёт. Торжественная часть</div>
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#a9c4ce;padding-top:4px;">Церемония награждения сотрудников и праздничная программа.</div>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section background-color="#00303f" padding="0 32px" css-class="px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td class="row-td row-time" width="128" valign="top" style="width:128px;padding:16px 12px 0 0;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                  <td style="background-color:#001b24;border:1px solid #10404f;border-radius:4px;padding:7px 7px;font-family:'Courier New',Courier,monospace;font-size:14px;font-weight:bold;color:#ffffff;white-space:nowrap;">20:00–23:00</td>
                </tr></table>
              </td>
              <td class="row-td row-body" valign="top" style="padding:15px 0 16px 0;">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#8fd8ee;line-height:1.35;">Полёт в Новый год</div>
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#a9c4ce;padding-top:4px;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
