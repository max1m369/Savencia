            <td class="row-td row-time" width="128" valign="top" style="width:128px;padding:16px 12px 0 0;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                <td style="background-color:#001b24;border:1px solid #10404f;border-radius:4px;padding:6px 10px;font-family:'Courier New',Courier,monospace;font-size:13px;font-weight:bold;color:#ffffff;white-space:nowrap;">15:30–18:00</td>
              </tr></table>
            </td>
            <td class="row-td row-body" valign="top" style="padding:15px 0 16px 0;">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#8fd8ee;line-height:1.35;">Взлёт. Торжественная часть</div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#a9c4ce;padding-top:4px;">Церемония награждения сотрудников и праздничная программа.</div>
            </td>
