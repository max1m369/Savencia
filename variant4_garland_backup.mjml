<mjml>
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Savencia Première Classe</mj-title>
    <mj-preview>10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников Savencia из трёх городов — Москвы, Уфы и Белебея.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#334155" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      .mono {
        font-family: "Courier New", Courier, monospace, sans-serif !important;
      }
      .lounge-card {
        background-color: #ffffff;
        border: 1px solid #e2d9cf;
        border-radius: 10px;
        padding: 16px 18px;
        margin-bottom: 12px;
        box-shadow: 0 4px 14px rgba(0, 35, 47, 0.04);
      }
      .time-pill {
        display: inline-block;
        background-color: #de6a09;
        color: #ffffff;
        font-family: "Courier New", Courier, monospace, sans-serif;
        font-size: 12px;
        font-weight: bold;
        padding: 5px 9px;
        border-radius: 4px;
        white-space: nowrap;
      }
      .chevron-bar {
        background: repeating-linear-gradient(
          -45deg,
          #de6a09,
          #de6a09 14px,
          #ffffff 14px,
          #ffffff 22px,
          #004b62 22px,
          #004b62 36px,
          #ffffff 36px,
          #ffffff 44px
        );
        height: 8px;
        font-size: 0;
        line-height: 0;
      }
      @media only screen and (max-width: 480px) {
        .px { padding-left: 16px !important; padding-right: 16px !important; }
        .h1-title { font-size: 28px !important; line-height: 1.05 !important; }
        .row-stack { display: block !important; width: 100% !important; }
        .time-col { width: 100% !important; padding-bottom: 6px !important; }
        .city-cell { display: block !important; width: 100% !important; padding: 8px 0 !important; border-bottom: 1px solid #143542 !important; }
        .city-cell.last { border-bottom: none !important; }
        .arrow-cell { display: none !important; }
        .coupon-td { display: block !important; width: 100% !important; text-align: center !important; }
        .coupon-barcode { margin-top: 12px !important; text-align: center !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#f6f3ee">

    <!-- 1. ИКОНИЧЕСКАЯ ФРАНЦУЗСКАЯ ЛЕНТА AÉROPOSTALE (ORANGE / NAVY / WHITE) -->
    <mj-section padding="0">
      <mj-column width="100%">
        <mj-text padding="0">
          <div class="chevron-bar">&nbsp;</div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 2. СВЕТЛАЯ ШАПКА: ЛОГОТИП И СТАТУС ПЕРВОГО КЛАССА -->
    <mj-section background-color="#ffffff" padding="20px 28px 18px 28px" border-bottom="1px solid #e7ded4" css-class="px">
      <mj-column width="55%" vertical-align="middle">
        <mj-image src="logo_color.png" width="165px" align="left" alt="GROUPE SAVENCIA" />
      </mj-column>
      <mj-column width="45%" vertical-align="middle">
        <mj-text align="right" font-family="'Courier New', Courier, monospace" font-size="11px" font-weight="bold" color="#64748b" letter-spacing="1px">
          SERVICE DE PREMIÈRE CLASSE<br />
          <span style="color:#004b62; font-weight:900;">VOL SPECIAL SV-2026</span> &nbsp;|&nbsp; <span style="color:#de6a09; font-weight:900;">10.12.2026</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 3. ГЕРОЙ: ФОЛИО ПЕРВОГО КЛАССА (SAVENCIA PREMIÈRE CLASSE FOLIO) -->
    <mj-section background-color="#f6f3ee" padding="24px 20px 0 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#00232f; border: 2px solid #de6a09; border-radius:12px; box-shadow:0 16px 38px rgba(0, 35, 47, 0.22); overflow:hidden;">
            <!-- Верхняя плашка фолио с медальоном -->
            <tr>
              <td style="background-color:#001a24; padding:14px 22px; border-bottom:1px solid #143542;">
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="left" valign="middle">
                      <span style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; letter-spacing:2px; color:#f4b860;">
                        ★ GROUPE SAVENCIA // EXPÉDITION 2026
                      </span>
                    </td>
                    <td align="right" valign="middle">
                      <span style="background-color:#0f2a36; border:1px solid #38bdf8; color:#38bdf8; font-family:'Courier New', monospace; font-size:10px; font-weight:bold; padding:4px 9px; border-radius:3px; letter-spacing:1px;">
                        ● BOARDING CONFIRMED
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Центральный типографический блок и герб -->
            <tr>
              <td style="padding:32px 26px 26px 26px; text-align:center;">
                <!-- Праздничные гирлянды и золотой медальон со взлетающим самолётом -->
                <div style="margin:0 auto 18px auto; text-align:center; max-width:540px;">
                  <img src="hero_v4_garland.png" width="540" height="84" alt="Savencia Flight Medallion &amp; Garland" style="display:block; width:100%; max-width:540px; height:auto; margin:0 auto; border:0;" />
                </div>

                <div style="font-family:'Courier New', monospace; font-size:11px; font-weight:bold; letter-spacing:3px; color:#de6a09; text-transform:uppercase; margin-bottom:8px;">
                  // ПРИГЛАШЕНИЕ НА ПРАЗДНИЧНЫЙ РЕЙС
                </div>

                <div class="h1-title" style="font-family:Arial, Helvetica, sans-serif; font-size:38px; font-weight:900; color:#ffffff; line-height:1.05; letter-spacing:-0.5px; margin-bottom:12px;">
                  ВЫЛЕТ В<br /><span style="color:#f4b860;">НОВЫЙ ГОД</span>
                </div>

                <div style="font-family:'Courier New', monospace; font-size:12px; font-weight:bold; letter-spacing:2.5px; color:#38bdf8; margin-bottom:24px;">
                  ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
                </div>

                <!-- Созвездие трёх городов: Москва - Уфа - Белебей -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#081b24; border:1px solid #143542; border-radius:8px; padding:12px 14px;">
                  <tr>
                    <td class="city-cell" width="28%" align="center" valign="middle">
                      <div style="font-family:'Courier New', monospace; font-size:9px; color:#94a3b8; letter-spacing:1px;">ТЕРМИНАЛ 01</div>
                      <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:900; color:#ffffff; margin-top:2px;">МОСКВА</div>
                      <div style="font-family:'Courier New', monospace; font-size:10px; color:#de6a09; font-weight:bold; margin-top:2px;">17:00</div>
                    </td>
                    <td class="arrow-cell" width="8%" align="center" valign="middle" style="color:#f4b860; font-size:14px;">
                      &#x2794;
                    </td>
                    <td class="city-cell" width="28%" align="center" valign="middle">
                      <div style="font-family:'Courier New', monospace; font-size:9px; color:#94a3b8; letter-spacing:1px;">ТЕРМИНАЛ 02</div>
                      <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:900; color:#ffffff; margin-top:2px;">УФА</div>
                      <div style="font-family:'Courier New', monospace; font-size:10px; color:#de6a09; font-weight:bold; margin-top:2px;">17:00</div>
                    </td>
                    <td class="arrow-cell" width="8%" align="center" valign="middle" style="color:#f4b860; font-size:14px;">
                      &#x2794;
                    </td>
                    <td class="city-cell last" width="28%" align="center" valign="middle">
                      <div style="font-family:'Courier New', monospace; font-size:9px; color:#94a3b8; letter-spacing:1px;">ТЕРМИНАЛ 03</div>
                      <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:900; color:#ffffff; margin-top:2px;">БЕЛЕБЕЙ</div>
                      <div style="font-family:'Courier New', monospace; font-size:10px; color:#de6a09; font-weight:bold; margin-top:2px;">15:00</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Нижняя контрольная строка фолио -->
            <tr>
              <td style="background-color:#001a24; padding:10px 22px; border-top:1px solid #143542; font-family:'Courier New', monospace; font-size:10px; color:#64748b;">
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="left">AIRFRAME: ALL-TEAM VOYAGE</td>
                    <td align="right" style="color:#f4b860;">DESTINATION: NEW YEAR 2026</td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 4. СВЕТЛОЕ ОБРАЩЕНИЕ К ЭКИПАЖУ (COMMUNIQUÉ OFFICIEL) -->
    <mj-section background-color="#f6f3ee" padding="24px 20px 0 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff; border:1px solid #e7ded4; border-radius:12px; box-shadow:0 8px 24px rgba(0, 35, 47, 0.05); overflow:hidden;">
            <tr>
              <td style="padding:28px 24px;">
                <div style="font-family:Arial, Helvetica, sans-serif; font-size:22px; font-weight:900; color:#004b62; margin-bottom:16px; line-height:1.25; text-align:center;">
                  Внимание, объявляется посадка на особый новогодний рейс!
                </div>

                <div style="font-size:14.5px; line-height:1.65; color:#334155;">
                  <p style="margin:0 0 12px 0; font-size:16px;"><strong>Дорогие коллеги!</strong></p>
                  <p style="margin:0 0 12px 0;">
                    10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников <strong>Savencia</strong> из трёх городов — Москвы, Уфы и Белебея.
                  </p>
                  <p style="margin:0 0 12px 0;">
                    В этот день наши праздничные площадки превратятся в аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — <span style="color:#008fd0; font-weight:bold;">Новый год!</span>
                  </p>
                  <p style="margin:0 0 14px 0;">
                    В программе полёта: тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.
                  </p>

                  <!-- Памятка о посадочном билете -->
                  <div style="background-color:#fff9f2; border:1px dashed #de6a09; border-left:4px solid #de6a09; padding:12px 14px; border-radius:4px; font-size:13px; color:#1e293b;">
                    🎫 <strong>Посадочный билет:</strong> <em>На регистрации каждый получит свой посадочный билет, который пригодится во время новогоднего розыгрыша подарков.</em>
                  </div>
                </div>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 5. ТРИ ЗАЛА ВЫЛЕТА С ТОЧНЫМИ АДРЕСАМИ (3 TERMINAL LOUNGES) -->
    <mj-section background-color="#f6f3ee" padding="24px 20px 0 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0 0 12px 0" font-family="'Courier New', monospace" font-size="11px" font-weight="bold" color="#64748b" letter-spacing="2px">
          // 3 АЭРОПОРТА ОТПРАВЛЕНИЯ &amp; ЗАЛЫ ВЫЛЕТА
        </mj-text>
        <mj-text padding="0">
          
          <!-- Зал 1: Москва -->
          <div class="lounge-card" style="border-left:4px solid #004b62;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="left" valign="top">
                  <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#004b62; letter-spacing:1.5px;">
                    ТЕРМИНАЛ 01 // МОСКВА
                  </div>
                  <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:bold; color:#0f172a; margin-top:2px;">
                    Южный Event-Port
                  </div>
                  <div style="font-size:13px; color:#475569; margin-top:4px; line-height:1.4;">
                    проспект Андропова, 11, корпус 2.
                  </div>
                </td>
                <td width="110" align="right" valign="top">
                  <span style="display:inline-block; background-color:#f1f5f9; border:1px solid #cbd5e1; color:#004b62; font-family:'Courier New', monospace; font-size:11px; font-weight:bold; padding:4px 8px; border-radius:4px;">
                    GATE MOW-01
                  </span>
                  <div style="font-size:10px; color:#10b981; font-weight:bold; margin-top:4px;">
                    ● ПО РАСПИСАНИЮ
                  </div>
                </td>
              </tr>
            </table>
          </div>

          <!-- Зал 2: Уфа -->
          <div class="lounge-card" style="border-left:4px solid #008fd0;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="left" valign="top">
                  <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#008fd0; letter-spacing:1.5px;">
                    ТЕРМИНАЛ 02 // УФА
                  </div>
                  <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:bold; color:#0f172a; margin-top:2px;">
                    Ресторан «Пастернак»
                  </div>
                  <div style="font-size:13px; color:#475569; margin-top:4px; line-height:1.4;">
                    улица Менделеева, 205А.
                  </div>
                </td>
                <td width="110" align="right" valign="top">
                  <span style="display:inline-block; background-color:#f1f5f9; border:1px solid #cbd5e1; color:#008fd0; font-family:'Courier New', monospace; font-size:11px; font-weight:bold; padding:4px 8px; border-radius:4px;">
                    GATE UFA-02
                  </span>
                  <div style="font-size:10px; color:#10b981; font-weight:bold; margin-top:4px;">
                    ● ПО РАСПИСАНИЮ
                  </div>
                </td>
              </tr>
            </table>
          </div>

          <!-- Зал 3: Белебей -->
          <div class="lounge-card" style="border-left:4px solid #de6a09;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="left" valign="top">
                  <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; color:#de6a09; letter-spacing:1.5px;">
                    ТЕРМИНАЛ 03 // БЕЛЕБЕЙ
                  </div>
                  <div style="font-family:Arial, sans-serif; font-size:15px; font-weight:bold; color:#0f172a; margin-top:2px;">
                    Центральный дворец культуры
                  </div>
                  <div style="font-size:13px; color:#475569; margin-top:4px; line-height:1.4;">
                    улица Амирова, 10А (Белебеевский район).
                  </div>
                </td>
                <td width="110" align="right" valign="top">
                  <span style="display:inline-block; background-color:#f1f5f9; border:1px solid #cbd5e1; color:#de6a09; font-family:'Courier New', monospace; font-size:11px; font-weight:bold; padding:4px 8px; border-radius:4px;">
                    GATE BEL-03
                  </span>
                  <div style="font-size:10px; color:#10b981; font-weight:bold; margin-top:4px;">
                    ● ПО РАСПИСАНИЮ
                  </div>
                </td>
              </tr>
            </table>
          </div>

        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 6. РАСПИСАНИЕ ПОЛЁТА: БОРТОВОЙ ХРОНОМЕТРАЖ (IN-FLIGHT PROGRAM) -->
    <mj-section background-color="#f6f3ee" padding="20px 20px 0 20px" css-class="px">
      <mj-column width="100%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#00232f; border:1px solid #143542; border-radius:12px; box-shadow:0 12px 32px rgba(0, 35, 47, 0.22); overflow:hidden;">
            <tr>
              <td style="padding:24px 22px;">
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:18px; padding-bottom:12px; border-bottom:1px solid #143542;">
                  <tr>
                    <td align="left" valign="middle">
                      <div style="font-family:'Courier New', monospace; font-size:10px; font-weight:bold; letter-spacing:2px; color:#de6a09;">
                        // CHRONOLOGIE DU VOL
                      </div>
                      <div style="font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:900; letter-spacing:1px; color:#ffffff; margin-top:2px;">
                        РАСПИСАНИЕ НАШЕГО РЕЙСА
                      </div>
                    </td>
                    <td width="36" align="right" valign="middle">
                      <div style="width:30px; height:30px; border:1px solid #f4b860; border-radius:50%; text-align:center; line-height:28px; color:#f4b860; font-size:14px;">
                        &#x2708;&#xFE0E;
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- БЛОК: МОСКВА И УФА -->
                <div style="margin-bottom:22px;">
                  <div style="font-family:Arial, sans-serif; font-size:13px; font-weight:900; color:#38bdf8; letter-spacing:1px; margin-bottom:10px;">
                    &#x2708;&#xFE0E; МОСКВА И УФА <span style="font-family:'Courier New', monospace; font-size:10px; color:#94a3b8; font-weight:normal;">(ПО МЕСТНОМУ ВРЕМЕНИ)</span>
                  </div>

                  <!-- Этап 1 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                    <tr>
                      <td class="row-stack time-col" width="125" valign="top">
                        <span class="time-pill">17:00–18:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Регистрация на рейс (Welcome)</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 2 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                    <tr>
                      <td class="row-stack time-col" width="125" valign="top">
                        <span class="time-pill">18:00–20:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Взлёт. Торжественная часть</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Церемония награждения сотрудников и праздничная программа.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 3 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td class="row-stack time-col" width="125" valign="top">
                        <span class="time-pill">20:00–23:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Полёт в Новый год</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                      </td>
                    </tr>
                  </table>
                </div>

                <!-- БЛОК: БЕЛЕБЕЙ -->
                <div style="padding-top:16px; border-top:1px dashed #143542;">
                  <div style="font-family:Arial, sans-serif; font-size:13px; font-weight:900; color:#38bdf8; letter-spacing:1px; margin-bottom:10px;">
                    &#x2708;&#xFE0E; БЕЛЕБЕЙ <span style="font-family:'Courier New', monospace; font-size:10px; color:#94a3b8; font-weight:normal;">(ПО МЕСТНОМУ ВРЕМЕНИ)</span>
                  </div>

                  <!-- Этап 1 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                    <tr>
                      <td class="row-stack time-col" width="125" valign="top">
                        <span class="time-pill">15:00–15:30</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Регистрация на рейс (Welcome)</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 2 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #0f2a36;">
                    <tr>
                      <td class="row-stack time-col" width="125" valign="top">
                        <span class="time-pill">15:30–18:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Взлёт. Торжественная часть</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Церемония награждения сотрудников и праздничная программа.</div>
                      </td>
                    </tr>
                  </table>

                  <!-- Этап 3 -->
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td class="row-stack time-col" width="125" valign="top">
                        <span class="time-pill">18:00–20:00</span>
                      </td>
                      <td class="row-stack" valign="top">
                        <div style="font-size:13px; font-weight:bold; color:#ffffff;">Полёт в Новый год</div>
                        <div style="font-size:12px; color:#94a3b8; margin-top:2px;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                      </td>
                    </tr>
                  </table>
                </div>

              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

