<mjml lang="ru">
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Savencia</mj-title>
    <mj-preview>Внимание, объявляется посадка на особый новогодний рейс Savencia! 10 декабря объединяем Москву, Уфу и Белебей.</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" padding="0" />
      <mj-text font-size="15px" color="#e2e8f0" line-height="1.6" />
      <mj-section background-color="#071726" />
    </mj-attributes>
    <mj-style>
      /* Hallmark · built: Savencia · redesign: Luxury Velvet Boarding Pass · genre: editorial */
      :root {
        --color-bg-deep: #071726;
        --color-navy: #004b62;
        --color-orange: #de6a09;
        --color-sky: #008fd0;
        --color-slate-light: #e2e8f0;
        --color-slate-muted: #94a3b8;
      }
      .ticket-box {
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
        overflow: hidden;
      }
      @media only screen and (max-width: 479px) {
        .px-m {
          padding-left: 14px !important;
          padding-right: 14px !important;
        }
        .pass-field {
          display: inline-block !important;
          width: 48% !important;
          box-sizing: border-box !important;
          margin-bottom: 10px !important;
          vertical-align: top !important;
          text-align: left !important;
        }
        .stub-col {
          display: block !important;
          width: 100% !important;
          text-align: center !important;
          padding: 0 !important;
        }
        .stub-raffle-wrap {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
          margin-bottom: 14px !important;
        }
        .stub-barcode-img {
          margin: 0 auto !important;
          display: inline-block !important;
        }
        .sched-time-badge {
          display: inline-block !important;
          margin-bottom: 6px !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#071726" width="600px">
    
    <!-- PREHEADER & WEB LINK -->
    <mj-section background-color="#071726" padding="12px 24px">
      <mj-column width="100%">
        <mj-text align="center" font-size="11px" color="#798fa8">
          Новогодний рейс Savencia SV-2027 &nbsp;•&nbsp; 
          <a href="#" style="color: #38bdf8; text-decoration: underline;">Веб-версия рассылки</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- HEADER: LOGO (COLOR) -->
    <mj-section background-color="#ffffff" padding="20px 26px 18px 26px" border-radius="16px 16px 0 0" css-class="px-m">
      <mj-column width="50%" vertical-align="middle">
        <mj-image align="left" width="180px" src="logo_color.png" alt="Groupe Savencia" />
      </mj-column>
      <mj-column width="50%" vertical-align="middle">
        <mj-text align="right" font-size="12px" color="#004b62" font-weight="bold">
          РЕЙС: <span style="color:#008fd0;">SV-2027</span> &nbsp;|&nbsp; ГЕЙТ: <span style="color:#de6a09;">2027</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- HERO IMAGE: FESTIVE GLASS BALLS & AIRLINER -->
    <mj-section background-color="#071726" padding="0">
      <mj-column width="100%">
        <mj-image src="hero-v1.png" alt="10 декабря — Вылет в Новый ГОД!" width="600px" />
      </mj-column>
    </mj-section>

    <!-- TICKET CONTAINER (ПОСАДОЧНЫЙ ТАЛОН) -->
    <mj-section background-color="#071726" padding="22px 20px 16px 20px" css-class="px-m">
      <mj-column width="100%">
        <mj-table padding="0">
          <tr>
            <td>
              <div class="ticket-box">
                <!-- Верхняя плашка билета -->
                <div style="background-color: #004b62; color: #ffffff; padding: 12px 20px; font-size: 11px; font-weight: bold; letter-spacing: 1.5px; border-bottom: 2px solid #de6a09;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td align="left" style="color: #38bdf8; font-size: 11px; font-weight: bold; letter-spacing: 1.2px;">
                        ★ BOARDING PASS // ПОСАДОЧНЫЙ ТАЛОН
                      </td>
                      <td align="right" style="color: #ffffff; font-size: 11px; font-weight: bold; letter-spacing: 1px;">
                        FLIGHT SV-2027
                      </td>
                    </tr>
                  </table>
                </div>

                <!-- Тело билета: Маршрут -->
                <div style="padding: 22px 20px 16px 20px; border-bottom: 2px dashed #cbd5e1; background-color: #ffffff;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="42%" align="left" valign="middle">
                        <div style="font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: bold; margin-bottom: 4px; letter-spacing: 0.5px;">ОТПРАВЛЕНИЕ</div>
                        <div style="font-size: 20px; font-weight: 900; color: #004b62; line-height: 1.15;">MOW · UFA · BEL</div>
                        <div style="font-size: 11px; color: #64748b; margin-top: 3px;">Москва • Уфа • Белебей</div>
                      </td>
                      <td width="16%" align="center" valign="middle">
                        <div style="font-size: 20px; color: #008fd0; line-height: 1;">✈</div>
                        <div style="font-size: 9px; color: #94a3b8; font-weight: bold; margin-top: 2px; letter-spacing: 0.5px;">ПРЯМОЙ</div>
                      </td>
                      <td width="42%" align="right" valign="middle">
                        <div style="font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: bold; margin-bottom: 4px; letter-spacing: 0.5px;">НАЗНАЧЕНИЕ</div>
                        <div style="font-size: 21px; font-weight: 900; color: #de6a09; line-height: 1.15;">NEW YEAR</div>
                        <div style="font-size: 11px; color: #64748b; margin-top: 3px;">2027 ГОД</div>
                      </td>
                    </tr>
                  </table>
                </div>

                <!-- Сетка данных билета (адаптивная 4 колонки -> 2х2 на мобильном) -->
                <div style="padding: 16px 20px; background-color: #f8fafc; border-bottom: 2px dashed #cbd5e1;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td class="pass-field" width="25%" valign="top">
                        <div style="font-size: 10px; color: #64748b; font-weight: bold; letter-spacing: 0.5px;">ПАССАЖИР</div>
                        <div style="font-size: 12px; font-weight: 900; color: #0f172a; margin-top: 3px;">Savencia Team</div>
                      </td>
                      <td class="pass-field" width="25%" valign="top">
                        <div style="font-size: 10px; color: #64748b; font-weight: bold; letter-spacing: 0.5px;">ДАТА ВЫЛЕТА</div>
                        <div style="font-size: 12px; font-weight: 900; color: #0f172a; margin-top: 3px;">10 ДЕК 2026</div>
                      </td>
                      <td class="pass-field" width="25%" valign="top">
                        <div style="font-size: 10px; color: #64748b; font-weight: bold; letter-spacing: 0.5px;">КЛАСС</div>
                        <div style="font-size: 12px; font-weight: 900; color: #008fd0; margin-top: 3px;">Одна Команда</div>
                      </td>
                      <td class="pass-field" width="25%" align="right" valign="top">
                        <div style="font-size: 10px; color: #64748b; font-weight: bold; letter-spacing: 0.5px;">ПОСАДКА</div>
                        <div style="font-size: 12px; font-weight: 900; color: #10b981; margin-top: 3px;">ON SCHEDULE</div>
                      </td>
                    </tr>
                  </table>
                </div>

                <!-- Корешок билета со штрихкодом и адаптивной горизонтальной плашкой лотереи -->
                <div style="padding: 16px 20px 20px 20px; background-color: #ffffff;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" dir="rtl">
                    <tr>
                      <!-- На мобильном отображается первым и на всю ширину (100%) -->
                      <td class="stub-col" width="46%" align="right" valign="middle" dir="ltr" style="padding-left: 12px;">
                        <div class="stub-raffle-wrap" style="background-color: #fff7ed; border: 1.5px dashed #de6a09; padding: 10px 14px; border-radius: 8px; text-align: center;">
                          <div style="color: #de6a09; font-weight: 900; font-size: 11px; letter-spacing: 0.5px;">★ РОЗЫГРЫШ ПРИЗОВ</div>
                          <div style="color: #475569; font-size: 10px; margin-top: 3px;">Билет выдается на регистрации</div>
                        </div>
                      </td>
                      <!-- На мобильном центрируется под плашкой -->
                      <td class="stub-col" width="54%" align="left" valign="middle" dir="ltr">
                        <img class="stub-barcode-img" src="barcode.png" alt="Barcode SV-2027" style="max-width: 210px; width: 100%; height: auto; display: block;" />
                      </td>
                    </tr>
                  </table>
                </div>
              </div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- MANIFESTO (ОБРАЩЕНИЕ К КОМАНДЕ) -->
    <mj-section background-color="#071726" padding="18px 24px" css-class="px-m">
      <mj-column width="100%">
        <mj-text font-size="22px" font-weight="900" color="#ffffff" line-height="1.25" align="center">
          ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
        </mj-text>
        <mj-text font-size="16px" font-weight="bold" color="#de6a09" align="center" padding-top="6px">
          10 декабря — Вылет в Новый ГОД!
        </mj-text>
        <mj-text font-size="15px" color="#cbd5e1" line-height="1.65" padding-top="16px">
          <strong style="color:#ffffff;">Дорогие коллеги!</strong><br />
          Внимание, объявляется посадка на особый новогодний рейс! 10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников <strong style="color:#ffffff;">Savencia</strong> из трёх городов — <strong style="color:#ffffff;">Москвы, Уфы и Белебея</strong>.
        </mj-text>
        <mj-text font-size="14px" color="#94a3b8" line-height="1.6" padding-top="8px">
          В этот день наши праздничные площадки превратятся в настоящие аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — <strong style="color:#ffffff;">Новый год!</strong>
        </mj-text>
        <mj-text font-size="14px" color="#94a3b8" line-height="1.6" padding-top="8px">
          <strong style="color:#38bdf8;">В программе полёта:</strong> тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- SCHEDULE: AIRPORT TERMINAL CARDS -->
    <mj-section background-color="#071726" padding="10px 20px 24px 20px" css-class="px-m">
      <mj-column width="100%">
        <mj-table padding="0">
          <tr>
            <td>
              <!-- ТЕРМИНАЛ: МОСКВА И УФА -->
              <div style="background-color: #0b1f36; border-radius: 14px; padding: 20px; border: 1px solid #173254; margin-bottom: 18px;">
                <div style="font-size: 14px; font-weight: 900; color: #38bdf8; letter-spacing: 1px; margin-bottom: 14px;">
                  ✈ МОСКВА И УФА (по местному времени)
                </div>

                <!-- Этап 1 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 12px;">
                  <tr>
                    <td width="115" valign="top">
                      <span class="sched-time-badge" style="display:inline-block; background-color: #004b62; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">17:00 – 18:00</span>
                    </td>
                    <td valign="top" style="padding-left: 8px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Регистрация на рейс (Welcome)</div>
                      <div style="color: #94a3b8; font-size: 11px; margin-top: 2px; line-height: 1.4;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 2 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 12px;">
                  <tr>
                    <td width="115" valign="top">
                      <span class="sched-time-badge" style="display:inline-block; background-color: #de6a09; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">18:00 – 20:00</span>
                    </td>
                    <td valign="top" style="padding-left: 8px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Взлёт. Торжественная часть</div>
                      <div style="color: #94a3b8; font-size: 11px; margin-top: 2px; line-height: 1.4;">Церемония награждения сотрудников и праздничная программа.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 3 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                  <tr>
                    <td width="115" valign="top">
                      <span class="sched-time-badge" style="display:inline-block; background-color: #008fd0; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">20:00 – 23:00</span>
                    </td>
                    <td valign="top" style="padding-left: 8px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Полёт в Новый год</div>
                      <div style="color: #94a3b8; font-size: 11px; margin-top: 2px; line-height: 1.4;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                    </td>
                  </tr>
                </table>

                <!-- Локации -->
                <div style="padding-top: 12px; border-top: 1px dashed rgba(255,255,255,0.15); font-size: 11px; color: #cbd5e1; line-height: 1.5;">
                  <div>✈ <strong style="color:#ffffff;">Аэропорт Москва:</strong> проспект Андропова, 11, корпус 2, Южный Event-Port.</div>
                  <div style="margin-top: 5px;">✈ <strong style="color:#ffffff;">Аэропорт Уфа:</strong> улица Менделеева, 205А, ресторан «Пастернак».</div>
                </div>
              </div>

              <!-- ТЕРМИНАЛ: БЕЛЕБЕЙ -->
              <div style="background-color: #0b1f36; border-radius: 14px; padding: 20px; border: 1px solid #173254;">
                <div style="font-size: 14px; font-weight: 900; color: #38bdf8; letter-spacing: 1px; margin-bottom: 14px;">
                  ✈ БЕЛЕБЕЙ (по местному времени)
                </div>

                <!-- Этап 1 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 12px;">
                  <tr>
                    <td width="115" valign="top">
                      <span class="sched-time-badge" style="display:inline-block; background-color: #004b62; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">15:00 – 15:30</span>
                    </td>
                    <td valign="top" style="padding-left: 8px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Регистрация на рейс (Welcome)</div>
                      <div style="color: #94a3b8; font-size: 11px; margin-top: 2px; line-height: 1.4;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 2 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 12px;">
                  <tr>
                    <td width="115" valign="top">
                      <span class="sched-time-badge" style="display:inline-block; background-color: #de6a09; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">15:30 – 18:00</span>
                    </td>
                    <td valign="top" style="padding-left: 8px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Взлёт. Торжественная часть</div>
                      <div style="color: #94a3b8; font-size: 11px; margin-top: 2px; line-height: 1.4;">Церемония награждения сотрудников и праздничная программа.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 3 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                  <tr>
                    <td width="115" valign="top">
                      <span class="sched-time-badge" style="display:inline-block; background-color: #008fd0; color: #ffffff; font-weight: bold; font-size: 11px; padding: 5px 10px; border-radius: 6px;">18:00 – 20:00</span>
                    </td>
                    <td valign="top" style="padding-left: 8px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Полёт в Новый год</div>
                      <div style="color: #94a3b8; font-size: 11px; margin-top: 2px; line-height: 1.4;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                    </td>
                  </tr>
                </table>

                <!-- Локация -->
                <div style="padding-top: 12px; border-top: 1px dashed rgba(255,255,255,0.15); font-size: 11px; color: #cbd5e1; line-height: 1.5;">
                  ✈ <strong style="color:#ffffff;">Аэропорт Белебей:</strong> улица Амирова, 10А, Центральный дворец культуры.
                </div>
              </div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- PRE-FLIGHT BRIEFING (3 ШАГА ПАССАЖИРА) -->
    <mj-section background-color="#071726" padding="0 20px 24px 20px" css-class="px-m">
      <mj-column width="100%">
        <mj-text font-size="18px" font-weight="900" color="#ffffff" align="center" padding-bottom="16px">
          Памятка пассажира перед вылетом
        </mj-text>
      </mj-column>
      
      <!-- Шаг 1 -->
      <mj-column width="33.33%" padding="0 6px 12px 6px">
        <mj-table padding="0">
          <tr>
            <td style="background-color: #0b1f36; border: 1px solid #173254; border-radius: 12px; padding: 18px 14px; text-align: center;">
              <div style="display:inline-block; background-color: #004b62; color: #38bdf8; font-weight: 900; font-size: 13px; width: 32px; height: 32px; line-height: 32px; border-radius: 50%; margin-bottom: 10px;">01</div>
              <div style="color: #ffffff; font-weight: bold; font-size: 13px; margin-bottom: 6px;">Настроение</div>
              <div style="color: #94a3b8; font-size: 11px; line-height: 1.4;">Подготовьте улыбки и готовность к ярким впечатлениям.</div>
            </td>
          </tr>
        </mj-table>
      </mj-column>

      <!-- Шаг 2 -->
      <mj-column width="33.33%" padding="0 6px 12px 6px">
        <mj-table padding="0">
          <tr>
            <td style="background-color: #0b1f36; border: 1px solid #173254; border-radius: 12px; padding: 18px 14px; text-align: center;">
              <div style="display:inline-block; background-color: #de6a09; color: #ffffff; font-weight: 900; font-size: 13px; width: 32px; height: 32px; line-height: 32px; border-radius: 50%; margin-bottom: 10px;">02</div>
              <div style="color: #ffffff; font-weight: bold; font-size: 13px; margin-bottom: 6px;">Посадочный</div>
              <div style="color: #94a3b8; font-size: 11px; line-height: 1.4;">Заберите свой билет на стойке Welcome для розыгрыша.</div>
            </td>
          </tr>
        </mj-table>
      </mj-column>

      <!-- Шаг 3 -->
      <mj-column width="33.33%" padding="0 6px 12px 6px">
        <mj-table padding="0">
          <tr>
            <td style="background-color: #0b1f36; border: 1px solid #173254; border-radius: 12px; padding: 18px 14px; text-align: center;">
              <div style="display:inline-block; background-color: #008fd0; color: #ffffff; font-weight: 900; font-size: 13px; width: 32px; height: 32px; line-height: 32px; border-radius: 50%; margin-bottom: 10px;">03</div>
              <div style="color: #ffffff; font-weight: bold; font-size: 13px; margin-bottom: 6px;">Пунктуальность</div>
              <div style="color: #94a3b8; font-size: 11px; line-height: 1.4;">Прибывайте без опозданий к началу регистрации.</div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- FINAL SIGN-OFF (HALLMARK) -->
    <mj-section background-color="#0b1f36" padding="30px 24px" border-radius="0 0 16px 16px" css-class="px-m">
      <mj-column width="100%">
        <mj-text font-size="24px" font-weight="900" color="#ffffff" align="center">
          До встречи 10 декабря!
        </mj-text>
        <mj-text font-size="15px" color="#38bdf8" font-weight="bold" align="center" padding-top="8px">
          Ваш экипаж Savencia ✈
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- SAVENCIA BRAND ACCENT BAR -->
    <mj-section background-color="#071726" padding="16px 0 24px 0">
      <mj-group width="240px">
        <mj-column width="33.33%">
          <mj-divider border-color="#008fd0" border-width="4px" padding="0" />
        </mj-column>
        <mj-column width="33.33%">
          <mj-divider border-color="#b1ca40" border-width="4px" padding="0" />
        </mj-column>
        <mj-column width="33.33%">
          <mj-divider border-color="#de6a09" border-width="4px" padding="0" />
        </mj-column>
      </mj-group>
    </mj-section>

  </mj-body>
</mjml>