<mjml lang="ru">
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Savencia</mj-title>
    <mj-preview>Внимание, объявляется посадка на особый новогодний рейс Savencia! 10 декабря объединяем Москву, Уфу и Белебей.</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" padding="0" />
      <mj-text font-size="15px" color="#e2e8f0" line-height="1.6" />
      <mj-section background-color="#071726" />
    </mj-attributes>
    <mj-style>
      /* Hallmark · Luxury Boarding Pass · Full-Width Edge-to-Edge with Overlapping Ticket */
      :root {
        --color-bg-deep: #071726;
        --color-navy: #004b62;
        --color-orange: #de6a09;
        --color-sky: #008fd0;
        --color-slate-light: #e2e8f0;
        --color-slate-muted: #94a3b8;
      }
      html, body {
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
      }
      ::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
        background: transparent !important;
      }
      .skeuo-ticket {
        background-color: #fcfbf7;
        background: linear-gradient(145deg, #ffffff 0%, #fdfcf9 40%, #f4eee2 100%);
        border-radius: 14px;
        box-shadow: 0 20px 45px rgba(0, 25, 35, 0.45), 0 5px 15px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        border: 1px solid #e2d9c8;
        max-width: 100% !important;
        box-sizing: border-box !important;
      }
      .ticket-band {
        background-color: #003444;
        background: linear-gradient(90deg, #00232f 0%, #004b62 100%);
        padding: 14px 20px;
        border-top: 4px solid #de6a09;
      }
      .ticket-body {
        padding: 22px 20px 18px 20px;
        background-color: #fdfcf9;
      }
      .ticket-perforation {
        border-bottom: 2px dashed #cbd5e1;
        position: relative;
        margin: 0;
      }
      .ticket-stub {
        padding: 16px 20px 18px 20px;
        background-color: #f8f6f0;
      }
      @media only screen and (max-width: 479px) {
        .px-m {
          padding-left: 14px !important;
          padding-right: 14px !important;
        }
        .sched-table, .sched-table tbody, .sched-table tr, .sched-time-col, .sched-desc-col {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
        .sched-time-col {
          margin-bottom: 6px !important;
        }
        .sched-desc-col {
          padding-left: 0 !important;
          margin-bottom: 14px !important;
        }
        .tkt-band-cell {
          display: block !important;
          width: 100% !important;
          text-align: center !important;
        }
        .tkt-band-right {
          margin-top: 8px !important;
        }
        .tkt-route-cell {
          display: block !important;
          width: 100% !important;
          text-align: center !important;
        }
        .tkt-route-right {
          margin-top: 14px !important;
          padding-top: 10px !important;
          border-top: 1px dashed #e2e8f0 !important;
        }
        .tkt-city-code {
          font-size: 20px !important;
        }
        .tkt-grid-cell {
          display: inline-block !important;
          width: 50% !important;
          box-sizing: border-box !important;
          padding: 6px 2px !important;
          text-align: center !important;
        }
        .stub-badge-box {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
          margin-bottom: 12px !important;
          text-align: center !important;
        }
        .stub-barcode-box {
          display: block !important;
          width: 100% !important;
          text-align: center !important;
        }
        .stub-barcode-img {
          margin: 0 auto !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#071726" width="640px">

    <!-- 1. HEADER: FULL WIDTH EDGE-TO-EDGE -->
    <mj-section background-color="#ffffff" padding="18px 24px" border-radius="0" css-class="px-m">
      <mj-column width="50%" vertical-align="middle">
        <mj-image align="left" width="180px" src="logo_color.png" alt="Groupe Savencia" />
      </mj-column>
      <mj-column width="50%" vertical-align="middle">
        <mj-text align="right" font-size="12px" color="#004b62" font-weight="bold">
          РЕЙС: <span style="color:#008fd0;">SV-2027</span> &nbsp;|&nbsp; ГЕЙТ: <span style="color:#de6a09;">2027</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 2. HERO IMAGE: FULL WIDTH 640px EDGE-TO-EDGE -->
    <mj-section background-color="#071726" padding="0">
      <mj-column width="100%">
        <mj-image src="hero-v1.png" alt="10 декабря — Вылет в Новый ГОД!" width="640px" fluid-on-mobile="true" />
      </mj-column>
    </mj-section>

    <!-- 3. TICKET CONTAINER: СКЕВОМОРФНЫЙ ФАКТУРНЫЙ ПОСАДОЧНЫЙ ТАЛОН ИЗ 6-Й КОНЦЕПЦИИ -->
    <mj-section background-color="#071726" padding="22px 20px 18px 20px" css-class="px-m">
      <mj-column width="100%">
        <mj-text padding="0">
          <div class="skeuo-ticket">
            <!-- Верхняя плашка билета (глубокий петроль + оранжевый кант) -->
            <div class="ticket-band">
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="table-layout:fixed;">
                <tr>
                  <td class="tkt-band-cell" align="left" valign="middle">
                    <span style="font-family:'Courier New', monospace; font-size:11px; font-weight:900; color:#ffffff; letter-spacing:1px;">
                      SAVENCIA SPECIAL FLIGHT &bull; SV-2027
                    </span>
                  </td>
                  <td class="tkt-band-cell" align="right" valign="middle">
                    <div class="tkt-band-right">
                      <span style="display:inline-block; background-color:#de6a09; color:#ffffff; font-family:'Courier New', monospace; font-size:10px; font-weight:900; padding:3px 10px; border-radius:4px; letter-spacing:1px;">
                        GATE 10 &bull; BOARDING
                      </span>
                    </div>
                  </td>
                </tr>
              </table>
            </div>

            <!-- Тело билета: Маршрут из трёх городов в Новый год -->
            <div class="ticket-body">
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="table-layout:fixed; margin-bottom:18px;">
                <tr>
                  <td class="tkt-route-cell" width="55%" align="left" valign="middle">
                    <div style="font-size:10px; font-family:'Courier New', monospace; font-weight:bold; color:#64748b; letter-spacing:1px; text-transform:uppercase;">
                      ОТПРАВЛЕНИЕ // FROM
                    </div>
                    <div class="tkt-city-code" style="font-family:Arial, sans-serif; font-size:22px; font-weight:900; color:#004b62; line-height:1.2; margin:4px 0 2px;">
                      MOW &bull; UFA &bull; BEL
                    </div>
                    <div style="font-size:11px; color:#475569; font-weight:600;">
                      Москва &bull; Уфа &bull; Белебей
                    </div>
                  </td>
                  <td class="tkt-route-cell tkt-route-right" width="45%" align="right" valign="middle">
                    <div>
                      <div style="font-size:10px; font-family:'Courier New', monospace; font-weight:bold; color:#de6a09; letter-spacing:1px; text-transform:uppercase;">
                        НАЗНАЧЕНИЕ // TO
                      </div>
                      <div class="tkt-city-code" style="font-family:Arial, sans-serif; font-size:22px; font-weight:900; color:#de6a09; line-height:1.2; margin:4px 0 2px;">
                        NEW YEAR
                      </div>
                      <div style="font-size:11px; color:#b45309; font-weight:bold;">
                        2027 ГОД
                      </div>
                    </div>
                  </td>
                </tr>
              </table>

              <!-- Сетка параметров билета (4 показателя) -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="table-layout:fixed; background-color:#f1f5f9; border-radius:8px; padding:6px;">
                <tr>
                  <td class="tkt-grid-cell" width="25%" align="center" valign="top">
                    <div style="font-size:9px; font-family:'Courier New', monospace; color:#64748b; font-weight:bold;">ПАССАЖИР</div>
                    <div style="font-size:11px; font-weight:900; color:#0f172a; margin-top:2px;">Savencia Team</div>
                  </td>
                  <td class="tkt-grid-cell" width="25%" align="center" valign="top">
                    <div style="font-size:9px; font-family:'Courier New', monospace; color:#64748b; font-weight:bold;">ДАТА РЕЙСА</div>
                    <div style="font-size:11px; font-weight:900; color:#0f172a; margin-top:2px;">10 ДЕК 2026</div>
                  </td>
                  <td class="tkt-grid-cell" width="25%" align="center" valign="top">
                    <div style="font-size:9px; font-family:'Courier New', monospace; color:#64748b; font-weight:bold;">КЛАСС</div>
                    <div style="font-size:11px; font-weight:900; color:#008fd0; margin-top:2px;">Одна Команда</div>
                  </td>
                  <td class="tkt-grid-cell" width="25%" align="center" valign="top">
                    <div style="font-size:9px; font-family:'Courier New', monospace; color:#64748b; font-weight:bold;">ПОСАДКА</div>
                    <div style="font-size:11px; font-weight:900; color:#15803d; margin-top:2px;">ON TIME</div>
                  </td>
                </tr>
              </table>
            </div>

            <!-- Перфорация билета (линия отрыва) -->
            <div class="ticket-perforation"></div>

            <!-- Отрывной корешок билета со штрих-кодом и розыгрышем -->
            <div class="ticket-stub">
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="table-layout:fixed;">
                <tr>
                  <td class="stub-badge-box" width="50%" align="left" valign="middle">
                    <div style="background-color:#fff7ed; border:1.5px dashed #de6a09; border-radius:8px; padding:8px 12px; display:inline-block;">
                      <div style="color:#de6a09; font-size:11px; font-weight:900; letter-spacing:0.5px;">★ РОЗЫГРЫШ ПРИЗОВ</div>
                      <div style="color:#64748b; font-size:10px; margin-top:2px;">Билет выдается на регистрации</div>
                    </div>
                  </td>
                  <td class="stub-barcode-box" width="50%" align="right" valign="middle">
                    <img class="stub-barcode-img" src="barcode.png" width="160" alt="Barcode" style="display:block; width:160px; height:auto; max-width:100%; margin-left:auto;" />
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 4. MANIFESTO: ОБРАЩЕНИЕ К КОМАНДЕ (СЛОГАН ПО ЦЕНТРУ, ТЕКСТ СЛЕВА) -->
    <mj-section background-color="#071726" padding="16px 24px 24px 24px" css-class="px-m">
      <mj-column width="100%">
        <mj-text font-size="22px" font-weight="900" color="#ffffff" line-height="1.25" align="center">
          ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
        </mj-text>
        <mj-text font-size="16px" font-weight="bold" color="#de6a09" align="center" padding-top="6px">
          10 декабря — Вылет в Новый ГОД!
        </mj-text>
        <mj-text font-size="15px" color="#cbd5e1" line-height="1.65" align="left" padding-top="16px">
          <strong style="color:#ffffff;">Дорогие коллеги!</strong><br />
          Внимание, объявляется посадка на особый новогодний рейс! 10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников <strong style="color:#ffffff;">Savencia</strong> из трёх городов — <strong style="color:#ffffff;">Москвы, Уфы и Белебея</strong>.
        </mj-text>
        <mj-text font-size="14px" color="#94a3b8" line-height="1.6" align="left" padding-top="10px">
          В этот день наши праздничные площадки превратятся в настоящие аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — <strong style="color:#ffffff;">Новый год!</strong>
        </mj-text>
        <mj-text font-size="14px" color="#94a3b8" line-height="1.6" align="left" padding-top="10px">
          <strong style="color:#38bdf8;">В программе полёта:</strong> тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 5. SCHEDULE: ТЕКСТ ПОД ПЛАШКАМИ ВРЕМЕНИ -->
    <mj-section background-color="#071726" padding="10px 20px 24px 20px" css-class="px-m">
      <mj-column width="100%">
        <mj-table padding="0">
          <tr>
            <td>
              <!-- ТЕРМИНАЛ: МОСКВА И УФА -->
              <div style="background-color: #0b1f36; border-radius: 14px; padding: 22px 20px; border: 1px solid #173254; margin-bottom: 20px;">
                <div style="font-size: 15px; font-weight: 900; color: #38bdf8; letter-spacing: 1px; margin-bottom: 18px;">
                  ✈ МОСКВА И УФА (по местному времени)
                </div>

                <!-- Этап 1 -->
                <table class="sched-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                  <tr>
                    <td class="sched-time-col" width="125" valign="top">
                      <span style="display:inline-block; background-color: #004b62; color: #ffffff; font-weight: 900; font-size: 11px; padding: 5px 10px; border-radius: 6px; letter-spacing: 0.5px;">17:00 – 18:00</span>
                    </td>
                    <td class="sched-desc-col" valign="top" style="padding-left: 10px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 14px; margin-bottom: 3px;">Регистрация на рейс (Welcome)</div>
                      <div style="color: #94a3b8; font-size: 12px; line-height: 1.45;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 2 -->
                <table class="sched-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                  <tr>
                    <td class="sched-time-col" width="125" valign="top">
                      <span style="display:inline-block; background-color: #de6a09; color: #ffffff; font-weight: 900; font-size: 11px; padding: 5px 10px; border-radius: 6px; letter-spacing: 0.5px;">18:00 – 20:00</span>
                    </td>
                    <td class="sched-desc-col" valign="top" style="padding-left: 10px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 14px; margin-bottom: 3px;">Взлёт. Торжественная часть</div>
                      <div style="color: #94a3b8; font-size: 12px; line-height: 1.45;">Церемония награждения сотрудников и официальная праздничная программа.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 3 -->
                <table class="sched-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 16px;">
                  <tr>
                    <td class="sched-time-col" width="125" valign="top">
                      <span style="display:inline-block; background-color: #008fd0; color: #ffffff; font-weight: 900; font-size: 11px; padding: 5px 10px; border-radius: 6px; letter-spacing: 0.5px;">20:00 – 23:00</span>
                    </td>
                    <td class="sched-desc-col" valign="top" style="padding-left: 10px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 14px; margin-bottom: 3px;">Полёт в Новый год</div>
                      <div style="color: #94a3b8; font-size: 12px; line-height: 1.45;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                    </td>
                  </tr>
                </table>

                <!-- Локации -->
                <div style="padding-top: 14px; border-top: 1px dashed rgba(255,255,255,0.15); font-size: 12px; color: #cbd5e1; line-height: 1.55;">
                  <div>✈ <strong style="color:#ffffff;">Аэропорт Москва:</strong> проспект Андропова, 11, корпус 2, Южный Event-Port.</div>
                  <div style="margin-top: 6px;">✈ <strong style="color:#ffffff;">Аэропорт Уфа:</strong> улица Менделеева, 205А, ресторан «Пастернак».</div>
                </div>
              </div>

              <!-- ТЕРМИНАЛ: БЕЛЕБЕЙ -->
              <div style="background-color: #0b1f36; border-radius: 14px; padding: 22px 20px; border: 1px solid #173254;">
                <div style="font-size: 15px; font-weight: 900; color: #38bdf8; letter-spacing: 1px; margin-bottom: 18px;">
                  ✈ БЕЛЕБЕЙ (по местному времени)
                </div>

                <!-- Этап 1 -->
                <table class="sched-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                  <tr>
                    <td class="sched-time-col" width="125" valign="top">
                      <span style="display:inline-block; background-color: #004b62; color: #ffffff; font-weight: 900; font-size: 11px; padding: 5px 10px; border-radius: 6px; letter-spacing: 0.5px;">15:00 – 15:30</span>
                    </td>
                    <td class="sched-desc-col" valign="top" style="padding-left: 10px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 14px; margin-bottom: 3px;">Регистрация на рейс (Welcome)</div>
                      <div style="color: #94a3b8; font-size: 12px; line-height: 1.45;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 2 -->
                <table class="sched-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                  <tr>
                    <td class="sched-time-col" width="125" valign="top">
                      <span style="display:inline-block; background-color: #de6a09; color: #ffffff; font-weight: 900; font-size: 11px; padding: 5px 10px; border-radius: 6px; letter-spacing: 0.5px;">15:30 – 18:00</span>
                    </td>
                    <td class="sched-desc-col" valign="top" style="padding-left: 10px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 14px; margin-bottom: 3px;">Взлёт. Торжественная часть</div>
                      <div style="color: #94a3b8; font-size: 12px; line-height: 1.45;">Церемония награждения сотрудников и праздничная программа.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 3 -->
                <table class="sched-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 16px;">
                  <tr>
                    <td class="sched-time-col" width="125" valign="top">
                      <span style="display:inline-block; background-color: #008fd0; color: #ffffff; font-weight: 900; font-size: 11px; padding: 5px 10px; border-radius: 6px; letter-spacing: 0.5px;">18:00 – 20:00</span>
                    </td>
                    <td class="sched-desc-col" valign="top" style="padding-left: 10px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 14px; margin-bottom: 3px;">Полёт в Новый год</div>
                      <div style="color: #94a3b8; font-size: 12px; line-height: 1.45;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                    </td>
                  </tr>
                </table>

                <!-- Локация -->
                <div style="padding-top: 14px; border-top: 1px dashed rgba(255,255,255,0.15); font-size: 12px; color: #cbd5e1; line-height: 1.55;">
                  ✈ <strong style="color:#ffffff;">Аэропорт Белебей:</strong> улица Амирова, 10А, Центральный дворец культуры Белебеевского района.
                </div>
              </div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- 6. PRE-FLIGHT BRIEFING: ПАМЯТКА ПАССАЖИРА -->
    <mj-section background-color="#071726" padding="0 20px 24px 20px" css-class="px-m">
      <mj-column width="100%">
        <mj-text font-size="18px" font-weight="900" color="#ffffff" align="center" padding-bottom="16px">
          Памятка пассажира перед вылетом
        </mj-text>
      </mj-column>
      
      <!-- Шаг 1: Настроение — оранжевое -->
      <mj-column width="33.33%" padding="0 6px 12px 6px">
        <mj-table padding="0">
          <tr>
            <td height="162" valign="top" style="background-color: #0b1f36; border: 1px solid #173254; border-radius: 12px; padding: 20px 14px 18px 14px; text-align: center; height: 162px; vertical-align: top;">
              <table align="center" cellpadding="0" cellspacing="0" border="0" style="margin: 0 auto 12px auto;">
                <tr>
                  <td align="center" valign="middle" height="44" style="text-align: center; vertical-align: middle;">
                    <img src="v1-icon-mood-orange.png" width="44" height="44" alt="Настроение" style="display: block; margin: 0 auto; border: 0;" />
                  </td>
                </tr>
              </table>
              <div style="color: #ffffff; font-weight: bold; font-size: 13px; margin-bottom: 6px;">Настроение</div>
              <div style="color: #94a3b8; font-size: 11px; line-height: 1.4;">Подготовьте улыбки и готовность к ярким впечатлениям.</div>
            </td>
          </tr>
        </mj-table>
      </mj-column>

      <!-- Шаг 2: Посадочная — голубое -->
      <mj-column width="33.33%" padding="0 6px 12px 6px">
        <mj-table padding="0">
          <tr>
            <td height="162" valign="top" style="background-color: #0b1f36; border: 1px solid #173254; border-radius: 12px; padding: 20px 14px 18px 14px; text-align: center; height: 162px; vertical-align: top;">
              <table align="center" cellpadding="0" cellspacing="0" border="0" style="margin: 0 auto 12px auto;">
                <tr>
                  <td align="center" valign="middle" height="44" style="text-align: center; vertical-align: middle;">
                    <img src="v1-icon-pass-blue.png" width="48" height="29" alt="Посадочный" style="display: block; margin: 0 auto; border: 0;" />
                  </td>
                </tr>
              </table>
              <div style="color: #ffffff; font-weight: bold; font-size: 13px; margin-bottom: 6px;">Посадочный</div>
              <div style="color: #94a3b8; font-size: 11px; line-height: 1.4;">Заберите свой билет на стойке Welcome для розыгрыша.</div>
            </td>
          </tr>
        </mj-table>
      </mj-column>

      <!-- Шаг 3: Пунктуальность — зелёным -->
      <mj-column width="33.33%" padding="0 6px 12px 6px">
        <mj-table padding="0">
          <tr>
            <td height="162" valign="top" style="background-color: #0b1f36; border: 1px solid #173254; border-radius: 12px; padding: 20px 14px 18px 14px; text-align: center; height: 162px; vertical-align: top;">
              <table align="center" cellpadding="0" cellspacing="0" border="0" style="margin: 0 auto 12px auto;">
                <tr>
                  <td align="center" valign="middle" height="44" style="text-align: center; vertical-align: middle;">
                    <img src="v1-icon-time-green.png" width="44" height="44" alt="Пунктуальность" style="display: block; margin: 0 auto; border: 0;" />
                  </td>
                </tr>
              </table>
              <div style="color: #ffffff; font-weight: bold; font-size: 13px; margin-bottom: 6px;">Пунктуальность</div>
              <div style="color: #94a3b8; font-size: 11px; line-height: 1.4;">Прибывайте без опозданий к началу регистрации.</div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- 7. FOOTER: FULL WIDTH EDGE-TO-EDGE БЕЗ ПУСТОГО ПРОСТРАНСТВА СНИЗУ -->
    <mj-section background-color="#0b1f36" padding="30px 24px 20px 24px" border-radius="0" css-class="px-m">
      <mj-column width="100%">
        <mj-text font-size="24px" font-weight="900" color="#ffffff" align="center">
          До встречи 10 декабря!
        </mj-text>
        <mj-text font-size="15px" color="#38bdf8" font-weight="bold" align="center" padding-top="8px" padding-bottom="20px">
          Ваш экипаж Savencia ✈
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- SAVENCIA BRAND ACCENT BAR: ЗАВЕРШАЮЩИЙ ТРИКОЛОР В САМОМ НИЗУ ФУТЕРА -->
    <mj-section background-color="#0b1f36" padding="0 0 24px 0">
      <mj-group width="240px">
        <mj-column width="33.33%">
          <mj-divider border-color="#008fd0" border-width="4px" padding="0" />
        </mj-column>
        <mj-column width="33.33%">
          <mj-divider border-color="#b1ca40" border-width="4px" padding="0" />
        </mj-column>
        <mj-column width="33.33%">
          <mj-divider border-color="#de6a09" border-width="4px" padding="0" />
        </mj-column>
      </mj-group>
    </mj-section>

  </mj-body>
</mjml>