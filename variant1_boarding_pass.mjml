<mjml lang="ru">
  <mj-head>
    <mj-title>10 декабря — Вылет в Новый ГОД! | Savencia</mj-title>
    <mj-preview>Внимание, объявляется посадка на особый новогодний рейс Savencia! 10 декабря объединяем Москву, Уфу и Белебей.</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" padding="0" />
      <mj-text font-size="14px" color="#e0e6ed" line-height="1.6" />
      <mj-section background-color="#0a1526" />
    </mj-attributes>
    <mj-style>
      /* Hallmark · built: Savencia · redesign: polish · genre: editorial */
      :root {
        --color-bg-deep: #050c17;
        --color-navy: #004b62;
        --color-orange: #de6a09;
        --color-sky: #008fd0;
        --color-slate-light: #e0e6ed;
        --color-slate-muted: #6f859c;
      }
      .ticket-box {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.35);
        overflow: hidden;
      }
      .city-code {
        font-size: 22px;
        font-weight: 900;
        letter-spacing: 1px;
        color: #004b62;
      }
      .dest-code {
        font-size: 22px;
        font-weight: 900;
        letter-spacing: 1px;
        color: #de6a09;
      }
      @media only screen and (max-width: 480px) {
        .mobile-stack {
          display: block !important;
          width: 100% !important;
        }
        .city-code, .dest-code {
          font-size: 18px !important;
        }
        .sched-col {
          display: block !important;
          width: 100% !important;
          margin-bottom: 12px !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#050c17" width="600px">
    
    <!-- PREHEADER & WEB LINK -->
    <mj-section background-color="#050c17" padding="12px 24px">
      <mj-column width="100%">
        <mj-text align="center" font-size="11px" color="#6f859c">
          Новогодний рейс Savencia SV-2027 &nbsp;•&nbsp; 
          <a href="#" style="color: #008fd0; text-decoration: underline;">Веб-версия рассылки</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- HEADER: LOGO (COLOR) -->
    <mj-section background-color="#ffffff" padding="20px 24px 18px 24px" border-radius="16px 16px 0 0">
      <mj-column width="50%" vertical-align="middle">
        <mj-image align="left" width="180px" src="logo_color.png" alt="Groupe Savencia" />
      </mj-column>
      <mj-column width="50%" vertical-align="middle">
        <mj-text align="right" font-size="12px" color="#004b62" font-weight="bold">
          РЕЙС: <span style="color:#008fd0;">SV-2027</span> &nbsp;|&nbsp; ГЕЙТ: <span style="color:#de6a09;">2027</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- HERO IMAGE: FESTIVE GLASS BALLS & AIRLINER -->
    <mj-section background-color="#0a1526" padding="0">
      <mj-column width="100%">
        <mj-image src="hero-v1.png" alt="10 декабря — Вылет в Новый ГОД!" width="600px" />
      </mj-column>
    </mj-section>

    <!-- TICKET CONTAINER (ПОСАДОЧНЫЙ ТАЛОН) -->
    <mj-section background-color="#0a1526" padding="20px 20px 16px 20px">
      <mj-column width="100%">
        <mj-table padding="0">
          <tr>
            <td>
              <div style="background-color: #ffffff; border-radius: 16px; overflow: hidden; border: 1px solid #1a2a40; box-shadow: 0 12px 35px rgba(0,0,0,0.5);">
                <!-- Верхняя плашка билета -->
                <div style="background-color: #004b62; color: #ffffff; padding: 12px 20px; font-size: 11px; font-weight: bold; letter-spacing: 1.5px; display: flex; justify-content: space-between;">
                  <span style="color: #1bbbe9;">★ BOARDING PASS / ПОСАДОЧНЫЙ ТАЛОН</span>
                  <span style="color: #ffffff;">FLIGHT SV-2027</span>
                </div>

                <!-- Тело билета: Маршрут -->
                <div style="padding: 22px 20px 16px 20px; border-bottom: 2px dashed #d0d7de;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="42%" align="left" valign="middle">
                        <div style="font-size: 10px; color: #6e7781; text-transform: uppercase; font-weight: bold; margin-bottom: 4px;">ОТПРАВЛЕНИЕ</div>
                        <div style="font-size: 19px; font-weight: 900; color: #004b62; line-height: 1.2;">MOW · UFA · BEL</div>
                        <div style="font-size: 11px; color: #57606a; margin-top: 2px;">Москва • Уфа • Белебей</div>
                      </td>
                      <td width="16%" align="center" valign="middle">
                        <div style="font-size: 20px; color: #008fd0; font-weight: bold;">✈</div>
                        <div style="font-size: 9px; color: #8c959f; font-weight: bold; margin-top: 2px;">ПРЯМОЙ</div>
                      </td>
                      <td width="42%" align="right" valign="middle">
                        <div style="font-size: 10px; color: #6e7781; text-transform: uppercase; font-weight: bold; margin-bottom: 4px;">НАЗНАЧЕНИЕ</div>
                        <div style="font-size: 20px; font-weight: 900; color: #de6a09; line-height: 1.2;">NEW YEAR</div>
                        <div style="font-size: 11px; color: #57606a; margin-top: 2px;">2027 ГОД</div>
                      </td>
                    </tr>
                  </table>
                </div>

                <!-- Сетка данных билета -->
                <div style="padding: 16px 20px; background-color: #f8fafc; border-bottom: 2px dashed #d0d7de;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="25%" valign="top">
                        <div style="font-size: 10px; color: #6e7781; font-weight: bold;">ПАССАЖИР</div>
                        <div style="font-size: 12px; font-weight: 900; color: #1f2328; margin-top: 2px;">Savencia Team</div>
                      </td>
                      <td width="25%" valign="top">
                        <div style="font-size: 10px; color: #6e7781; font-weight: bold;">ДАТА ВЫЛЕТА</div>
                        <div style="font-size: 12px; font-weight: 900; color: #1f2328; margin-top: 2px;">10 ДЕК 2026</div>
                      </td>
                      <td width="25%" valign="top">
                        <div style="font-size: 10px; color: #6e7781; font-weight: bold;">КЛАСС</div>
                        <div style="font-size: 12px; font-weight: 900; color: #008fd0; margin-top: 2px;">Одна Команда</div>
                      </td>
                      <td width="25%" align="right" valign="top">
                        <div style="font-size: 10px; color: #6e7781; font-weight: bold;">ПОСАДКА</div>
                        <div style="font-size: 12px; font-weight: 900; color: #10b981; margin-top: 2px;">ON SCHEDULE</div>
                      </td>
                    </tr>
                  </table>
                </div>

                <!-- Корешок билета со штрихкодом -->
                <div style="padding: 16px 20px 20px 20px; background-color: #ffffff;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="55%" valign="middle" align="left">
                        <img src="barcode.png" alt="Barcode SV-2027" style="max-width: 200px; height: auto; display: block;" />
                      </td>
                      <td width="45%" valign="middle" align="right">
                        <div style="background-color: #fff2e8; border: 1px dashed #de6a09; padding: 10px 14px; border-radius: 8px; text-align: center; display: inline-block;">
                          <div style="color: #de6a09; font-weight: 900; font-size: 11px;">★ РОЗЫГРЫШ ПРИЗОВ</div>
                          <div style="color: #57606a; font-size: 10px; margin-top: 2px;">Билет выдается на регистрации</div>
                        </div>
                      </td>
                    </tr>
                  </table>
                </div>
              </div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- MANIFESTO (ОБРАЩЕНИЕ К КОМАНДЕ) -->
    <mj-section background-color="#0a1526" padding="16px 24px">
      <mj-column width="100%">
        <mj-text font-size="22px" font-weight="900" color="#ffffff" line-height="1.25" align="center">
          ТРИ ГОРОДА. ОДИН РЕЙС. ОДНА КОМАНДА.
        </mj-text>
        <mj-text font-size="16px" font-weight="bold" color="#de6a09" align="center" padding-top="6px">
          10 декабря — Вылет в Новый ГОД!
        </mj-text>
        <mj-text font-size="15px" color="#c9d6e4" line-height="1.6" padding-top="16px">
          <strong>Дорогие коллеги!</strong><br />
          Внимание, объявляется посадка на особый новогодний рейс! 10 декабря мы отправляемся в праздничное путешествие, которое объединит сотрудников <strong>Savencia</strong> из трёх городов — <strong>Москвы, Уфы и Белебея</strong>.
        </mj-text>
        <mj-text font-size="14px" color="#a0aec0" line-height="1.6" padding-top="8px">
          В этот день наши праздничные площадки превратятся в настоящие аэропорты, а каждый из вас станет пассажиром рейса с конечным пунктом назначения — <strong>Новый год!</strong>
        </mj-text>
        <mj-text font-size="14px" color="#a0aec0" line-height="1.6" padding-top="8px">
          <strong>В программе полёта:</strong> тёплые встречи с коллегами, яркие эмоции, заслуженные награды, приятные сюрпризы, музыка и праздничное настроение.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- SCHEDULE: AIRPORT TERMINAL CARDS -->
    <mj-section background-color="#0a1526" padding="12px 20px 24px 20px">
      <mj-column width="100%">
        <mj-table padding="0">
          <tr>
            <td>
              <!-- ТЕРМИНАЛ: МОСКВА И УФА -->
              <div style="background-color: #0f1f38; border-radius: 12px; padding: 18px; border: 1px solid #1a2f4d; margin-bottom: 16px;">
                <div style="font-size: 14px; font-weight: 900; color: #1bbbe9; letter-spacing: 1px; margin-bottom: 14px;">
                  ✈ МОСКВА И УФА (по местному времени)
                </div>

                <!-- Этап 1 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 10px;">
                  <tr>
                    <td width="105" valign="top">
                      <span style="display:inline-block; background-color: #004b62; color: #ffffff; font-weight: bold; font-size: 11px; padding: 4px 8px; border-radius: 4px;">17:00 – 18:00</span>
                    </td>
                    <td valign="top" style="padding-left: 6px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Регистрация на рейс (Welcome)</div>
                      <div style="color: #9cb0c6; font-size: 11px; margin-top: 2px;">Встреча пассажиров, посадочные билеты, фотографии, угощения и первые праздничные активности.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 2 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 10px;">
                  <tr>
                    <td width="105" valign="top">
                      <span style="display:inline-block; background-color: #de6a09; color: #ffffff; font-weight: bold; font-size: 11px; padding: 4px 8px; border-radius: 4px;">18:00 – 20:00</span>
                    </td>
                    <td valign="top" style="padding-left: 6px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Взлёт. Торжественная часть</div>
                      <div style="color: #9cb0c6; font-size: 11px; margin-top: 2px;">Церемония награждения сотрудников и праздничная программа.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 3 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                  <tr>
                    <td width="105" valign="top">
                      <span style="display:inline-block; background-color: #008fd0; color: #ffffff; font-weight: bold; font-size: 11px; padding: 4px 8px; border-radius: 4px;">20:00 – 23:00</span>
                    </td>
                    <td valign="top" style="padding-left: 6px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Полёт в Новый год</div>
                      <div style="color: #9cb0c6; font-size: 11px; margin-top: 2px;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                    </td>
                  </tr>
                </table>

                <!-- Локации -->
                <div style="padding-top: 10px; border-top: 1px dashed rgba(255,255,255,0.15); font-size: 11px; color: #c9d6e4; line-height: 1.5;">
                  <div>✈ <strong>Аэропорт Москва:</strong> проспект Андропова, 11, корпус 2, Южный Event-Port.</div>
                  <div style="margin-top: 4px;">✈ <strong>Аэропорт Уфа:</strong> улица Менделеева, 205А, ресторан «Пастернак».</div>
                </div>
              </div>

              <!-- ТЕРМИНАЛ: БЕЛЕБЕЙ -->
              <div style="background-color: #0f1f38; border-radius: 12px; padding: 18px; border: 1px solid #1a2f4d;">
                <div style="font-size: 14px; font-weight: 900; color: #1bbbe9; letter-spacing: 1px; margin-bottom: 14px;">
                  ✈ БЕЛЕБЕЙ (по местному времени)
                </div>

                <!-- Этап 1 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 10px;">
                  <tr>
                    <td width="105" valign="top">
                      <span style="display:inline-block; background-color: #004b62; color: #ffffff; font-weight: bold; font-size: 11px; padding: 4px 8px; border-radius: 4px;">15:00 – 15:30</span>
                    </td>
                    <td valign="top" style="padding-left: 6px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Регистрация на рейс (Welcome)</div>
                      <div style="color: #9cb0c6; font-size: 11px; margin-top: 2px;">Встреча пассажиров, посадочные билеты, фотозона, угощения.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 2 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 10px;">
                  <tr>
                    <td width="105" valign="top">
                      <span style="display:inline-block; background-color: #de6a09; color: #ffffff; font-weight: bold; font-size: 11px; padding: 4px 8px; border-radius: 4px;">15:30 – 18:00</span>
                    </td>
                    <td valign="top" style="padding-left: 6px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Взлёт. Торжественная часть</div>
                      <div style="color: #9cb0c6; font-size: 11px; margin-top: 2px;">Церемония награждения сотрудников и праздничная программа.</div>
                    </td>
                  </tr>
                </table>

                <!-- Этап 3 -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 14px;">
                  <tr>
                    <td width="105" valign="top">
                      <span style="display:inline-block; background-color: #008fd0; color: #ffffff; font-weight: bold; font-size: 11px; padding: 4px 8px; border-radius: 4px;">18:00 – 20:00</span>
                    </td>
                    <td valign="top" style="padding-left: 6px;">
                      <div style="color: #ffffff; font-weight: bold; font-size: 13px;">Полёт в Новый год</div>
                      <div style="color: #9cb0c6; font-size: 11px; margin-top: 2px;">Музыка, фуршет, развлечения, общение и новогодние сюрпризы.</div>
                    </td>
                  </tr>
                </table>

                <!-- Локация -->
                <div style="padding-top: 10px; border-top: 1px dashed rgba(255,255,255,0.15); font-size: 11px; color: #c9d6e4; line-height: 1.5;">
                  <div>✈ <strong>Аэропорт Белебей:</strong> улица Амирова, 10А, Центральный дворец культуры Белебеевского района.</div>
                </div>
              </div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- PASSENGER CHECKLIST (ИНСТРУКЦИЯ 01-02-03, NO EMOJIS) -->
    <mj-section background-color="#0a1526" padding="0 20px 24px 20px">
      <mj-column width="100%">
        <mj-table padding="0">
          <tr>
            <td>
              <div style="background-color: #0c182b; border: 1px dashed #1bbbe9; border-radius: 12px; padding: 18px;">
                <div style="font-size: 12px; font-weight: bold; color: #1bbbe9; text-transform: uppercase; margin-bottom: 14px; text-align: center; letter-spacing: 1.5px;">
                  ПАМЯТКА ДЛЯ ПАССАЖИРОВ
                </div>
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="33%" align="center" style="padding: 6px;">
                      <div style="width: 28px; height: 28px; line-height: 28px; border-radius: 50%; background-color: rgba(27,187,233,0.15); color: #1bbbe9; font-weight: bold; font-size: 12px; margin: 0 auto;">01</div>
                      <div style="font-size: 12px; font-weight: bold; color: #ffffff; margin-top: 6px;">Настроение</div>
                      <div style="font-size: 10px; color: #8fa5bd; margin-top: 2px;">Заряд улыбок и праздничной энергии</div>
                    </td>
                    <td width="33%" align="center" style="padding: 6px; border-left: 1px solid #1a2f4d; border-right: 1px solid #1a2f4d;">
                      <div style="width: 28px; height: 28px; line-height: 28px; border-radius: 50%; background-color: rgba(222,106,9,0.15); color: #de6a09; font-weight: bold; font-size: 12px; margin: 0 auto;">02</div>
                      <div style="font-size: 12px; font-weight: bold; color: #ffffff; margin-top: 6px;">Посадочный билет</div>
                      <div style="font-size: 10px; color: #8fa5bd; margin-top: 2px;">Получите талон на Welcome-стойке</div>
                    </td>
                    <td width="33%" align="center" style="padding: 6px;">
                      <div style="width: 28px; height: 28px; line-height: 28px; border-radius: 50%; background-color: rgba(16,185,129,0.15); color: #10b981; font-weight: bold; font-size: 12px; margin: 0 auto;">03</div>
                      <div style="font-size: 12px; font-weight: bold; color: #ffffff; margin-top: 6px;">Пунктуальность</div>
                      <div style="font-size: 10px; color: #8fa5bd; margin-top: 2px;">Прибывайте к началу регистрации</div>
                    </td>
                  </tr>
                </table>
              </div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- FAREWELL MESSAGE (BUTTONS REMOVED AS REQUESTED) -->
    <mj-section background-color="#0a1526" padding="10px 24px 28px 24px">
      <mj-column width="100%">
        <mj-text align="center" font-size="17px" font-weight="bold" color="#ffffff">
          Уважаемые пассажиры!
        </mj-text>
        <mj-text align="center" font-size="14px" color="#a3b8cc" padding="8px 0 0 0" line-height="1.6">
          Просим заранее подготовить хорошее настроение и быть готовыми к незабываемому путешествию.<br />
          <strong style="color: #ffffff;">Наш новогодний рейс уже готовится к вылету. На борту ждём каждого!</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- FOOTER (FINE PRINT REMOVED, DIGNIFIED CARD CLOSURE) -->
    <mj-section background-color="#050c17" padding="30px 24px" border-radius="0 0 16px 16px">
      <mj-column width="100%">
        <mj-text align="center" font-size="18px" font-weight="900" color="#ffffff" letter-spacing="1.5px">
          ДО ВСТРЕЧИ 10 ДЕКАБРЯ!
        </mj-text>
        <mj-text align="center" font-size="14px" font-weight="bold" color="#1bbbe9" padding-top="8px">
          Ваш экипаж Savencia ✈
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- BOTTOM GUTTER -->
    <mj-section background-color="#050c17" padding="8px 0">
      <mj-column><mj-spacer height="8px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>